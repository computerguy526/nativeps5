#!/usr/bin/env python3
"""nps5: one command name. `run` and `patch` are handled here (scripts/nps5lib/); every other subcommand
(build, list, play, launcher, doctor, ...) passes through to the Go nps5 of ps5recomp.
  nps5 run <id> [--scene X] [--until SPEC] [--arm LABEL:K=V,...] [--class func|perf] [--secs N] [--dry-run] ...
  nps5 analyze|ab|pics|report ...   frame stats, noise-aware A/B, picture sheets, PR evidence (docs/agents/evidence.md)
  nps5 patch <id> --list | --check <native> | <native> <names> [-o COPY]
Go binary: $NPS5_GO_NPS5, else <ps5recomp>/bin/nps5 or out/nps5, else `go run ./cmd/nps5` inside ps5recomp."""
import importlib.util, os, subprocess, sys

HERE = os.path.dirname(os.path.abspath(__file__))


def _load(name):
    spec = importlib.util.spec_from_file_location("nps5_" + name, os.path.join(HERE, "nps5lib", name + ".py"))
    m = importlib.util.module_from_spec(spec); spec.loader.exec_module(m)
    return m


def go_command(environ, argv):
    if environ.get("NPS5_GO_NPS5"):
        return [environ["NPS5_GO_NPS5"]] + argv, None
    pub = os.path.dirname(HERE)
    roots = [environ["NPS5_RECOMP_DIR"]] if environ.get("NPS5_RECOMP_DIR") else [os.path.join(os.path.dirname(pub), "ps5recomp"), os.path.join(pub, "ps5recomp")]
    root = next((r for r in roots if os.path.isdir(r)), roots[0])
    for b in (os.path.join(root, "bin", "nps5"), os.path.join(root, "out", "nps5")):   # scripts/build.sh recomp writes bin/
        if os.path.isfile(b) and os.access(b, os.X_OK):
            return [b] + argv, None
    return ["go", "run", "./cmd/nps5"] + argv, root


def main(argv, environ=None):
    environ = dict(os.environ if environ is None else environ)
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__); return 0 if argv else 2
    sys.dont_write_bytecode = True
    if argv[0] == "run":
        return _load("run").main(argv[1:], environ)
    if argv[0] == "patch":
        return _load("patch").main(argv[1:], environ)
    if argv[0] in ("analyze", "ab", "pics", "report"):   # evidence tooling: scripts/nps5lib/{analyze,ab,pics,report}.py
        sys.path.insert(0, os.path.join(HERE, "nps5lib"))
        return _load(argv[0]).main(argv[1:], environ)
    cmd, cwd = go_command(environ, argv)
    if cwd is None and environ.get("NPS5_GO_NPS5") is None and not os.path.exists(cmd[0]):
        print("nps5: no Go nps5 found (build ps5recomp, or set NPS5_GO_NPS5)", file=sys.stderr); return 2
    return subprocess.call(cmd, cwd=cwd, env=environ)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

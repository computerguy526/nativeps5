# https://editorconfig.org  (the code's existing layout wins: this only fixes the basics)
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{py,sh}]
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.tsv]
indent_style = tab
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

void main() {
    const uint i = gl_LocalInvocationIndex;
    SetMeshOutputsEXT(3, 1);
    gl_MeshVerticesEXT[i].gl_Position = vec4(i == 1u ? 1.0 : -1.0, i == 2u ? 1.0 : -1.0, 0.5, 1.0);

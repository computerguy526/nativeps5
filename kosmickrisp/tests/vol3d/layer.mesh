#version 450
#extension GL_EXT_mesh_shader : require
// One workgroup per layer: a full-target quad routed to layer gl_WorkGroupID.x (per-primitive gl_Layer),
// the way AnyPS5 draws Unreal's 32^3 tonemap LUT.
layout(local_size_x = 1) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;
layout(location = 0) flat out float vLayer[];
layout(push_constant) uniform PC { vec4 color; } pc;
void main() {
    SetMeshOutputsEXT(4, 2);
    for (int i = 0; i < 4; i++) {
        gl_MeshVerticesEXT[i].gl_Position = vec4((i & 1) != 0 ? 1.0 : -1.0, (i & 2) != 0 ? 1.0 : -1.0, 0.5, 1.0);
        vLayer[i] = float(gl_WorkGroupID.x);
    }
    gl_PrimitiveTriangleIndicesEXT[0] = uvec3(0, 1, 2);
    gl_PrimitiveTriangleIndicesEXT[1] = uvec3(2, 1, 3);
    gl_MeshPrimitivesEXT[0].gl_Layer = int(gl_WorkGroupID.x);
    gl_MeshPrimitivesEXT[1].gl_Layer = int(gl_WorkGroupID.x);
}

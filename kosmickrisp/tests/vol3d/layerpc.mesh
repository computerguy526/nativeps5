#version 450
#extension GL_EXT_mesh_shader : require
// Like layer.mesh, but the MESH stage reads the push constants (the colour reaches the fragment stage as a varying),
// and the layer comes from gl_WorkGroupID.y with 96 threads per group as in the title's draw (3 threads used).
layout(local_size_x = 96) in;
layout(triangles, max_vertices = 4, max_primitives = 2) out;
layout(location = 0) flat out vec4 vColor[];
layout(push_constant) uniform PC { vec4 color; } pc;
void main() {
    SetMeshOutputsEXT(4, 2);
    const uint i = gl_LocalInvocationIndex;
    if (i < 4) {
        gl_MeshVerticesEXT[i].gl_Position = vec4((i & 1) != 0 ? 1.0 : -1.0, (i & 2) != 0 ? 1.0 : -1.0, 0.5, 1.0);
        vColor[i] = vec4(pc.color.r, float(gl_WorkGroupID.y) / 255.0, pc.color.b, 1.0);
    }
    if (i < 2) {
        gl_PrimitiveTriangleIndicesEXT[i] = i == 0 ? uvec3(0, 1, 2) : uvec3(2, 1, 3);
        gl_MeshPrimitivesEXT[i].gl_Layer = int(gl_WorkGroupID.y);
    }
}

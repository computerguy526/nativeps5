diff --git a/src/kosmickrisp/vulkan/tests/kk_safety_core2_test.c b/src/kosmickrisp/vulkan/tests/kk_safety_core2_test.c
new file mode 100644
index 0000000..1a503bf
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/kk_safety_core2_test.c
@@ -0,0 +1,193 @@
+/* loopcap / gpusafe pure logic: reported-kernel set, allocation table
+ * (first-OOM dump), waiter-release ring. GPU-free. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include "../kk_safety_core.h"
+static int n;
+#define CHECK(c) do { n++; if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); exit(1);} } while (0)
+
+/* brute-force reference of the allocation table: every live allocation */
+struct ref { uint64_t size; uint32_t cat; int live; };
+static struct ref refs[200000];
+static int nref;
+static int cmp_row(const void *a, const void *b)
+{
+   const struct kk_safe_memrow *x = a, *y = b;
+   if (x->size != y->size) return x->size > y->size ? -1 : 1;
+   if (x->count != y->count) return x->count > y->count ? -1 : 1;
+   return x->cat < y->cat ? -1 : x->cat > y->cat;
+}
+int main(void)
+{
+   alarm(60);
+   /* once-per-kernel set */
+   static struct kk_safe_keyset ks;
+   CHECK(kk_safe_keyset_add(&ks, 0x1111));
+   CHECK(!kk_safe_keyset_add(&ks, 0x1111));
+   CHECK(kk_safe_keyset_add(&ks, 0));          /* key 0 is a key like any other */
+   CHECK(!kk_safe_keyset_add(&ks, 0));
+   for (uint64_t k = 2; k < KK_SAFE_LOOP_KEYS; k++) CHECK(kk_safe_keyset_add(&ks, k * 0x9e3779b97f4a7c15ull));
+   CHECK(ks.count == KK_SAFE_LOOP_KEYS);
+   CHECK(!kk_safe_keyset_add(&ks, 0xdeadbeef)); /* full: bounded log, nothing new */
+   CHECK(!kk_safe_keyset_add(&ks, 0x1111));
+   CHECK(ks.count == KK_SAFE_LOOP_KEYS);
+
+   /* allocation table: basics */
+   static struct kk_safe_memtab t;
+   struct kk_safe_memrow top[KK_SAFE_MEM_TOP];
+   CHECK(kk_safe_memtab_top(&t, top, KK_SAFE_MEM_TOP) == 0);
+   kk_safe_memtab_note(&t, 1, KK_SAFE_MEM_MIN - 1);          /* too small */
+   CHECK(t.used == 0);
+   kk_safe_memtab_note(&t, 1, 64 << 20);
+   kk_safe_memtab_note(&t, 1, 64 << 20);
+   kk_safe_memtab_note(&t, 2, 64 << 20);
+   kk_safe_memtab_note(&t, 3, 512 << 20);
+   kk_safe_memtab_note(&t, 3, KK_SAFE_MEM_MIN);
+   CHECK(kk_safe_memtab_top(&t, top, KK_SAFE_MEM_TOP) == 4);
+   CHECK(top[0].size == 512 << 20 && top[0].cat == 3 && top[0].count == 1);
+   CHECK(top[1].size == 64 << 20 && top[1].cat == 1 && top[1].count == 2);   /* tie on size: more of them first */
+   CHECK(top[2].size == 64 << 20 && top[2].cat == 2 && top[2].count == 1);
+   CHECK(top[3].size == KK_SAFE_MEM_MIN);
+   CHECK(kk_safe_memtab_top(&t, top, 2) == 2 && top[1].cat == 1);            /* n smaller than rows */
+   kk_safe_memtab_note(&t, 3, -(512ll << 20));                               /* free the biggest */
+   CHECK(kk_safe_memtab_top(&t, top, KK_SAFE_MEM_TOP) == 3 && top[0].cat == 1);
+   kk_safe_memtab_note(&t, 3, -(512ll << 20));                               /* free of an unknown one: ignored */
+   kk_safe_memtab_note(&t, 9, -(7ll << 20));
+   CHECK(kk_safe_memtab_top(&t, top, KK_SAFE_MEM_TOP) == 3);
+   kk_safe_memtab_note(&t, 4, 300 << 20);                                    /* reuses the freed row */
+   CHECK(t.used == 4);
+
+   /* fuzz against the brute-force list: random alloc/free, sizes with many repeats */
+   memset(&t, 0, sizeof t);
+   srand(7);
+   for (int round = 0; round < 300000; round++) {
+      if (nref < 150000 && (rand() % 100 < 55 || nref == 0)) {
+         uint64_t size = ((uint64_t)(rand() % 60) + 1) << (rand() % 3 ? 20 : 12);   /* some below 1 MiB; 60 x 13 keys fit the table */
+         uint32_t cat = 1 + rand() % 13;
+         refs[nref++] = (struct ref){size, cat, 1};
+         kk_safe_memtab_note(&t, cat, (int64_t)size);
+      } else {
+         int i = rand() % nref;
+         if (refs[i].live) { refs[i].live = 0; kk_safe_memtab_note(&t, refs[i].cat, -(int64_t)refs[i].size); }
+      }
+      if (round % 20000 == 19999) {
+         /* expected rows = (cat, size) -> count over live refs >= 1 MiB */
+         static struct kk_safe_memrow exp[8192]; int ne = 0;
+         for (int i = 0; i < nref; i++) {
+            if (!refs[i].live || refs[i].size < KK_SAFE_MEM_MIN) continue;
+            int k; for (k = 0; k < ne; k++) if (exp[k].size == refs[i].size && exp[k].cat == refs[i].cat) break;
+            if (k == ne) exp[ne++] = (struct kk_safe_memrow){refs[i].size, refs[i].cat, 0};
+            exp[k].count++;
+         }
+         qsort(exp, ne, sizeof exp[0], cmp_row);
+         unsigned got = kk_safe_memtab_top(&t, top, KK_SAFE_MEM_TOP);
+         CHECK(t.untracked == 0);
+         CHECK(got == (unsigned)(ne < KK_SAFE_MEM_TOP ? ne : KK_SAFE_MEM_TOP));
+         for (unsigned i = 0; i < got; i++)
+            CHECK(top[i].size == exp[i].size && top[i].cat == exp[i].cat && top[i].count == exp[i].count);
+      }
+   }
+   /* table full: counted, never corrupts */
+   memset(&t, 0, sizeof t);
+   for (uint64_t i = 0; i < KK_SAFE_MEM_ROWS + 50; i++) kk_safe_memtab_note(&t, 1, (int64_t)((i + 1) << 20));
+   CHECK(t.used == KK_SAFE_MEM_ROWS && t.untracked == 50);
+   CHECK(kk_safe_memtab_top(&t, top, KK_SAFE_MEM_TOP) == KK_SAFE_MEM_TOP && top[0].size == (uint64_t)KK_SAFE_MEM_ROWS << 20);
+   kk_safe_memtab_note(&t, 1, -(int64_t)((uint64_t)(KK_SAFE_MEM_ROWS + 10) << 20));   /* free of an untracked one */
+   CHECK(kk_safe_memtab_top(&t, top, 1) == 1 && top[0].size == (uint64_t)KK_SAFE_MEM_ROWS << 20);
+
+   /* waiter-release ring */
+   static struct kk_safe_signals r;
+   int ev[KK_SAFE_SIGNALS + 8];
+   CHECK(kk_safe_signals_push(&r, &ev[0], 5) == NULL);
+   CHECK(kk_safe_signals_push(&r, &ev[0], 9) == &ev[0]);     /* same event: its extra reference comes back */
+   CHECK(r.s[0].value == 9);
+   CHECK(kk_safe_signals_push(&r, &ev[0], 3) == &ev[0]);     /* never lowered */
+   CHECK(r.s[0].value == 9);
+   for (int i = 1; i < KK_SAFE_SIGNALS; i++) CHECK(kk_safe_signals_push(&r, &ev[i], i) == NULL);
+   CHECK(kk_safe_signals_push(&r, &ev[KK_SAFE_SIGNALS], 77) == &ev[0]);   /* oldest displaced */
+   CHECK(kk_safe_signals_push(&r, &ev[KK_SAFE_SIGNALS + 1], 78) == &ev[1]);
+   int present = 0; for (int i = 0; i < KK_SAFE_SIGNALS; i++) present += r.s[i].event != NULL;
+   CHECK(present == KK_SAFE_SIGNALS);
+   CHECK(kk_safe_signals_push(&r, &ev[5], 1000) == &ev[5] && r.s[5].value == 1000);
+   /* watchdog scan vs commits registered while it runs (the false 'GPU WATCHDOG' of patch 0020: `now` is taken
+    * before the scan, a newer start_ns made the unsigned difference wrap) */
+   {
+      static struct kk_safe_slot ring[KK_SAFE_RING];
+      uint64_t s = 1000000000ull, lim = 4 * s, now = 100 * s;
+      ring[3] = (struct kk_safe_slot){.seq = 7, .start_ns = now + 1, .pending = 1};          /* registered 1 ns after `now` */
+      CHECK(kk_safe_find_overdue(ring, now, lim) == -1);
+      ring[4] = (struct kk_safe_slot){.seq = 8, .start_ns = now + 50 * s, .pending = 1};     /* far in the future */
+      ring[5] = (struct kk_safe_slot){.seq = 9, .start_ns = now, .pending = 1};              /* exactly now */
+      CHECK(kk_safe_find_overdue(ring, now, lim) == -1);
+      CHECK(!kk_safe_slot_overdue(&ring[3], now, lim) && !kk_safe_slot_overdue(&ring[4], now, lim) && !kk_safe_slot_overdue(&ring[5], now, lim));
+      ring[6] = (struct kk_safe_slot){.seq = 5, .start_ns = now - lim, .pending = 1};        /* exactly the limit: not yet */
+      CHECK(kk_safe_find_overdue(ring, now, lim) == -1);
+      ring[6].start_ns = now - lim - 1;
+      CHECK(kk_safe_find_overdue(ring, now, lim) == 6);                                       /* really overdue is still found */
+      ring[6].pending = 0;
+      CHECK(kk_safe_find_overdue(ring, now, lim) == -1);
+      ring[7] = (struct kk_safe_slot){.seq = 0, .start_ns = 1, .pending = 1};                /* never used */
+      CHECK(kk_safe_find_overdue(ring, now, lim) == -1);
+      /* fuzz: random slots around `now`; reference with signed 128-bit arithmetic */
+      srand(11);
+      for (int round = 0; round < 2000; round++) {
+         int want = -1;
+         for (unsigned i = 0; i < KK_SAFE_RING; i++) {
+            int64_t d = (int64_t)(rand() % 12000) - 6000;                                     /* ms relative to now */
+            ring[i] = (struct kk_safe_slot){.seq = rand() % 5 ? (uint64_t)(rand() % 100000) + 1 : 0, .start_ns = (uint64_t)((__int128)now + (__int128)d * 1000000), .pending = rand() % 2};
+            __int128 age = (__int128)now - (__int128)ring[i].start_ns;
+            if (ring[i].seq && ring[i].pending && age > (__int128)lim && (want < 0 || ring[i].seq < ring[want].seq)) want = (int)i;
+         }
+         int got = kk_safe_find_overdue(ring, now, lim);
+         CHECK(got == want || (got >= 0 && want >= 0 && ring[got].seq == ring[want].seq));
+      }
+   }
+   /* environment numbers: only a plain finite number inside the range is taken; everything else
+    * leaves the caller's default alone (a typo must not switch a guard off) */
+   {
+      double v = -7;
+      CHECK(kk_safe_parse_num("4", 0, 86400, &v) && v == 4);
+      CHECK(kk_safe_parse_num("0", 0, 86400, &v) && v == 0);       /* an explicit 0 = off */
+      CHECK(kk_safe_parse_num("2.5", 0, 86400, &v) && v == 2.5);
+      CHECK(kk_safe_parse_num("1e3", 0, 86400, &v) && v == 1000);
+      CHECK(kk_safe_parse_num("4294967295", 0, 4294967295.0, &v) && (uint32_t)v == 0xffffffffu);
+      v = -7;
+      static const char *bad[] = {"", "abc", "off", "false", "4s", "4 ", " ", "nan", "inf", "-inf", "-1", "86401",
+                                  "1e30", "0x", "--4", "4,5"};
+      for (unsigned i = 0; i < sizeof bad / sizeof bad[0]; i++)
+         CHECK(!kk_safe_parse_num(bad[i], 0, 86400, &v) && v == -7);
+      CHECK(!kk_safe_parse_num(NULL, 0, 1, &v) && v == -7);
+      CHECK(!kk_safe_parse_num("4294967296", 0, 4294967295.0, &v)); /* never reaches a uint32 cast */
+      CHECK(!kk_safe_parse_num("0", 1, 256, &v));                   /* KK_OOM_MAX: at least 1 */
+      srand(3);
+      for (int i = 0; i < 20000; i++) { /* random text: accepted only when strtod takes all of it and it is in range */
+         char t[12];
+         int len = rand() % 11;
+         for (int k = 0; k < len; k++)
+            t[k] = "0123456789.eE+-x naif"[rand() % 21];
+         t[len] = 0;
+         double got = -7;
+         bool ok = kk_safe_parse_num(t, 0, 1000, &got);
+         char *end;
+         double ref = strtod(t, &end);
+         bool want = len > 0 && end != t && *end == 0 && ref >= 0 && ref <= 1000;
+         CHECK(ok == want && (ok ? got == ref : got == -7));
+      }
+   }
+   /* device-bound state: one owner at a time, released only by its owner */
+   {
+      const void *owner = NULL;
+      int a = 0, b = 0;
+      CHECK(!kk_safe_owner_release(&owner, &a) && owner == NULL);
+      CHECK(!kk_safe_owner_release(&owner, NULL));
+      CHECK(kk_safe_owner_claim(&owner, &a) && owner == &a);
+      CHECK(kk_safe_owner_claim(&owner, &a));
+      CHECK(!kk_safe_owner_claim(&owner, &b) && owner == &a); /* a second live device gets nothing */
+      CHECK(!kk_safe_owner_release(&owner, &b) && owner == &a);
+      CHECK(kk_safe_owner_release(&owner, &a) && owner == NULL);
+      CHECK(kk_safe_owner_claim(&owner, &b) && owner == &b);  /* the next device starts with its own */
+   }
+   printf("kk_safety_core2_test: %d checks OK\n", n);
+   return 0;
+}
diff --git a/src/kosmickrisp/vulkan/tests/kk_safety_test.c b/src/kosmickrisp/vulkan/tests/kk_safety_test.c
new file mode 100644
index 0000000..9be411e
--- /dev/null
+++ b/src/kosmickrisp/vulkan/tests/kk_safety_test.c
@@ -0,0 +1,63 @@
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../kk_safety_core.h"
+static int n;
+#define CHECK(c) do { n++; if (!(c)) { printf("FAIL line %d: %s\n", __LINE__, #c); exit(1);} } while (0)
+int main(void)
+{
+   /* clamp math */
+   uint32_t L = 1u << 22;
+   CHECK(!kk_safe_groups_exceed(1, 1, 1, L));
+   CHECK(!kk_safe_groups_exceed(2048, 2048, 1, L));      /* exactly 2^22 */
+   CHECK(kk_safe_groups_exceed(2048, 2048, 2, L));
+   CHECK(kk_safe_groups_exceed(4194305, 1, 1, L));
+   CHECK(kk_safe_groups_exceed(0xffffffffu, 0xffffffffu, 0xffffffffu, L)); /* overflow-safe */
+   CHECK(kk_safe_groups_exceed(0xffffffffu, 0xffffffffu, 1, L));
+   CHECK(!kk_safe_groups_exceed(0xffffffffu, 0xffffffffu, 0, L));          /* empty */
+   CHECK(!kk_safe_groups_exceed(0xffffffffu, 0, 5, L));
+   CHECK(!kk_safe_groups_exceed(0xffffffffu, 0xffffffffu, 0xffffffffu, 0)); /* off */
+   CHECK(!kk_safe_groups_exceed(4194304, 1, 1, L));
+   CHECK(kk_safe_groups_exceed(1, 1, 4194305, L));
+   srand(1);
+   for (int i = 0; i < 200000; i++) { /* fuzz vs __int128 */
+      uint32_t a = rand() % 5 ? (uint32_t)rand() % 5000 : (uint32_t)rand() * 7u, b = rand() % 5 ? (uint32_t)rand() % 5000 : (uint32_t)rand(), c = (uint32_t)rand() % 3000;
+      unsigned __int128 p = (unsigned __int128)a * b * c;
+      CHECK(kk_safe_groups_exceed(a, b, c, L) == (p > L));
+   }
+   /* failure window */
+   struct kk_safe_window w = {0};
+   uint64_t s = 1000000000ull;
+   for (int i = 0; i < 31; i++) CHECK(!kk_safe_window_note(&w, s + i * 1000000ull, 32, 60 * s));
+   CHECK(kk_safe_window_note(&w, s + 31 * 1000000ull, 32, 60 * s));  /* 32nd inside 60 s */
+   memset(&w, 0, sizeof w);
+   for (int i = 0; i < 100; i++) CHECK(!kk_safe_window_note(&w, s + i * 2 * s, 32, 60 * s)); /* 1 per 2 s = 30 per 60 s */
+   memset(&w, 0, sizeof w);
+   for (int i = 0; i < 100; i++) { bool f = kk_safe_window_note(&w, s + i * (60 * s / 31 + 1), 32, 60 * s); CHECK(!f); } /* just under */
+   memset(&w, 0, sizeof w);
+   bool fired = false;
+   for (int i = 0; i < 100; i++) fired |= kk_safe_window_note(&w, s + i * (60 * s / 31 - 1000), 32, 60 * s);
+   CHECK(fired);
+   memset(&w, 0, sizeof w);
+   for (int i = 0; i < 1000; i++) CHECK(!kk_safe_window_note(&w, s + i * 10 * s, 32, 60 * s)); /* ring wrap, sparse */
+   /* overdue scan (watchdog timer logic) */
+   static struct kk_safe_slot ring[KK_SAFE_RING];
+   uint64_t lim = 4 * s;
+   CHECK(kk_safe_find_overdue(ring, 100 * s, lim) == -1);
+   ring[5] = (struct kk_safe_slot){.seq = 10, .start_ns = 10 * s, .pending = 1};
+   ring[9] = (struct kk_safe_slot){.seq = 8, .start_ns = 9 * s, .pending = 1};
+   ring[7] = (struct kk_safe_slot){.seq = 12, .start_ns = 11 * s, .pending = 0};
+   CHECK(kk_safe_find_overdue(ring, 12 * s, lim) == -1);   /* 2-3 s old */
+   CHECK(kk_safe_find_overdue(ring, 13 * s + 1, lim) == 9);/* seq 8 (4.0 s+) first */
+   CHECK(kk_safe_find_overdue(ring, 14 * s + 1, lim) == 9);
+   ring[9].pending = 0;
+   CHECK(kk_safe_find_overdue(ring, 14 * s + 1, lim) == 5);
+   ring[5].pending = 0;
+   CHECK(kk_safe_find_overdue(ring, 1000 * s, lim) == -1); /* completed never fire */
+   /* guard */
+   CHECK(!kk_safe_over_limit(100, 0));
+   CHECK(kk_safe_over_limit(101, 100) && !kk_safe_over_limit(100, 100));
+   CHECK(kk_safe_default_limit(10000) == 9000);
+   printf("kk_safety_test: %d checks OK\n", n);
+   return 0;
+}

    }
@@ -509,18 +544,75 @@ uint64_t
 kk_safe_clamp_counter_addr(struct kk_device *dev)
 {
    pthread_mutex_lock(&g_counter_lock);
-   if (!g_counter_bo) {
-      struct kk_bo *bo = NULL;
-      if (kk_alloc_bo(dev, &dev->vk.base, 16, 16, &bo, KK_MEM_CMD_POOL) == VK_SUCCESS) {
-         memset(bo->cpu, 0, 16);
-         g_counter_bo = bo;
+   uint64_t a = 0;
+   /* The counter lives in one device's residency set: only that device may write to it. */
+   if (kk_safe_owner_claim(&g_counter_dev, dev)) {
+      if (!g_counter_bo) {
+         struct kk_bo *bo = NULL;
+         if (kk_alloc_bo(dev, &dev->vk.base, 16, 16, &bo, KK_MEM_CMD_POOL) == VK_SUCCESS) {
+            memset(bo->cpu, 0, 16);
+            g_counter_bo = bo;
+         }
       }
+      a = g_counter_bo ? g_counter_bo->gpu : 0;
+      if (!a)
+         kk_safe_owner_release(&g_counter_dev, dev);
+   } else if (!atomic_exchange(&g_clamp_other_dev_logged, 1)) {
+      fprintf(stderr, "[kk-safe] dispatch clamp: a second device is live; its indirect dispatches are not clamped (logged once)\n");
    }
-   uint64_t a = g_counter_bo ? g_counter_bo->gpu : 0;
    pthread_mutex_unlock(&g_counter_lock);
    return a;
 }
 
+void
+kk_safe_device_destroy(struct kk_device *dev)
+{
+   struct kk_device *expect = dev;
+   atomic_compare_exchange_strong(&g_dev, &expect, NULL);
+
+   pthread_mutex_lock(&g_counter_lock);
+   struct kk_bo *counter = NULL;
+   if (kk_safe_owner_release(&g_counter_dev, dev)) {
+      counter = g_counter_bo;
+      g_counter_bo = NULL;
+      g_clamp_logged = false;
+   }
+   pthread_mutex_unlock(&g_counter_lock);
+   if (counter)
+      kk_destroy_bo(dev, counter);
+
+   /* Loop states: every command buffer of the device is gone and its queue is finished, so all
+    * states are free once the last completion handler returned. Wait briefly for those; if a state
+    * is still out, keep the buffers (a handler may still read them) and close the pool. */
+   struct kk_bo *chunks[KK_LOOP_MAX_CHUNKS];
+   for (unsigned tries = 0; tries < 200; tries++) {
+      pthread_mutex_lock(&g_loop_lock);
+      if (g_loop_dev != dev || g_loop_orphaned) {
+         pthread_mutex_unlock(&g_loop_lock);
+         return;
+      }
+      if (g_loop_nfree == g_loop_chunks * KK_LOOP_CHUNK_SLOTS) {
+         unsigned n = g_loop_chunks;
+         memcpy(chunks, g_loop_chunk, n * sizeof(chunks[0]));
+         g_loop_chunks = 0;
+         g_loop_nfree = 0;
+         kk_safe_owner_release(&g_loop_dev, dev);
+         pthread_mutex_unlock(&g_loop_lock);
+         for (unsigned i = 0; i < n; i++)
+            kk_destroy_bo(dev, chunks[i]);
+         return;
+      }
+      pthread_mutex_unlock(&g_loop_lock);
+      struct timespec ts = {0, 10 * 1000 * 1000};
+      nanosleep(&ts, NULL);
+   }
+   pthread_mutex_lock(&g_loop_lock);
+   g_loop_orphaned = true;
+   pthread_mutex_unlock(&g_loop_lock);
+   fprintf(stderr, "[kk-safe] [RED] loop cap: loop states still in use at device destroy; the pool is closed, "
+                   "guarded compute dispatches of later devices are skipped\n");
+}
+
 bool
 kk_safe_halted(void)
 {
@@ -531,15 +623,14 @@ struct kk_safe_token *
 kk_safe_commit_begin(struct kk_queue *queue, struct kk_cmd_buffer *cmd)
 {
    struct kk_device *dev = kk_queue_device(queue);
-   if (!g_dev)
-      g_dev = dev;
+   atomic_store(&g_dev, dev);
    pthread_once(&g_once, init_once);
 
    /* The guards may have been initialized by a dispatch recorded before the first commit, when
     * no device was known yet: the residency limit is then set here. */
    static _Atomic int wired_set;
    if (g_wired_on && !g_wired_limit && !atomic_exchange(&wired_set, 1)) {
-      double mb = env_d("KK_WIRED_LIMIT_MB", NULL, 0);
+      double mb = env_d("KK_WIRED_LIMIT_MB", NULL, 0, 0, 1e9);
       g_wired_limit = mb > 0 ? (uint64_t)mb << 20
                              : kk_safe_default_limit(mtl_device_recommended_max_working_set_size(dev->mtl_handle));
       fprintf(stderr, "[kk-safe] wired limit %llu MiB\n", (unsigned long long)(g_wired_limit >> 20));
diff --git a/src/kosmickrisp/vulkan/kk_safety.h b/src/kosmickrisp/vulkan/kk_safety.h
index 81fca6e..57748e8 100644
--- a/src/kosmickrisp/vulkan/kk_safety.h
+++ b/src/kosmickrisp/vulkan/kk_safety.h
@@ -18,6 +18,11 @@ bool kk_safe_direct_dispatch_blocked(uint32_t x, uint32_t y, uint32_t z);
 /* GPU address of the device-wide 16-byte clamp counter (created lazily; 0 on failure). */
 uint64_t kk_safe_clamp_counter_addr(struct kk_device *dev);
 
+/* Device destroy (after the queue finished, before the residency set is released): forgets the
+ * device and frees the guard buffers that live in its residency set, so the next device starts
+ * with its own. */
+void kk_safe_device_destroy(struct kk_device *dev);
+
 /* True once the watchdog or an error guard stopped the process: no new submissions. */
 bool kk_safe_halted(void);
 
diff --git a/src/kosmickrisp/vulkan/kk_safety_core.h b/src/kosmickrisp/vulkan/kk_safety_core.h
index 0364cf4..5132078 100644
--- a/src/kosmickrisp/vulkan/kk_safety_core.h
+++ b/src/kosmickrisp/vulkan/kk_safety_core.h
@@ -1,6 +1,6 @@
 /*
  * nps5 gpusafe: pure, dependency-free logic of the KK machine-safety guards, so it can be unit
- * tested offline (work/s3/kk-safe/test/kk_safety_test.c) without Metal or Mesa headers.
+ * tested offline (tests/kk_safety_test.c) without Metal or Mesa headers.
  * SPDX-License-Identifier: MIT
  */
 #ifndef KK_SAFETY_CORE_H
@@ -8,8 +8,46 @@
 
 #include <stdbool.h>
 #include <stdint.h>
+#include <stdlib.h>
 #include <string.h>
 
+/* ---- environment numbers. True and *out set only for a plain finite number inside [lo, hi] with
+ * nothing after it. Anything else (empty, text, "4s", nan, out of range) is refused and the caller
+ * keeps its default: a typo must never switch a guard off, and no out-of-range value reaches an
+ * integer conversion. */
+static inline bool
+kk_safe_parse_num(const char *text, double lo, double hi, double *out)
+{
+   if (!text || !*text)
+      return false;
+   char *end = NULL;
+   double v = strtod(text, &end);
+   if (end == text || *end != 0 || !(v >= lo && v <= hi)) /* !(..) also refuses NaN */
+      return false;
+   *out = v;
+   return true;
+}
+
+/* ---- device-bound state (clamp counter, loop-state pool): the buffers live in one device's
+ * residency set, so only that device may use them. claim: true when `dev` owns the state now
+ * (first claim, or it already did); false while another device owns it. release: true when `dev`
+ * was the owner (the caller then frees the buffers before the device goes away). */
+static inline bool
+kk_safe_owner_claim(const void **owner, const void *dev)
+{
+   if (*owner == NULL)
+      *owner = dev;
+   return *owner == dev;
+}
+static inline bool
+kk_safe_owner_release(const void **owner, const void *dev)
+{
+   if (*owner != dev || dev == NULL)
+      return false;
+   *owner = NULL;
+   return true;
+}
+
 /* ---- dispatch clamp: true when x*y*z threadgroups exceed limit (limit 0 = clamp off). No overflow. */
 static inline bool
 kk_safe_groups_exceed(uint32_t x, uint32_t y, uint32_t z, uint32_t limit)

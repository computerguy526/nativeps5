diff --git a/src/kosmickrisp/vulkan/kk_cmd_dispatch.c b/src/kosmickrisp/vulkan/kk_cmd_dispatch.c
index a489310..5214539 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_dispatch.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_dispatch.c
@@ -164,6 +164,7 @@ kk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
                     (uint32_t)local_size.x, (uint32_t)local_size.y, (uint32_t)local_size.z);
 
    mtl_compute_encoder *encoder = cs_get_compute(cmd);
+   uint64_t addr = pInfo->addressRange.address;
    if (cmd->state.cond_render.enabled) {
       struct kk_ptr patched =
          kk_pool_alloc(cmd, sizeof(VkDispatchIndirectCommand), 4u);
@@ -171,28 +172,25 @@ kk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
          return;
       }
 
-      kk_predicate_compute(cmd, patched.gpu, pInfo->addressRange.address);
+      kk_predicate_compute(cmd, patched.gpu, addr);
+      addr = patched.gpu;
+   }
 
-      /* Flush compute state after predication dispatch */
-      if (!kk_flush_compute_state(cmd))
-         return;
-      mtl_dispatch_threadgroups_with_indirect_buffer(encoder, patched.gpu,
-                                                     local_size);
-   } else {
-      uint64_t addr = pInfo->addressRange.address;
-      uint32_t limit = kk_safe_dispatch_limit();
-      if (limit) {
-         /* nps5 gpusafe: clamp GPU-written counts (one 1-thread dispatch) */
-         struct kk_ptr clamped = kk_pool_alloc(cmd, sizeof(VkDispatchIndirectCommand), 4u);
-         uint64_t counter = kk_safe_clamp_counter_addr(kk_cmd_buffer_device(cmd));
-         if (likely(clamped.gpu != 0 && counter != 0)) {
-            struct kk_grid grid = kk_grid_1d(1u);
-            libkk_clamp_indirect_dispatch(cmd, grid, false, clamped.gpu, addr, counter, limit);
-            addr = clamped.gpu;
-         }
+   /* nps5 gpusafe: clamp GPU-written counts (one 1-thread dispatch), also
+    * after predication: the predicate copies the counts through. */
+   uint32_t limit = kk_safe_dispatch_limit();
+   if (limit) {
+      struct kk_ptr clamped = kk_pool_alloc(cmd, sizeof(VkDispatchIndirectCommand), 4u);
+      uint64_t counter = kk_safe_clamp_counter_addr(kk_cmd_buffer_device(cmd));
+      if (likely(clamped.gpu != 0 && counter != 0)) {
+         struct kk_grid grid = kk_grid_1d(1u);
+         libkk_clamp_indirect_dispatch(cmd, grid, false, clamped.gpu, addr, counter, limit);
+         addr = clamped.gpu;
       }
-      if (!kk_flush_compute_state(cmd))
-         return;
-      mtl_dispatch_threadgroups_with_indirect_buffer(encoder, addr, local_size);
    }
+
+   /* Flush compute state after the helper dispatches */
+   if (!kk_flush_compute_state(cmd))
+      return;
+   mtl_dispatch_threadgroups_with_indirect_buffer(encoder, addr, local_size);
 }

diff --git a/src/kosmickrisp/vulkan/kk_cmd_fx.c b/src/kosmickrisp/vulkan/kk_cmd_fx.c
new file mode 100644
index 0000000..cee605c
--- /dev/null
+++ b/src/kosmickrisp/vulkan/kk_cmd_fx.c
@@ -0,0 +1,80 @@
+/*
+ * SPDX-License-Identifier: MIT
+ *
+ * nps5_kk_cmd_metalfx: a MetalFX upscale between two application passes.
+ * Not a Vulkan entry point: the application finds this exported symbol in
+ * the loaded driver (dlsym) and calls it with the driver's own handles while
+ * recording a ONE_TIME_SUBMIT command buffer outside a render pass (the call
+ * is recorded straight into the Metal command buffer, not into the replay
+ * queue of a reusable command buffer).
+ */
+
+#include "kk_cmd_buffer.h"
+#include "kk_device.h"
+#include "kk_image.h"
+
+#include "kosmickrisp/bridge/mtl_fx.h"
+
+struct nps5_kk_metalfx_info {
+   uint32_t size;   /* sizeof(struct nps5_kk_metalfx_info) */
+   uint32_t mode;   /* 1 temporal, 2 spatial */
+   VkImage color, depth, motion, output;
+   uint32_t in_w, in_h;
+   float jitter[2];
+   float mv_scale[2];
+   float mv_bias[2];
+   uint32_t reset;
+   uint32_t depth_reversed;
+   uint32_t auto_exposure;
+   uint32_t reserved;
+};
+
+static void
+kk_fx_resident(void *ctx, void *allocation)
+{
+   kk_device_add_buffer_to_residency_set((struct kk_device *)ctx, allocation);
+}
+
+__attribute__((visibility("default"))) int
+nps5_kk_cmd_metalfx(VkCommandBuffer vk_cmd,
+                    const struct nps5_kk_metalfx_info *info);
+
+__attribute__((visibility("default"))) int
+nps5_kk_cmd_metalfx(VkCommandBuffer vk_cmd,
+                    const struct nps5_kk_metalfx_info *info)
+{
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, vk_cmd);
+   if (cmd == NULL || info == NULL || info->size != sizeof(*info) ||
+       !cmd->one_time_submit || cmd->metal.cmd_buf == NULL)
+      return 0;
+
+   VK_FROM_HANDLE(kk_image, color, info->color);
+   VK_FROM_HANDLE(kk_image, depth, info->depth);
+   VK_FROM_HANDLE(kk_image, motion, info->motion);
+   VK_FROM_HANDLE(kk_image, output, info->output);
+   struct kk_device *dev = kk_cmd_buffer_device(cmd);
+   if (color == NULL || output == NULL)
+      return 0;
+
+   const struct mtl_fx_info fx = {
+      .mode = info->mode == 2 ? MTL_FX_SPATIAL : MTL_FX_TEMPORAL,
+      .color = color->planes[0].mtl_handle,
+      .depth = depth ? depth->planes[0].mtl_handle : NULL,
+      .motion = motion ? motion->planes[0].mtl_handle : NULL,
+      .output = output->planes[0].mtl_handle,
+      .in_w = info->in_w,
+      .in_h = info->in_h,
+      .jitter = {info->jitter[0], info->jitter[1]},
+      .mv_scale = {info->mv_scale[0], info->mv_scale[1]},
+      .mv_bias = {info->mv_bias[0], info->mv_bias[1]},
+      .reset = info->reset != 0,
+      .depth_reversed = info->depth_reversed != 0,
+      .auto_exposure = info->auto_exposure != 0,
+   };
+
+   /* The scaler opens encoders of its own: none of ours may be open (this
+    * also ends a render pass kept open for continuation). */
+   cs_end(cmd);
+   return mtl_fx_scale(cmd->metal.cmd_buf, dev->mtl_handle,
+                       dev->mtl_compiler_handle, &fx, kk_fx_resident, dev);
+}

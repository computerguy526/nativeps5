+         if ((e = getenv("KK_PIPELINE_ARCHIVE_FLUSH_N")) && atoi(e) > 0)
+            kk_flush_n = (uint32_t)atoi(e);
+         if ((e = getenv("KK_PIPELINE_ARCHIVE_FLUSH_S")) && atof(e) > 0.0)
+            kk_flush_s = atof(e);

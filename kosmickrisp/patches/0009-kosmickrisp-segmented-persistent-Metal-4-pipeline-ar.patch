+                 kk_compact ? ", COMPACT" : "", kk_flush_n, kk_flush_s);
+      } else if (file && file[0]) {
+         kk_archive_url = [[NSURL fileURLWithPath:[NSString stringWithUTF8String:file]] retain];
+         NSError *aerr = nil;

+
+int
+mtl_texture_residency_audit(void *texture, mtl_residency_set *residency_set, char *out, unsigned cap)
+{
+   @autoreleasepool {
+      id<MTLTexture> t = (id<MTLTexture>)texture;
+      id<MTLResidencySet> set = (id<MTLResidencySet>)residency_set;
+      if (!t) {
+         snprintf(out, cap, "null texture");
+         return 4;
+      }
+      unsigned depth = 0;
+      id<MTLTexture> root = t;
+      while (root.parentTexture && depth < 8) {
+         root = root.parentTexture;
+         depth++;
+      }
+      int cls;
+      const char *what;
+      if (root.heap) {
+         cls = [set containsAllocation:root.heap] ? 0 : 1;
+         what = "heap";
+      } else if (root.buffer) {
+         cls = [set containsAllocation:root.buffer] ? 2 : 3;
+         what = "buffer";
+      } else {
+         cls = 4;
+         what = "none";
+      }
+      snprintf(out, cap,
+               "tex %p root %p (view depth %u) %lux%lu fmt %lu type %lu usage 0x%lx storage %lu backing %s%s, "
+               "view heap %s, framebufferOnly %d",
+               (void *)t, (void *)root, depth, (unsigned long)root.width, (unsigned long)root.height,
+               (unsigned long)root.pixelFormat, (unsigned long)root.textureType, (unsigned long)root.usage,
+               (unsigned long)root.storageMode, what,
+               cls == 0 || cls == 2 ? " (in set)" : (cls == 4 ? "" : " (NOT in set)"),
+               t.heap ? "yes" : "no", (int)root.framebufferOnly);
+      return cls;
+   }
+}

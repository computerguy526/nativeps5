+/* nps5 devlost: NPS5_KK_RESIDENCY_AUDIT=1 classifies each render-pass attachment texture by how
+ * the device residency set covers it (Metal API validation in SAROS dlB: 30898x "Attachment
+ * texture ... is not added to any residency set"). Prints the first 32 distinct uncovered textures
+ * and the first 4 covered ones, plus a class count every 4096 attachments. Diagnostic only. */
+static void
+kk_residency_audit_attachment(const struct kk_image_view *iview, void *tex)
+{
+   static int on = -1;
+   if (on < 0)
+      on = debug_get_bool_option("NPS5_KK_RESIDENCY_AUDIT", false);
+   if (!on || !tex)
+      return;
+   struct kk_device *dev = container_of(iview->vk.base.device, struct kk_device, vk);
+   static simple_mtx_t lock = SIMPLE_MTX_INITIALIZER;
+   static void *seen[64];
+   static unsigned n_seen, n_ok_shown;
+   static uint64_t counts[5], total;
+   char desc[384];
+   simple_mtx_lock(&dev->residency_set.mutex);
+   int cls = mtl_texture_residency_audit(tex, dev->residency_set.handle, desc, sizeof(desc));
+   simple_mtx_unlock(&dev->residency_set.mutex);
+   simple_mtx_lock(&lock);
+   counts[cls < 0 || cls > 4 ? 4 : cls]++;
+   total++;
+   bool show = false;
+   if (cls != 0 && cls != 2) {
+      bool known = false;
+      for (unsigned i = 0; i < n_seen; i++)
+         known |= seen[i] == tex;
+      if (!known && n_seen < 32) {
+         seen[n_seen++] = tex;
+         show = true;
+      }
+   } else if (n_ok_shown < 4) {
+      n_ok_shown++;
+      show = true;
+   }
+   bool summary = (total & 4095) == 0;
+   uint64_t c0 = counts[0], c1 = counts[1], c2 = counts[2], c3 = counts[3], c4 = counts[4], tt = total;
+   simple_mtx_unlock(&lock);
+   if (show)
+      fprintf(stderr, "[kk-resaudit] class %d: image %ux%u vkfmt %u mips %u layers %u usage 0x%llx: %s\n", cls,
+              iview->vk.image->extent.width, iview->vk.image->extent.height, iview->vk.image->format,
+              iview->vk.image->mip_levels, iview->vk.image->array_layers, (unsigned long long)iview->vk.image->usage, desc);
+   if (summary)
+      fprintf(stderr,
+              "[kk-resaudit] %llu attachments: heap in set %llu, heap NOT in set %llu, buffer in set %llu, buffer NOT "
+              "in set %llu, no backing %llu\n",
+              (unsigned long long)tt, (unsigned long long)c0, (unsigned long long)c1, (unsigned long long)c2,
+              (unsigned long long)c3, (unsigned long long)c4);
+}

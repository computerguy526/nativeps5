+/* Mesh draws. The mesh shader is the pipeline holder (see
+ * kk_cmd_bind_graphics_shader), there is no input assembly and no per-draw
+ * data; a draw is a grid of mesh threadgroups. `addr` is 0 for a direct draw. */
+static void
+kk_draw_mesh(struct kk_cmd_buffer *cmd, struct mtl_size groups, uint64_t addr,
+             uint32_t stride, uint32_t draw_count, uint64_t count_addr)
+{
+   struct kk_shader *ms = cmd->state.shaders[MESA_SHADER_MESH];
+   if (unlikely(ms == NULL))
+      return;
+
+   kk_flush_gfx_state(cmd);
+
+   const bool cond = cmd->state.cond_render.enabled;
+   if (addr == 0 && cond) {
+      /* Conditional rendering patches an indirect command */
+      const uint32_t direct[3] = {groups.x, groups.y, groups.z};
+      struct kk_ptr upload = kk_pool_upload(cmd, direct, sizeof(direct), 4u);
+      if (unlikely(!upload.gpu))
+         return;
+      addr = upload.gpu;
+      stride = sizeof(direct);
+      draw_count = 1;
+   }
+
+   if (addr != 0 && (count_addr != 0 || cond)) {
+      const uint32_t out_stride = sizeof(VkDrawMeshTasksIndirectCommandEXT);
+      /* kk_pool_alloc takes a 32-bit size: a draw count that would wrap the
+       * product must not allocate a short buffer the patch kernel then
+       * writes draw_count entries into. */
+      const uint64_t patched_size = (uint64_t)out_stride * draw_count;
+      if (unlikely(patched_size > UINT32_MAX))
+         return;
+      struct kk_ptr patched = kk_pool_alloc(cmd, (uint32_t)patched_size, 4u);
+      if (unlikely(!patched.gpu))
+         return;
+
+      uint64_t in_addr = addr;
+      uint32_t in_stride_el = stride / sizeof(uint32_t);
+      const uint32_t out_stride_el = out_stride / sizeof(uint32_t);
+      struct kk_grid grid = kk_grid_1d(draw_count);
+      if (count_addr != 0) {
+         libkk_predicate_indirect_gt_draw_id(cmd, grid, true, patched.gpu,
+                                             in_addr, count_addr,
+                                             out_stride_el, in_stride_el);
+         in_addr = patched.gpu;
+         in_stride_el = out_stride_el;
+      }
+      if (cond) {
+         if (cmd->state.cond_render.inverted) {
+            libkk_predicate_indirect_eq_zero(cmd, grid, true, patched.gpu,
+                                             in_addr,
+                                             cmd->state.cond_render.address,
+                                             out_stride_el, in_stride_el);
+         } else {
+            libkk_predicate_indirect_neq_zero(cmd, grid, true, patched.gpu,
+                                              in_addr,
+                                              cmd->state.cond_render.address,
+                                              out_stride_el, in_stride_el);
+         }
+      }
+      addr = patched.gpu;
+      stride = out_stride;
+
+      /* The predicate kernels run in a compute pass of their own */
+      if (cmd->state.gfx.need_to_start_render_pass)
+         kk_flush_gfx_state(cmd);
+   }
+
+   mtl_render_encoder *enc = cs_get_render(cmd);
+   const struct mtl_size threads = ms->info.vs.mesh_local_size;
+   if (addr == 0) {
+      mtl_draw_mesh_threadgroups(enc, groups, threads);
+   } else {
+      for (uint32_t i = 0; i < draw_count; i++)
+         mtl_draw_mesh_threadgroups_indirect(enc, addr + (uint64_t)i * stride,
+                                             threads);
+   }
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawMeshTasksEXT(VkCommandBuffer commandBuffer, uint32_t groupCountX,
+                       uint32_t groupCountY, uint32_t groupCountZ)
+{
+   /* Metal validation dislikes empty calls */
+   if (groupCountX == 0 || groupCountY == 0 || groupCountZ == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_draw_mesh(cmd,
+                (struct mtl_size){groupCountX, groupCountY, groupCountZ}, 0, 0,
+                1, 0);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawMeshTasksIndirect2EXT(VkCommandBuffer commandBuffer,
+                                const VkDrawIndirect2InfoKHR *pInfo)
+{
+   if (pInfo->drawCount == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_draw_mesh(cmd, (struct mtl_size){0, 0, 0}, pInfo->addressRange.address,
+                pInfo->addressRange.stride, pInfo->drawCount, 0);
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_CmdDrawMeshTasksIndirectCount2EXT(VkCommandBuffer commandBuffer,
+                                     const VkDrawIndirectCount2InfoKHR *pInfo)
+{
+   if (pInfo->maxDrawCount == 0)
+      return;
+
+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   kk_draw_mesh(cmd, (struct mtl_size){0, 0, 0}, pInfo->addressRange.address,
+                pInfo->addressRange.stride, pInfo->maxDrawCount,
+                pInfo->countAddressRange.address);
+}

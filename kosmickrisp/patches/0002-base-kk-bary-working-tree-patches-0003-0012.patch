+/* MSL source memory (KK_MSL_COMPRESS, KK_MSL_STATS).
+ *
+ * Every shader keeps its MSL text (and the VS a copy of the other stages')
+ * for pipeline creation and for the pipeline cache blob. With the prebuilt
+ * metallib / MTL4 archive path serving the pipelines the text is only read
+ * again on a rebuild, so KK_MSL_COMPRESS=1 keeps an LZFSE copy instead and
+ * decompresses it on demand. The compressed bytes are also what the shader
+ * serializes, so the pipeline cache blob shrinks the same way. KK_MSL_STATS=1
+ * logs the live MSL bytes to stderr. */
+#define KK_MSL_Z_FLAG 0x80000000u

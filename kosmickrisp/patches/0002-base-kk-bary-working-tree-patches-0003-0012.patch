+static bool
+mesh_slot_is_builtin_uint(unsigned location)
+{
+   return location == VARYING_SLOT_LAYER || location == VARYING_SLOT_VIEWPORT ||
+          location == VARYING_SLOT_PRIMITIVE_ID;
+}
+
+/* Generate the vertex and primitive structs of a mesh shader and the mesh type
+ * built from them */
+static void
+mesh_output_blocks(nir_shader *shader, struct nir_to_msl_ctx *ctx)
+{
+   unsigned clip_count = 0;
+   for (unsigned c = 0; c < 2; c++) {
+      struct io_slot_info info = ctx->outputs_info[VARYING_SLOT_CLIP_DIST0 + c];
+      if (info.num_components)
+         clip_count = c * 4 + info.num_components;
+   }
+
+   for (unsigned pass = 0; pass < 2; pass++) {
+      const bool per_primitive = pass == 1;
+      P(ctx, "struct %s {\n",
+        per_primitive ? "MeshPrimitiveOut" : "MeshVertexOut");
+      ctx->indentlevel++;
+      if (!per_primitive &&
+          !ctx->outputs_info[VARYING_SLOT_POS].num_components)
+         P_IND(ctx, "float4 position [[position]];\n");
+      if (per_primitive &&
+          !ctx->outputs_info[VARYING_SLOT_CULL_PRIMITIVE].num_components)
+         P_IND(ctx, "bool cull_primitive [[primitive_culled]];\n");
+      for (unsigned location = 0; location < NUM_TOTAL_VARYING_SLOTS;
+           location++) {
+         struct io_slot_info info = ctx->outputs_info[location];
+         if (!info.num_components || info.per_primitive != per_primitive)
+            continue;
+         if (location == VARYING_SLOT_CLIP_DIST0 ||
+             location == VARYING_SLOT_CLIP_DIST1)
+            continue;
+         if (location == VARYING_SLOT_CULL_PRIMITIVE) {
+            P_IND(ctx, "bool cull_primitive [[primitive_culled]];\n");
+            continue;
+         }
+         if (location == VARYING_SLOT_POS) {
+            P_IND(ctx, "float4 position [[position]];\n");
+            continue;
+         }
+         if (mesh_slot_is_builtin_uint(location) ||
+             location == VARYING_SLOT_PSIZ) {
+            P_IND(ctx, "%s ", location == VARYING_SLOT_PSIZ ? "float" : "uint");
+         } else {
+            P_IND(ctx, "%s%s ", alu_type_to_string(info.type),
+                  vector_suffixes[info.num_components]);
+         }
+         varying_slot_name(ctx, location, 0);
+         P(ctx, " ");
+         varying_slot_semantic(ctx, location, 0);
+         P(ctx, ";\n");
+      }
+      if (!per_primitive && clip_count)
+         P_IND(ctx, "float gl_ClipDistance [[clip_distance]] [%u];\n",
+               clip_count);
+      ctx->indentlevel--;
+      P(ctx, "};\n");
+   }
+
+   const char *topology = "triangle";
+   if (shader->info.mesh.primitive_type == MESA_PRIM_POINTS)
+      topology = "point";
+   else if (shader->info.mesh.primitive_type == MESA_PRIM_LINES)
+      topology = "line";
+   P(ctx,
+     "using KKMesh = metal::mesh<MeshVertexOut, MeshPrimitiveOut, %u, %u, "
+     "metal::topology::%s>;\n",
+     MAX2(shader->info.mesh.max_vertices_out, 1),
+     MAX2(shader->info.mesh.max_primitives_out, 1), topology);
+}
+
+uint32_t
+msl_mesh_output_name(struct nir_to_msl_ctx *ctx, unsigned location,
+                     unsigned component, bool per_primitive)
+{
+   P(ctx, per_primitive ? "kk_mp." : "kk_mv.");
+   if (location == VARYING_SLOT_CULL_PRIMITIVE) {
+      P(ctx, "cull_primitive");
+      return 1;
+   }
+   varying_slot_name(ctx, location, component);
+   if (location == VARYING_SLOT_POS)
+      return 4;
+   if (location == VARYING_SLOT_CULL_PRIMITIVE ||
+       location == VARYING_SLOT_PSIZ || mesh_slot_is_builtin_uint(location))
+      return 1;
+   return ctx->outputs_info[location].num_components;
+}
+
 /* Generate all the struct definitions needed for shader I/O */
 void
 msl_emit_io_blocks(struct nir_to_msl_ctx *ctx, nir_shader *shader)
@@ -441,6 +561,9 @@ msl_emit_io_blocks(struct nir_to_msl_ctx *ctx, nir_shader *shader)
    case MESA_SHADER_COMPUTE:
    case MESA_SHADER_TESS_CTRL:
       break;
+   case MESA_SHADER_MESH:
+      mesh_output_blocks(shader, ctx);
+      break;
    default:
       assert(0);
    }
@@ -478,6 +601,10 @@ msl_emit_output_var(struct nir_to_msl_ctx *ctx, nir_shader *shader)
                FS_OUTPUT_NAME[location]);
       }
       break;
+   case MESA_SHADER_MESH:
+      P_IND(ctx, "MeshVertexOut kk_mv = {};\n");
+      P_IND(ctx, "MeshPrimitiveOut kk_mp = {};\n");
+      break;
    default:
       break;
    }
diff --git a/src/kosmickrisp/compiler/msl_nir_lower_common.c b/src/kosmickrisp/compiler/msl_nir_lower_common.c
index 757af5c..9844d66 100644
--- a/src/kosmickrisp/compiler/msl_nir_lower_common.c
+++ b/src/kosmickrisp/compiler/msl_nir_lower_common.c
@@ -338,8 +338,10 @@ msl_disable_triangle_merge(nir_shader *nir)
 
    nir_builder b = nir_builder_at(nir_before_impl(entrypoint));
 
+   /* INTERP_MODE_NONE (still the perspective builtin) marks a use that only
+    * looks at the sign: no need for the gl_FragCoord.w normalisation. */
    nir_def *barycentric = nir_load_barycentric_coord_pixel(
-      &b, 32u, .interp_mode = INTERP_MODE_SMOOTH);
+      &b, 32u, .interp_mode = INTERP_MODE_NONE);
    BITSET_SET(nir->info.system_values_read,
               SYSTEM_VALUE_BARYCENTRIC_PERSP_COORD);
 
@@ -992,3 +994,56 @@ msl_nir_lower_multisample_alpha(nir_shader *s, bool alpha_to_coverage,
 
    return progress;
 }
+
+/* Metal only has [[barycentric_coord]] at the pixel center. The other SPIR-V
+ * BaryCoord* flavours (centroid, per-sample, interpolateAt*) are expressed as
+ * a first-order extrapolation of the pixel barycentrics using screen-space
+ * derivatives: exact for no-perspective, a close approximation for
+ * perspective. Centroid maps to the pixel center (exact without MSAA). */
+static bool
+lower_barycentric_coord(nir_builder *b, nir_intrinsic_instr *intr,
+                        UNUSED void *data)
+{
+   nir_def *offset = NULL;
+   switch (intr->intrinsic) {
+   case nir_intrinsic_load_barycentric_coord_centroid:
+      break;
+   case nir_intrinsic_load_barycentric_coord_sample:
+      b->cursor = nir_before_instr(&intr->instr);
+      offset = nir_fadd_imm(
+         b, nir_load_sample_pos_from_id(b, 32u, nir_load_sample_id(b)), -0.5);
+      break;
+   case nir_intrinsic_load_barycentric_coord_at_sample:
+      b->cursor = nir_before_instr(&intr->instr);
+      offset = nir_fadd_imm(
+         b, nir_load_sample_pos_from_id(b, 32u, intr->src[0].ssa), -0.5);
+      break;
+   case nir_intrinsic_load_barycentric_coord_at_offset:
+      b->cursor = nir_before_instr(&intr->instr);
+      offset = intr->src[0].ssa;
+      break;
+   default:
+      return false;
+   }
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_def *pixel = nir_load_barycentric_coord_pixel(
+      b, 32u, .interp_mode = nir_intrinsic_interp_mode(intr));
+   nir_def *res = pixel;
+   if (offset) {
+      res = nir_fadd(b, res,
+                     nir_fmul(b, nir_ddx(b, pixel), nir_channel(b, offset, 0)));
+      res = nir_fadd(b, res,
+                     nir_fmul(b, nir_ddy(b, pixel), nir_channel(b, offset, 1)));
+   }
+   nir_def_replace(&intr->def, res);
+   return true;
+}
+
+bool
+msl_nir_lower_barycentric_coord(nir_shader *nir)
+{
+   assert(nir->info.stage == MESA_SHADER_FRAGMENT);
+   return nir_shader_intrinsics_pass(nir, lower_barycentric_coord,
+                                     nir_metadata_control_flow, NULL);
+}
diff --git a/src/kosmickrisp/compiler/msl_nir_lower_mesh.c b/src/kosmickrisp/compiler/msl_nir_lower_mesh.c
new file mode 100644
index 0000000..d6f3440
--- /dev/null
+++ b/src/kosmickrisp/compiler/msl_nir_lower_mesh.c
@@ -0,0 +1,1024 @@
+/*
+ * Copyright 2026 nativeps5 contributors
+ * SPDX-License-Identifier: MIT
+ */
+
+/* Mesh shaders for Metal.
+ *
+ * A Vulkan mesh shader writes its outputs as arrays: any invocation of the
+ * workgroup may write any component of any vertex or primitive, and
+ * SetMeshOutputsEXT gives the counts. A Metal mesh function instead hands whole
+ * structs to mesh.set_vertex(i, v) / mesh.set_primitive(i, p) and the index
+ * list to mesh.set_index().
+ *
+ * This pass (run while outputs are still variables) therefore:
+ *  - turns every output variable into workgroup (threadgroup) memory, so the
+ *    shader body keeps its array semantics and is lowered by the regular
+ *    shared-memory path,
+ *  - stages the SetMeshOutputsEXT counts in workgroup memory too,
+ *  - appends an epilogue behind a workgroup barrier: invocation i emits the
+ *    vertices and primitives i, i + N, i + 2N, ... (N = workgroup size) by
+ *    filling a thread-local struct (store_per_vertex_output /
+ *    store_per_primitive_output) and committing it (mesh_commit_*_kk).
+ *
+ * Direct outputs. Metal gives a mesh function 32 KiB of threadgroup memory
+ * for the shader's own workgroup memory and the staged outputs together. When
+ * the staged copy would not fit (or KK_MESH_DIRECT=1), the outputs of a class
+ * (per-vertex or per-primitive) are not staged if the shader's writes allow
+ * it: every access to an output is to element [f] where f is one of a few
+ * functions of the invocation alone (its local invocation index or its
+ * subgroup id and subgroup invocation, e.g. gl_MeshVerticesEXT[
+ * gl_LocalInvocationIndex]), and no two invocations can name the same element
+ * (checked by evaluating f for every invocation). Each invocation then owns
+ * the elements it names: they become function-local variables, and after the
+ * barrier the invocation commits its own elements itself. Outputs of the
+ * class that do not fit the pattern stay staged and are read back by the
+ * owner at commit, which is allowed only when the owners provably cover
+ * every element.
+ *
+ * Clip distances go to Metal's clip_distance array. Cull distances have no
+ * Metal equivalent; a primitive whose vertices all have a negative value for
+ * one cull distance is culled through primitive_culled, together with
+ * gl_CullPrimitiveEXT.
+ */
+
+#include "nir_to_msl.h"
+
+#include "nir.h"
+#include "nir_builder.h"
+#include "nir_constant_expressions.h"
+
+#include "util/u_dynarray.h"
+
+#define MESH_MAX_SLOTS     8
+#define MESH_EVAL_NODES    96
+#define MESH_SUBGROUP_SIZE 32
+
+enum mesh_class {
+   MESH_VERTEX,
+   MESH_PRIMITIVE,
+   MESH_CLASSES,
+};
+
+struct mesh_output {
+   nir_variable *var;
+   enum mesh_class cls;
+   /* Vectors/scalars per vertex or primitive: the length of the inner array,
+    * or 1 */
+   unsigned elems;
+   bool array;
+   /* Not staged: element [slot] of this invocation lives in priv[slot] */
+   bool direct;
+   nir_variable **priv;
+};
+
+struct cull_source {
+   struct mesh_output *out;
+   unsigned element;
+};
+
+/* One function of the invocation used as an output index */
+struct mesh_slot {
+   nir_def *expr;
+   uint32_t *values;
+};
+
+struct mesh_class_state {
+   bool direct;
+   bool subgroup_domain;
+   unsigned num_slots;
+   struct mesh_slot slots[MESH_MAX_SLOTS];
+   unsigned max_count;
+   const char *why;
+};
+
+/* An output access `var[index]` whose index is a function of the invocation */
+struct mesh_access {
+   nir_deref_instr *deref;
+   struct mesh_output *out;
+   uint32_t *values;
+   bool subgroup_domain;
+   unsigned slot;
+};
+
+struct mesh_lower_state {
+   /* Sized from the shader (no fixed cap: a release build has no assert to
+    * stop an overflow, and dropping outputs would silently corrupt them). */
+   struct mesh_output *outputs;
+   unsigned num_outputs;
+   nir_variable *counts;
+   struct mesh_output *indices;
+   struct mesh_output *cull_primitive;
+   struct cull_source *cull;
+   unsigned num_cull;
+   unsigned clip_size;
+   bool points;
+   unsigned threads;
+   struct mesh_class_state cls[MESH_CLASSES];
+};
+
+static bool
+retag_output_deref(nir_builder *b, nir_instr *instr, void *data)
+{
+   if (instr->type != nir_instr_type_deref)
+      return false;
+
+   nir_deref_instr *deref = nir_instr_as_deref(instr);
+   if (!(deref->modes & nir_var_shader_out))
+      return false;
+
+   deref->modes = nir_var_mem_shared;
+   return true;
+}
+
+static bool
+lower_set_counts(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   struct mesh_lower_state *state = data;
+   if (intr->intrinsic != nir_intrinsic_set_vertex_and_primitive_count)
+      return false;
+
+   b->cursor = nir_before_instr(&intr->instr);
+   nir_store_array_var_imm(b, state->counts, 0, intr->src[0].ssa, 0x1);
+   nir_store_array_var_imm(b, state->counts, 1, intr->src[1].ssa, 0x1);
+   nir_instr_remove(&intr->instr);
+   return true;
+}
+
+static nir_alu_type
+io_type_for(const struct glsl_type *type)
+{
+   switch (glsl_get_base_type(type)) {
+   case GLSL_TYPE_FLOAT:
+      return nir_type_float32;
+   case GLSL_TYPE_FLOAT16:
+      return nir_type_float16;
+   case GLSL_TYPE_INT:
+      return nir_type_int32;
+   case GLSL_TYPE_UINT:
+      return nir_type_uint32;
+   case GLSL_TYPE_INT16:
+      return nir_type_int16;
+   case GLSL_TYPE_UINT16:
+      return nir_type_uint16;
+   case GLSL_TYPE_BOOL:
+      return nir_type_bool1;
+   default:
+      UNREACHABLE("Unsupported mesh output type");
+   }
+}
+
+/* Position of element `e` of a compact (clip/cull) array in the merged
+ * clip+cull numbering, or of a cull-only array behind the clip distances. */
+static bool
+compact_is_cull(const struct mesh_lower_state *state, const nir_variable *var,
+                unsigned e, unsigned *index)
+{
+   unsigned loc = var->data.location;
+   if (loc == VARYING_SLOT_CULL_DIST0 || loc == VARYING_SLOT_CULL_DIST1) {
+      *index = (loc - VARYING_SLOT_CULL_DIST0) * 4 + var->data.location_frac + e;
+      return true;
+   }
+
+   unsigned g = (loc - VARYING_SLOT_CLIP_DIST0) * 4 + var->data.location_frac + e;
+   if (state->clip_size && g >= state->clip_size) {
+      *index = g - state->clip_size;
+      return true;
+   }
+   *index = g;
+   return false;
+}
+
+static void
+emit_store(nir_builder *b, const struct mesh_lower_state *state, nir_def *value,
+           nir_def *index, unsigned location, unsigned component,
+           nir_alu_type type, bool per_primitive)
+{
+   if (location == VARYING_SLOT_PSIZ && !state->points)
+      return;
+
+   /* Metal has no shading rate or per-primitive viewport mask outputs */
+   if (location == VARYING_SLOT_PRIMITIVE_SHADING_RATE ||
+       location == VARYING_SLOT_VIEWPORT_MASK)
+      return;
+
+   if (location == VARYING_SLOT_LAYER || location == VARYING_SLOT_VIEWPORT ||
+       location == VARYING_SLOT_PRIMITIVE_ID)
+      type = nir_type_uint32;
+
+   const nir_io_semantics sem = {.location = location, .num_slots = 1};
+   if (per_primitive) {
+      nir_store_per_primitive_output(b, value, index, nir_imm_int(b, 0),
+                                     .component = component, .src_type = type,
+                                     .io_semantics = sem,
+                                     .write_mask =
+                                        BITFIELD_MASK(value->num_components));
+   } else {
+      nir_store_per_vertex_output(b, value, index, nir_imm_int(b, 0),
+                                  .component = component, .src_type = type,
+                                  .io_semantics = sem,
+                                  .write_mask =
+                                     BITFIELD_MASK(value->num_components));
+   }
+}
+
+/* Element `e` of vertex/primitive `index` of an output: from the staged
+ * array, or from this invocation's own copy for `slot`. */
+static nir_def *
+load_element(nir_builder *b, const struct mesh_output *out, nir_def *index,
+             unsigned slot, unsigned e)
+{
+   nir_deref_instr *elem =
+      out->direct
+         ? nir_build_deref_var(b, out->priv[slot])
+         : nir_build_deref_array(b, nir_build_deref_var(b, out->var), index);
+   if (out->array)
+      elem = nir_build_deref_array_imm(b, elem, e);
+   return nir_load_deref(b, elem);
+}
+
+/* Copies element `index` of one output into the thread-local output struct. */
+static void
+emit_output(nir_builder *b, const struct mesh_lower_state *state,
+            const struct mesh_output *out, nir_def *index, unsigned slot,
+            bool per_primitive)
+{
+   nir_variable *var = out->var;
+   const struct glsl_type *type = glsl_get_array_element(var->type);
+   unsigned location = var->data.location;
+
+   if (var->data.compact) {
+      assert(glsl_type_is_array(type));
+      for (unsigned e = 0; e < glsl_get_length(type); e++) {
+         unsigned g;
+         if (compact_is_cull(state, var, e, &g))
+            continue;
+         nir_def *value = load_element(b, out, index, slot, e);
+         emit_store(b, state, value, index, VARYING_SLOT_CLIP_DIST0 + g / 4,
+                    g % 4, nir_type_float32, per_primitive);
+      }
+   } else if (glsl_type_is_array(type)) {
+      const struct glsl_type *inner = glsl_get_array_element(type);
+      assert(glsl_type_is_vector_or_scalar(inner));
+      for (unsigned e = 0; e < glsl_get_length(type); e++) {
+         nir_def *value = load_element(b, out, index, slot, e);
+         emit_store(b, state, value, index, location + e,
+                    var->data.location_frac, io_type_for(inner), per_primitive);
+      }
+   } else {
+      assert(glsl_type_is_vector_or_scalar(type));
+      emit_store(b, state, load_element(b, out, index, slot, 0), index,
+                 location, var->data.location_frac, io_type_for(type),
+                 per_primitive);
+   }
+}
+
+static nir_def *
+load_cull_distance(nir_builder *b, const struct cull_source *src,
+                   nir_def *vertex)
+{
+   /* Always staged: read for the vertices of any primitive */
+   assert(!src->out->direct);
+   return load_element(b, src->out, vertex, 0, src->element);
+}
+
+/* ---- direct outputs: analysis ---- */
+
+struct eval_point {
+   uint32_t index;
+   uint32_t subgroup;
+   uint32_t subgroup_invocation;
+};
+
+struct eval_ctx {
+   const nir_shader *nir;
+   unsigned nodes;
+   bool uses_index;
+   bool uses_subgroup;
+};
+
+/* Value of `def` for one invocation, if it is a function of the invocation
+ * alone (constants, invocation system values and ALU on them). */
+static bool
+eval_def(struct eval_ctx *ctx, const struct eval_point *pt, nir_def *def,
+         nir_const_value *out)
+{
+   if (++ctx->nodes > MESH_EVAL_NODES)
+      return false;
+
+   nir_instr *instr = nir_def_instr(def);
+   switch (instr->type) {
+   case nir_instr_type_load_const: {
+      nir_load_const_instr *lc = nir_instr_as_load_const(instr);
+      for (unsigned c = 0; c < def->num_components; c++)
+         out[c] = lc->value[c];
+      return true;
+   }
+   case nir_instr_type_intrinsic: {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      const uint16_t *size = ctx->nir->info.workgroup_size;
+      switch (intr->intrinsic) {
+      case nir_intrinsic_load_local_invocation_index:
+         ctx->uses_index = true;
+         out[0] = nir_const_value_for_uint(pt->index, def->bit_size);
+         return true;
+      case nir_intrinsic_load_local_invocation_id: {
+         ctx->uses_index = true;
+         const uint32_t sx = MAX2(size[0], 1), sy = MAX2(size[1], 1);
+         out[0] = nir_const_value_for_uint(pt->index % sx, def->bit_size);
+         out[1] = nir_const_value_for_uint((pt->index / sx) % sy, def->bit_size);
+         out[2] = nir_const_value_for_uint(pt->index / (sx * sy), def->bit_size);
+         return true;
+      }
+      case nir_intrinsic_load_subgroup_id:
+         ctx->uses_subgroup = true;
+         out[0] = nir_const_value_for_uint(pt->subgroup, def->bit_size);
+         return true;
+      case nir_intrinsic_load_subgroup_invocation:
+         ctx->uses_subgroup = true;
+         out[0] =
+            nir_const_value_for_uint(pt->subgroup_invocation, def->bit_size);
+         return true;
+      default:
+         return false;
+      }
+   }
+   case nir_instr_type_alu: {
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      const nir_op_info *info = &nir_op_infos[alu->op];
+      nir_const_value src[NIR_ALU_MAX_INPUTS][NIR_MAX_VEC_COMPONENTS];
+      nir_const_value *srcs[NIR_ALU_MAX_INPUTS];
+      unsigned bit_size = 0;
+      if (!nir_alu_type_get_type_size(info->output_type))
+         bit_size = alu->def.bit_size;
+
+      for (unsigned i = 0; i < info->num_inputs; i++) {
+         nir_def *s = alu->src[i].src.ssa;
+         if (bit_size == 0 && !nir_alu_type_get_type_size(info->input_types[i]))
+            bit_size = s->bit_size;
+
+         nir_const_value value[NIR_MAX_VEC_COMPONENTS];
+         if (!eval_def(ctx, pt, s, value))
+            return false;
+         for (unsigned j = 0; j < nir_ssa_alu_instr_src_components(alu, i); j++)
+            src[i][j] = value[alu->src[i].swizzle[j]];
+         srcs[i] = src[i];
+      }
+      if (bit_size == 0)
+         bit_size = 32;
+
+      uint16_t poison = 0;
+      memset(out, 0, sizeof(*out) * alu->def.num_components);
+      nir_eval_const_opcode(alu->op, out, &poison, alu->def.num_components,
+                            bit_size, srcs,
+                            ctx->nir->info.float_controls_execution_mode);
+      return poison == 0;
+   }
+   default:
+      return false;
+   }
+}
+
+/* The value of an index for every invocation: `threads` values by local
+ * invocation index, or threads x 32 values by (subgroup id, subgroup
+ * invocation). Metal does not say how invocations map to SIMD groups, so the
+ * second form covers every pair an invocation could have. */
+static uint32_t *
+eval_index(const nir_shader *nir, void *mem_ctx, unsigned threads, nir_def *def,
+           bool *subgroup_domain)
+{
+   if (def->num_components != 1)
+      return NULL;
+
+   struct eval_ctx ctx = {.nir = nir};
+   struct eval_point pt = {0};
+   nir_const_value value[NIR_MAX_VEC_COMPONENTS];
+   if (!eval_def(&ctx, &pt, def, value))
+      return NULL;
+   if (ctx.uses_index && ctx.uses_subgroup)
+      return NULL;
+
+   *subgroup_domain = ctx.uses_subgroup;
+   const unsigned points = threads * (ctx.uses_subgroup ? MESH_SUBGROUP_SIZE : 1);
+   uint32_t *values = ralloc_array(mem_ctx, uint32_t, points);
+   for (unsigned p = 0; p < points; p++) {
+      if (ctx.uses_subgroup) {
+         pt.subgroup = p / MESH_SUBGROUP_SIZE;
+         pt.subgroup_invocation = p % MESH_SUBGROUP_SIZE;
+      } else {
+         pt.index = p;
+      }
+      ctx.nodes = 0;
+      if (!eval_def(&ctx, &pt, def, value))
+         return NULL;
+      const uint64_t v = nir_const_value_as_uint(value[0], def->bit_size);
+      values[p] = (uint32_t)MIN2(v, (uint64_t)UINT32_MAX);
+   }
+   return values;
+}
+
+static struct mesh_output *
+find_output(struct mesh_lower_state *state, const nir_variable *var)
+{
+   for (unsigned i = 0; i < state->num_outputs; i++) {
+      if (state->outputs[i].var == var)
+         return &state->outputs[i];
+   }
+   return NULL;
+}
+
+static bool
+use_is_load_or_store(nir_src *use)
+{
+   nir_instr *instr = nir_src_use_instr(use);
+   if (instr->type != nir_instr_type_intrinsic)
+      return false;
+   nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+   return intr->intrinsic == nir_intrinsic_load_deref ||
+          (intr->intrinsic == nir_intrinsic_store_deref &&
+           use == &intr->src[0]);
+}
+
+/* `deref` is var[index]: only whole-element loads and stores below it */
+static bool
+element_uses_are_simple(const struct mesh_output *out, nir_deref_instr *deref)
+{
+   nir_foreach_use_including_if(use, &deref->def) {
+      if (nir_src_is_if(use))
+         return false;
+      if (!out->array) {
+         if (!use_is_load_or_store(use))
+            return false;
+         continue;
+      }
+
+      nir_instr *instr = nir_src_use_instr(use);
+      if (instr->type != nir_instr_type_deref)
+         return false;
+      nir_deref_instr *inner = nir_instr_as_deref(instr);
+      if (inner->deref_type != nir_deref_type_array)
+         return false;
+      nir_foreach_use_including_if(inner_use, &inner->def) {
+         if (nir_src_is_if(inner_use) || !use_is_load_or_store(inner_use))
+            return false;
+      }
+   }
+   return true;
+}
+
+static unsigned
+type_bytes(const struct glsl_type *type)
+{
+   if (glsl_type_is_array(type))
+      return glsl_get_length(type) * type_bytes(glsl_get_array_element(type));
+   if (!glsl_type_is_vector_or_scalar(type))
+      return 0;
+   return glsl_get_vector_elements(type) *
+          (glsl_type_is_boolean(type) ? 4 : glsl_get_bit_size(type) / 8);
+}
+
+static unsigned
+find_slot(const struct mesh_class_state *cls, unsigned threads,
+          const uint32_t *values)
+{
+   const unsigned points =
+      threads * (cls->subgroup_domain ? MESH_SUBGROUP_SIZE : 1);
+   for (unsigned k = 0; k < cls->num_slots; k++) {
+      if (!memcmp(cls->slots[k].values, values, points * sizeof(uint32_t)))
+         return k;
+   }
+   return cls->num_slots;
+}
+
+/* No element is named by two invocations or by two indices of one. `owned`
+ * is the number of elements that are named at all. */
+static bool
+slots_are_disjoint(const struct mesh_lower_state *state,
+                   const struct mesh_class_state *cls, unsigned *owned)
+{
+   const unsigned points =
+      state->threads * (cls->subgroup_domain ? MESH_SUBGROUP_SIZE : 1);
+   BITSET_WORD *seen = rzalloc_array(state->outputs, BITSET_WORD,
+                                     BITSET_WORDS(MAX2(cls->max_count, 1u)));
+   bool disjoint = true;
+   *owned = 0;
+   for (unsigned k = 0; k < cls->num_slots && disjoint; k++) {
+      for (unsigned p = 0; p < points; p++) {
+         const uint32_t v = cls->slots[k].values[p];
+         if (v >= cls->max_count)
+            continue;
+         if (BITSET_TEST(seen, v)) {
+            disjoint = false;
+            break;
+         }
+         BITSET_SET(seen, v);
+         (*owned)++;
+      }
+   }
+   ralloc_free(seen);
+   return disjoint;
+}
+
+/* Decides per class whether its outputs can skip the staging, fills
+ * state->cls and the accesses to rewrite. */
+static void
+analyze_direct(nir_shader *nir, nir_function_impl *impl,
+               struct mesh_lower_state *state, struct util_dynarray *accesses)
+{
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr(instr, block) {
+         if (instr->type != nir_instr_type_deref)
+            continue;
+         nir_deref_instr *deref = nir_instr_as_deref(instr);
+
+         if (deref->deref_type == nir_deref_type_var) {
+            struct mesh_output *out = find_output(state, deref->var);
+            if (!out)
+               continue;
+            nir_foreach_use_including_if(use, &deref->def) {
+               if (nir_src_is_if(use) ||
+                   nir_src_use_instr(use)->type != nir_instr_type_deref ||
+                   nir_instr_as_deref(nir_src_use_instr(use))->deref_type !=
+                      nir_deref_type_array)
+                  out->direct = false;
+            }
+            continue;
+         }
+
+         nir_deref_instr *parent = nir_deref_instr_parent(deref);
+         if (!parent || parent->deref_type != nir_deref_type_var)
+            continue;
+         struct mesh_output *out = find_output(state, parent->var);
+         if (!out || !out->direct)
+            continue;
+
+         struct mesh_access access = {.deref = deref, .out = out};
+         if (deref->deref_type != nir_deref_type_array ||
+             !element_uses_are_simple(out, deref) ||
+             !(access.values =
+                  eval_index(nir, state->outputs, state->threads,
+                             deref->arr.index.ssa, &access.subgroup_domain))) {
+            out->direct = false;
+            continue;
+         }
+         util_dynarray_append(accesses, access);
+      }
+   }
+
+   for (unsigned c = 0; c < MESH_CLASSES; c++) {
+      struct mesh_class_state *cls = &state->cls[c];
+      bool all_direct = true;
+      unsigned owned = 0;
+
+      /* Output by output: it joins the direct ones if, with its indices
+       * added, still no two invocations (or two indices of one) can name the
+       * same element. */
+      for (unsigned i = 0; i < state->num_outputs; i++) {
+         struct mesh_output *out = &state->outputs[i];
+         if (out->cls != c)
+            continue;
+
+         const unsigned saved_slots = cls->num_slots;
+         const bool saved_domain = cls->subgroup_domain;
+         util_dynarray_foreach(accesses, struct mesh_access, access) {
+            if (access->out != out || !out->direct)
+               continue;
+            if (cls->num_slots &&
+                cls->subgroup_domain != access->subgroup_domain) {
+               out->direct = false;
+               break;
+            }
+            if (find_slot(cls, state->threads, access->values) <
+                cls->num_slots)
+               continue;
+            if (cls->num_slots == MESH_MAX_SLOTS) {
+               out->direct = false;
+               break;
+            }
+            cls->subgroup_domain = access->subgroup_domain;
+            cls->slots[cls->num_slots++] = (struct mesh_slot){
+               .expr = access->deref->arr.index.ssa,
+               .values = access->values,
+            };
+         }
+         if (out->direct && cls->num_slots != saved_slots &&
+             !slots_are_disjoint(state, cls, &owned))
+            out->direct = false;
+         if (!out->direct) {
+            cls->num_slots = saved_slots;
+            cls->subgroup_domain = saved_domain;
+            all_direct = false;
+         }
+      }
+
+      slots_are_disjoint(state, cls, &owned);
+      cls->direct = true;
+      cls->why = all_direct ? "all outputs" : "some outputs stay staged";
+      if (cls->num_slots == 0) {
+         cls->direct = false;
+         cls->why = "no output is indexed by the invocation alone, each "
+                    "element from one invocation";
+      } else if (!all_direct &&
+                 (cls->subgroup_domain || owned != cls->max_count)) {
+         /* A staged output is read back by the owner of the element at
+          * commit: every element needs one */
+         cls->direct = false;
+         cls->why = "an output needs staging and not every element has an "
+                    "owner";
+      }
+
+      for (unsigned i = 0; i < state->num_outputs; i++) {
+         if (state->outputs[i].cls == c && !cls->direct)
+            state->outputs[i].direct = false;
+      }
+      util_dynarray_foreach(accesses, struct mesh_access, access) {
+         if (access->out->cls == c && access->out->direct)
+            access->slot = find_slot(cls, state->threads, access->values);
+      }
+   }
+}
+
+/* Recreates an index expression at the cursor */
+static nir_def *
+rebuild_index(nir_builder *b, nir_def *def)
+{
+   nir_instr *instr = nir_def_instr(def);
+   switch (instr->type) {
+   case nir_instr_type_load_const:
+      return nir_build_imm(b, def->num_components, def->bit_size,
+                           nir_instr_as_load_const(instr)->value);
+   case nir_instr_type_intrinsic:
+      switch (nir_instr_as_intrinsic(instr)->intrinsic) {
+      case nir_intrinsic_load_local_invocation_index:
+         return nir_load_local_invocation_index(b);
+      case nir_intrinsic_load_local_invocation_id:
+         return nir_load_local_invocation_id(b);
+      case nir_intrinsic_load_subgroup_id:
+         return nir_load_subgroup_id(b);
+      case nir_intrinsic_load_subgroup_invocation:
+         return nir_load_subgroup_invocation(b);
+      default:
+         UNREACHABLE("not an invocation value");
+      }
+   case nir_instr_type_alu: {
+      nir_alu_instr *alu = nir_instr_as_alu(instr);
+      nir_def *src[NIR_ALU_MAX_INPUTS];
+      for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++)
+         src[i] = rebuild_index(b, alu->src[i].src.ssa);
+      nir_alu_instr *clone = nir_alu_instr_clone(b->shader, alu);
+      for (unsigned i = 0; i < nir_op_infos[alu->op].num_inputs; i++)
+         clone->src[i].src = nir_src_for_ssa(src[i]);
+      nir_builder_instr_insert(b, &clone->instr);
+      return &clone->def;
+   }
+   default:
+      UNREACHABLE("not an invocation value");
+   }
+}
+
+/* Points every access of a direct output at the invocation's own copy */
+static void
+rewrite_direct(nir_function_impl *impl, struct mesh_lower_state *state,
+               struct util_dynarray *accesses)
+{
+   for (unsigned i = 0; i < state->num_outputs; i++) {
+      struct mesh_output *out = &state->outputs[i];
+      if (!out->direct)
+         continue;
+
+      /* Inner arrays stay arrays here: the caller lowers indirect accesses
+       * and splits them (kk_lower_nir) */
+      const struct glsl_type *type = glsl_get_array_element(out->var->type);
+      const unsigned slots = state->cls[out->cls].num_slots;
+      out->priv = rzalloc_array(state->outputs, nir_variable *, slots);
+      for (unsigned v = 0; v < slots; v++)
+         out->priv[v] = nir_local_variable_create(impl, type, "kk_mesh_own");
+   }
+
+   util_dynarray_foreach(accesses, struct mesh_access, access) {
+      struct mesh_output *out = access->out;
+      if (!out->direct)
+         continue;
+
+      nir_deref_instr *deref = access->deref;
+      nir_builder b = nir_builder_at(nir_before_instr(&deref->instr));
+      nir_deref_instr *own = nir_build_deref_var(&b, out->priv[access->slot]);
+      nir_def_rewrite_uses(&deref->def, &own->def);
+      nir_instr_remove(&deref->instr);
+      if (out->array) {
+         nir_foreach_use(use, &own->def)
+            nir_instr_as_deref(nir_src_use_instr(use))->modes = own->modes;
+      }
+   }
+
+   /* The output variables themselves are gone */
+   nir_foreach_block(block, impl) {
+      nir_foreach_instr_safe(instr, block) {
+         if (instr->type != nir_instr_type_deref)
+            continue;
+         nir_deref_instr *deref = nir_instr_as_deref(instr);
+         if (deref->deref_type != nir_deref_type_var)
+            continue;
+         struct mesh_output *out = find_output(state, deref->var);
+         if (out && out->direct) {
+            assert(nir_def_is_unused(&deref->def));
+            nir_instr_remove(instr);
+         }
+      }
+   }
+   for (unsigned i = 0; i < state->num_outputs; i++) {
+      if (state->outputs[i].direct)
+         exec_node_remove(&state->outputs[i].var->node);
+   }
+}
+
+/* Vertex outputs of `vertex` into the output struct, then the commit */
+static void
+emit_vertex(nir_builder *b, const struct mesh_lower_state *state,
+            nir_def *vertex, unsigned slot)
+{
+   for (unsigned i = 0; i < state->num_outputs; i++) {
+      const struct mesh_output *out = &state->outputs[i];
+      if (out->cls != MESH_VERTEX)
+         continue;
+      emit_output(b, state, out, vertex, slot, false);
+   }
+   nir_mesh_commit_vertex_kk(b, vertex);
+}
+
+static void
+emit_primitive(nir_builder *b, const struct mesh_lower_state *state,
+               nir_def *primitive, unsigned slot, unsigned max_vertices,
+               unsigned prim_verts)
+{
+   for (unsigned i = 0; i < state->num_outputs; i++) {
+      const struct mesh_output *out = &state->outputs[i];
+      if (out->cls != MESH_PRIMITIVE || out == state->indices ||
+          out == state->cull_primitive)
+         continue;
+      emit_output(b, state, out, primitive, slot, true);
+   }
+
+   nir_def *indices;
+   if (state->indices) {
+      indices = load_element(b, state->indices, primitive, slot, 0);
+      /* A corrupt index must not reach set_index */
+      indices = nir_umin(
+         b, indices,
+         nir_imm_intN_t(b, MAX2(max_vertices, 1) - 1, indices->bit_size));
+   } else {
+      indices = nir_imm_zero(b, prim_verts, 32);
+   }
+
+   if (state->cull_primitive || state->num_cull) {
+      nir_def *culled = nir_imm_false(b);
+      if (state->cull_primitive)
+         culled = load_element(b, state->cull_primitive, primitive, slot, 0);
+      for (unsigned c = 0; c < state->num_cull; c++) {
+         nir_def *all_negative = nir_imm_true(b);
+         for (unsigned v = 0; v < indices->num_components; v++) {
+            nir_def *distance = load_cull_distance(
+               b, &state->cull[c], nir_channel(b, indices, v));
+            all_negative =
+               nir_iand(b, all_negative, nir_flt_imm(b, distance, 0.0));
+         }
+         culled = nir_ior(b, culled, all_negative);
+      }
+      emit_store(b, state, culled, primitive, VARYING_SLOT_CULL_PRIMITIVE, 0,
+                 nir_type_bool1, true);
+   }
+
+   nir_mesh_commit_primitive_kk(b, primitive, indices);
+}
+
+bool
+msl_nir_lower_mesh(nir_shader *nir, unsigned threadgroup_limit)
+{
+   assert(nir->info.stage == MESA_SHADER_MESH);
+   nir_function_impl *impl = nir_shader_get_entrypoint(nir);
+
+   const uint32_t threads = MAX2(1u, (uint32_t)nir->info.workgroup_size[0] *
+                                        nir->info.workgroup_size[1] *
+                                        nir->info.workgroup_size[2]);
+   const uint32_t prim_verts =
+      mesa_vertices_per_prim(nir->info.mesh.primitive_type);
+
+   struct mesh_lower_state state = {
+      .clip_size = nir->info.clip_distance_array_size,
+      .points = nir->info.mesh.primitive_type == MESA_PRIM_POINTS,
+      .threads = threads,
+      .cls[MESH_VERTEX].max_count = nir->info.mesh.max_vertices_out,
+      .cls[MESH_PRIMITIVE].max_count = nir->info.mesh.max_primitives_out,
+   };
+
+   unsigned output_count = 0;
+   unsigned cull_capacity = 0;
+   nir_foreach_variable_with_modes(var, nir, nir_var_shader_out) {
+      output_count++;
+      if (var->data.compact)
+         cull_capacity += glsl_get_length(glsl_get_array_element(var->type));
+   }
+   state.outputs =
+      rzalloc_array(nir, struct mesh_output, MAX2(output_count, 1u));
+   state.cull = rzalloc_array(nir, struct cull_source, MAX2(cull_capacity, 1u));
+
+   /* What the staged copy of every output would take, next to the shader's
+    * own workgroup memory and the two counts */
+   unsigned staged_bytes = align(nir->info.shared_size, 16) + 8;
+   nir_foreach_variable_with_modes(var, nir, nir_var_shader_out) {
+      struct mesh_output *out = &state.outputs[state.num_outputs++];
+      const struct glsl_type *elem =
+         glsl_type_is_array(var->type) ? glsl_get_array_element(var->type)
+                                       : NULL;
+      *out = (struct mesh_output){
+         .var = var,
+         .cls = var->data.per_primitive ||
+                      var->data.location == VARYING_SLOT_PRIMITIVE_INDICES ||
+                      var->data.location == VARYING_SLOT_CULL_PRIMITIVE
+                   ? MESH_PRIMITIVE
+                   : MESH_VERTEX,
+         .array = elem && glsl_type_is_array(elem),
+         .elems = elem && glsl_type_is_array(elem) ? glsl_get_length(elem) : 1,
+      };
+      out->direct =
+         elem && glsl_type_is_vector_or_scalar(out->array
+                                                  ? glsl_get_array_element(elem)
+                                                  : elem);
+      staged_bytes += type_bytes(var->type);
+   }
+
+   for (unsigned i = 0; i < state.num_outputs; i++) {
+      struct mesh_output *out = &state.outputs[i];
+      nir_variable *var = out->var;
+
+      if (var->data.location == VARYING_SLOT_PRIMITIVE_INDICES)
+         state.indices = out;
+      else if (var->data.location == VARYING_SLOT_CULL_PRIMITIVE)
+         state.cull_primitive = out;
+      else if (var->data.compact) {
+         const struct glsl_type *elem = glsl_get_array_element(var->type);
+         for (unsigned e = 0; e < glsl_get_length(elem); e++) {
+            unsigned index;
+            if (compact_is_cull(&state, var, e, &index) &&
+                state.num_cull < cull_capacity) {
+               state.cull[state.num_cull++] =
+                  (struct cull_source){.out = out, .element = e};
+               /* Read for the vertices of any primitive: stays staged */
+               out->direct = false;
+            }
+         }
+      }
+   }
+
+   /* KK_MESH_DIRECT=1: direct outputs wherever the writes allow, 0: never.
+    * Default: only for a shader whose staged outputs do not fit. */
+   const char *direct_env = getenv("KK_MESH_DIRECT");
+   const bool want_direct = direct_env ? atoi(direct_env) != 0
+                                       : staged_bytes > threadgroup_limit;
+   struct util_dynarray accesses;
+   util_dynarray_init(&accesses, state.outputs);
+   if (want_direct) {
+      analyze_direct(nir, impl, &state, &accesses);
+      rewrite_direct(impl, &state, &accesses);
+   } else {
+      for (unsigned i = 0; i < state.num_outputs; i++)
+         state.outputs[i].direct = false;
+      state.cls[MESH_VERTEX].why = state.cls[MESH_PRIMITIVE].why =
+         "staging fits";
+   }
+
+   unsigned direct_outputs[MESH_CLASSES] = {0}, class_outputs[MESH_CLASSES] = {0};
+   for (unsigned i = 0; i < state.num_outputs; i++) {
+      class_outputs[state.outputs[i].cls]++;
+      direct_outputs[state.outputs[i].cls] += state.outputs[i].direct;
+   }
+   if (getenv("KK_MESH_DEBUG"))
+      fprintf(stderr,
+              "[kk-mesh] outputs: staged copy would need %u B with the "
+              "workgroup memory (limit %u); vertices %s (%u of %u outputs "
+              "direct, %u indices: %s), primitives %s (%u of %u outputs "
+              "direct, %u indices: %s)\n",
+              staged_bytes, threadgroup_limit,
+              state.cls[MESH_VERTEX].direct ? "direct" : "staged",
+              direct_outputs[MESH_VERTEX], class_outputs[MESH_VERTEX],
+              state.cls[MESH_VERTEX].num_slots, state.cls[MESH_VERTEX].why,
+              state.cls[MESH_PRIMITIVE].direct ? "direct" : "staged",
+              direct_outputs[MESH_PRIMITIVE], class_outputs[MESH_PRIMITIVE],
+              state.cls[MESH_PRIMITIVE].num_slots,
+              state.cls[MESH_PRIMITIVE].why);
+
+   for (unsigned i = 0; i < state.num_outputs; i++) {
+      if (!state.outputs[i].direct)
+         state.outputs[i].var->data.mode = nir_var_mem_shared;
+   }
+
+   nir_shader_instructions_pass(nir, retag_output_deref,
+                                nir_metadata_control_flow, NULL);
+
+   state.counts =
+      nir_variable_create(nir, nir_var_mem_shared,
+                          glsl_array_type(glsl_uint_type(), 2, 0),
+                          "kk_mesh_counts");
+   nir_shader_intrinsics_pass(nir, lower_set_counts, nir_metadata_control_flow,
+                              &state);
+
+   /* Prologue: no outputs unless SetMeshOutputsEXT runs. */
+   nir_builder b = nir_builder_at(nir_before_impl(impl));
+   for (unsigned i = 0; i < state.num_outputs; i++) {
+      const struct mesh_output *out = &state.outputs[i];
+      if (!out->direct)
+         continue;
+      /* An element this invocation owns but never wrote is undefined in
+       * Vulkan; give it a value all the same */
+      for (unsigned v = 0; v < state.cls[out->cls].num_slots; v++) {
+         const struct glsl_type *type = glsl_without_array(out->priv[v]->type);
+         const unsigned comps = glsl_get_vector_elements(type);
+         nir_def *zero = nir_imm_zero(&b, comps, glsl_get_bit_size(type));
+         for (unsigned e = 0; e < out->elems; e++) {
+            nir_deref_instr *own = nir_build_deref_var(&b, out->priv[v]);
+            if (out->array)
+               own = nir_build_deref_array_imm(&b, own, e);
+            nir_store_deref(&b, own, zero, BITFIELD_MASK(comps));
+         }
+      }
+   }
+   nir_def *invocation = nir_load_local_invocation_index(&b);
+   nir_push_if(&b, nir_ieq_imm(&b, invocation, 0));
+   {
+      nir_store_array_var_imm(&b, state.counts, 0, nir_imm_int(&b, 0), 0x1);
+      nir_store_array_var_imm(&b, state.counts, 1, nir_imm_int(&b, 0), 0x1);
+   }
+   nir_pop_if(&b, NULL);
+   nir_barrier(&b, .execution_scope = SCOPE_WORKGROUP,
+               .memory_scope = SCOPE_WORKGROUP,
+               .memory_semantics = NIR_MEMORY_ACQ_REL,
+               .memory_modes = nir_var_mem_shared);
+
+   /* Epilogue */
+   b.cursor = nir_after_impl(impl);
+   nir_barrier(&b, .execution_scope = SCOPE_WORKGROUP,
+               .memory_scope = SCOPE_WORKGROUP,
+               .memory_semantics = NIR_MEMORY_ACQ_REL,
+               .memory_modes = nir_var_mem_shared);
+   invocation = nir_load_local_invocation_index(&b);
+   nir_def *vertex_count =
+      nir_umin(&b, nir_load_array_var_imm(&b, state.counts, 0),
+               nir_imm_int(&b, nir->info.mesh.max_vertices_out));
+   nir_def *primitive_count =
+      nir_umin(&b, nir_load_array_var_imm(&b, state.counts, 1),
+               nir_imm_int(&b, nir->info.mesh.max_primitives_out));
+
+   nir_push_if(&b, nir_ieq_imm(&b, invocation, 0));
+   nir_mesh_set_primitive_count_kk(&b, primitive_count);
+   nir_pop_if(&b, NULL);
+
+   nir_variable *cursor =
+      nir_local_variable_create(impl, glsl_uint_type(), "kk_mesh_cursor");
+
+   if (state.cls[MESH_VERTEX].direct) {
+      /* Each invocation commits the vertices it owns */
+      for (unsigned k = 0; k < state.cls[MESH_VERTEX].num_slots; k++) {
+         nir_def *vertex = nir_u2u32(
+            &b, rebuild_index(&b, state.cls[MESH_VERTEX].slots[k].expr));
+         nir_push_if(&b, nir_ult(&b, vertex, vertex_count));
+         emit_vertex(&b, &state, vertex, k);
+         nir_pop_if(&b, NULL);
+      }
+   } else {
+      nir_store_var(&b, cursor, invocation, 0x1);
+      nir_push_loop(&b);
+      {
+         nir_def *vertex = nir_load_var(&b, cursor);
+         nir_break_if(&b, nir_uge(&b, vertex, vertex_count));
+         emit_vertex(&b, &state, vertex, 0);
+         nir_store_var(&b, cursor, nir_iadd_imm(&b, vertex, threads), 0x1);
+      }
+      nir_pop_loop(&b, NULL);
+   }
+
+   if (state.cls[MESH_PRIMITIVE].direct) {
+      for (unsigned k = 0; k < state.cls[MESH_PRIMITIVE].num_slots; k++) {
+         nir_def *primitive = nir_u2u32(
+            &b, rebuild_index(&b, state.cls[MESH_PRIMITIVE].slots[k].expr));
+         nir_push_if(&b, nir_ult(&b, primitive, primitive_count));
+         emit_primitive(&b, &state, primitive, k,
+                        nir->info.mesh.max_vertices_out, prim_verts);
+         nir_pop_if(&b, NULL);
+      }
+   } else {
+      nir_store_var(&b, cursor, invocation, 0x1);
+      nir_push_loop(&b);
+      {
+         nir_def *primitive = nir_load_var(&b, cursor);
+         nir_break_if(&b, nir_uge(&b, primitive, primitive_count));
+         emit_primitive(&b, &state, primitive, 0,
+                        nir->info.mesh.max_vertices_out, prim_verts);
+         nir_store_var(&b, cursor, nir_iadd_imm(&b, primitive, threads), 0x1);
+      }
+      nir_pop_loop(&b, NULL);
+   }
+
+   ralloc_free(state.outputs);
+   ralloc_free(state.cull);
+   return nir_progress(true, impl, nir_metadata_none);
+}

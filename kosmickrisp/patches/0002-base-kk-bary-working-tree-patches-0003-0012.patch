+static atomic_llong kk_msl_live_raw, kk_msl_live_z, kk_msl_live_z_raw;
+static atomic_uint kk_msl_events;
+
+static bool
+kk_msl_compress_enabled(void)
+{
+   static int v = -1;
+   if (v < 0) {
+      const char *e = getenv("KK_MSL_COMPRESS");
+      v = e && atoi(e) != 0;
+   }
+   return v;

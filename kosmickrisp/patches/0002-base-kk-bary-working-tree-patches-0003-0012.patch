+                                               deref->modes, align_mul,
+                                               align_offset,
+                                               intrin->num_components, 0,
+                                               vec_size);
+            nir_push_else(b, NULL);
+         }
          for (unsigned i = 0; i < intrin->num_components; i++) {
             unsigned comp_offset = i * vec_stride;
             nir_io_offset comp_addr =
@@ -1516,6 +1552,10 @@ nir_lower_explicit_io_instr(nir_builder *b,
                                               1, comp_offset, scalar_size);
          }
          value = nir_vec(b, comps, intrin->num_components);
+         if (vec_bounded) {
+            nir_pop_if(b, NULL);
+            value = nir_if_phi(b, vec_value, value);
+         }
       } else {
          nir_io_offset addr = build_addr(b, intrin, base_addr, addr_format, 0,
                                          align_mul, align_offset);

 #include "util/u_memory.h"
 
+#include <stdatomic.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+
+/* KK_MEM_STATS=<seconds>: every <seconds> (default 5) print the live device
+ * memory KK allocated, by owner (MiB), as one "[kk-mem]" line, plus a final line
+ * at exit. Heap-level owners are what IOAccelerator sees; the IMG/BUFFER rows
+ * are resources placed inside the APP_ALLOC heaps and not additional. */
+static atomic_llong kk_mem_live[KK_MEM_CAT_COUNT], kk_mem_peak[KK_MEM_CAT_COUNT];
+static atomic_llong kk_mem_total[KK_MEM_CAT_COUNT];
+
+static const char *const kk_mem_names[KK_MEM_CAT_COUNT] = {
+   "none",      "app",        "host_import", "metal_import", "cmd_pool",
+   "cmd_large", "geom_heap",  "desc_pool",   "event",        "query_pool",
+   "query_tbl", "img_rt",     "img_other",   "buffer",
+};
+
+static void
+kk_mem_print(void)
+{
+   fprintf(stderr, "[kk-mem] live MiB:");
+   long long heap = 0;
+   for (int i = 1; i < KK_MEM_CAT_COUNT; i++) {
+      long long v = atomic_load(&kk_mem_live[i]);
+      fprintf(stderr, " %s=%.1f(pk %.1f)", kk_mem_names[i], v / 1048576.0,
+              atomic_load(&kk_mem_peak[i]) / 1048576.0);
+      if (i <= KK_MEM_QUERY_TABLE && i != KK_MEM_HOST_IMPORT)
+         heap += v;
+   }
+   fprintf(stderr, " | owned_heaps=%.1f\n", heap / 1048576.0);
+}
+
+void
+kk_mem_account(enum kk_mem_cat cat, int64_t bytes)
+{
+   static int period = -1;
+   static _Atomic double last;
+   if (period < 0) {
+      const char *e = getenv("KK_MEM_STATS");
+      period = e ? (atoi(e) > 0 ? atoi(e) : 5) : 0;
+      if (period)
+         atexit(kk_mem_print);
+   }
+   if (!period || cat == KK_MEM_NONE)
+      return;
+   long long v = atomic_fetch_add(&kk_mem_live[cat], bytes) + bytes;
+   if (bytes > 0) {
+      atomic_fetch_add(&kk_mem_total[cat], bytes);
+      long long pk = atomic_load(&kk_mem_peak[cat]);
+      while (v > pk && !atomic_compare_exchange_weak(&kk_mem_peak[cat], &pk, v))
+         ;
+   }
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   double now = ts.tv_sec + ts.tv_nsec * 1e-9;
+   double l = atomic_load(&last);
+   if (now - l >= period && atomic_compare_exchange_strong(&last, &l, now))
+      kk_mem_print();
+}

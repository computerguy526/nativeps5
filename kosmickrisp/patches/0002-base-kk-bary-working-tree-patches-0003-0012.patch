+
+static void
+kk_msl_stats_print(void)
+{
+   fprintf(stderr,
+           "[kk-msl] live raw %lld B (%.1f MiB), compressed %lld B (%.1f MiB, "
+           "raw-equivalent %.1f MiB)\n",
+           (long long)atomic_load(&kk_msl_live_raw),
+           atomic_load(&kk_msl_live_raw) / 1048576.0,
+           (long long)atomic_load(&kk_msl_live_z),
+           atomic_load(&kk_msl_live_z) / 1048576.0,
+           atomic_load(&kk_msl_live_z_raw) / 1048576.0);
+}
+
+static void
+kk_msl_stats_event(long long raw, long long z, long long z_raw)
+{
+   static int on = -1;
+   if (on < 0) {
+      on = getenv("KK_MSL_STATS") != NULL;
+      if (on)
+         atexit(kk_msl_stats_print);
+   }
+   atomic_fetch_add(&kk_msl_live_raw, raw);
+   atomic_fetch_add(&kk_msl_live_z, z);
+   atomic_fetch_add(&kk_msl_live_z_raw, z_raw);
+   if (on && (atomic_fetch_add(&kk_msl_events, 1) % 512) == 511)
+      kk_msl_stats_print();
+}
+
+static void
+kk_msl_account_raw(const char *code, int sign)
+{
+   if (code)
+      kk_msl_stats_event(sign * (long long)(strlen(code) + 1), 0, 0);
+}
+
+static void
+kk_msl_pack(struct msl_compile_data *d, struct kk_msl_z *z)
+{
+   if (!kk_msl_compress_enabled() || !d->code || z->data)
+      return;
+   const uint32_t raw_len = strlen(d->code) + 1;
+   void *buf = malloc(raw_len);
+   if (!buf)
+      return;
+   size_t n = compression_encode_buffer(buf, raw_len, (const uint8_t *)d->code,
+                                        raw_len, NULL, COMPRESSION_LZFSE);
+   if (n == 0 || n >= raw_len) {
+      free(buf);
+      return;
+   }
+   void *small = realloc(buf, n);
+   z->data = small ? small : buf;
+   z->len = n;
+   z->raw_len = raw_len;
+   kk_msl_stats_event(-(long long)raw_len, n, raw_len);
+   ralloc_free(d->code);
+   d->code = NULL;

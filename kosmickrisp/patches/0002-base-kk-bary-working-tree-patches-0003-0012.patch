+/* Relaxed timestamps are sampled at command encoder boundaries, so every timestamp written inside
+ * one encoder reads the same value. Precise ones can split the encoder, which gives each
+ * vkCmdWriteTimestamp its own value (what a profiler needs). KK_TS_RELAXED=1 selects Relaxed. */
+static MTL4TimestampGranularity
+nps5_ts_granularity(void)
+{
+   static int relaxed = -1;
+   if (relaxed < 0) {
+      const char *e = getenv("KK_TS_RELAXED");
+      relaxed = (e && *e && *e != '0') ? 1 : 0;
+   }
+   return relaxed ? MTL4TimestampGranularityRelaxed
+                  : MTL4TimestampGranularityPrecise;
+}
+
 void
 mtl_compute_write_timestamp(mtl_compute_encoder *encoder,
                             mtl_counter_heap *heap, uint32_t index)
@@ -514,7 +553,7 @@ mtl_compute_write_timestamp(mtl_compute_encoder *encoder,
       id<MTL4ComputeCommandEncoder> enc =
          (id<MTL4ComputeCommandEncoder>)encoder;
       id<MTL4CounterHeap> h = (id<MTL4CounterHeap>)heap;
-      [enc writeTimestampWithGranularity:MTL4TimestampGranularityRelaxed
+      [enc writeTimestampWithGranularity:nps5_ts_granularity()
                                 intoHeap:h
                                  atIndex:index];
    }
@@ -528,7 +567,7 @@ mtl_render_write_timestamp(mtl_render_encoder *encoder,
    @autoreleasepool {
       id<MTL4RenderCommandEncoder> enc = (id<MTL4RenderCommandEncoder>)encoder;
       id<MTL4CounterHeap> h = (id<MTL4CounterHeap>)heap;
-      [enc writeTimestampWithGranularity:MTL4TimestampGranularityRelaxed
+      [enc writeTimestampWithGranularity:nps5_ts_granularity()
                               afterStage:(MTLRenderStages)stage
                                 intoHeap:h
                                  atIndex:index];

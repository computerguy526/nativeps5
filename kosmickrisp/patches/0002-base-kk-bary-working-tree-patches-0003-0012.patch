@@ -3354,6 +3354,18 @@ intrinsic("load_sampler_handle_kk", [1], 1, [],
 image("fence_kk")
 # Store clip distance to vertex output.
 store("clip_distance_kk", [], [BASE])
+
+# KosmicKrisp mesh shaders (Metal mesh functions). The lowering stages every
+# mesh output in workgroup memory and emits an epilogue that fills a
+# thread-local vertex / primitive struct with store_per_vertex_output /
+# store_per_primitive_output and then commits it:
+# src[0] = primitive count (mesh.set_primitive_count)
+intrinsic("mesh_set_primitive_count_kk", src_comp=[1])
+# src[0] = vertex index (mesh.set_vertex)
+intrinsic("mesh_commit_vertex_kk", src_comp=[1])
+# src[0] = primitive index, src[1] = its vertex indices (mesh.set_index per
+# vertex, then mesh.set_primitive)
+intrinsic("mesh_commit_primitive_kk", src_comp=[1, 0])
 # System value indicating whether to emulate depth clamp.
 system_value("is_depth_clamp_emulated_kk", 1, bit_sizes=[1])
 # System value indicating whether to emulate the viewport Z transform.

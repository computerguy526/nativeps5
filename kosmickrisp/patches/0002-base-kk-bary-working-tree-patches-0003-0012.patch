+
+/* Source text of a stage: the live string or a temporary decompressed copy
+ * returned in *tmp (free with free()). NULL on failure. */
+static const char *
+kk_msl_text(const struct msl_compile_data *d, const struct kk_msl_z *z,
+            char **tmp)
+{
+   *tmp = NULL;
+   if (d->code)
+      return d->code;
+   if (!z->data)
+      return NULL;
+   char *out = malloc(z->raw_len);
+   if (!out)
+      return NULL;
+   size_t n = compression_decode_buffer((uint8_t *)out, z->raw_len, z->data,
+                                        z->len, NULL, COMPRESSION_LZFSE);
+   if (n != z->raw_len) {

+      /* Unbinding the vertex stage must not drop a mesh shader bound in the
+       * same call sequence */
+      if (cmd->state.shaders[MESA_SHADER_MESH] == NULL ||
+          cmd->state.shaders[MESA_SHADER_VERTEX] !=
+             cmd->state.shaders[MESA_SHADER_MESH])
+         cmd->state.shaders[MESA_SHADER_VERTEX] = NULL;
+      return;
+   }
+
    cmd->state.shaders[stage] = shader;
    cmd->state.dirty_shaders |= BITFIELD_BIT(stage);
 

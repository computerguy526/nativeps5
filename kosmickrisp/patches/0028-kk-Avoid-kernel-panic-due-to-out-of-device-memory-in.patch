 src/kosmickrisp/vulkan/kk_bo.c              | 16 +++++++++++++++-
 src/kosmickrisp/vulkan/kk_physical_device.c |  1 +
 3 files changed, 33 insertions(+), 1 deletion(-)

diff --git a/docs/drivers/kosmickrisp/workarounds.rst b/docs/drivers/kosmickrisp/workarounds.rst
index 343dd62..c92e12c 100644
--- a/docs/drivers/kosmickrisp/workarounds.rst
+++ b/docs/drivers/kosmickrisp/workarounds.rst
@@ -49,6 +49,23 @@ info on what was updated.
 Workarounds
 ===========
 
+KK_WORKAROUND_20
+----------------
+| macOS version: 26
+| Metal ticket: Unreported
+| Metal ticket status: Fixed in macOS 27
+| CTS test failure:
+| Comments:
+
+Allocating more than ``recommendedMaxWorkingSetSize`` and making it resident
+runs into a kernel panic on macOS 26. Guard against allocations that go over
+the limit allowing only 95% usage. If multiple processes allocate below the
+limit, applications may still run into the kernel panic, but that is outside
+of our scope to fix.
+
+| Log:
+| 2026-11-16: Workaround implemented
+
 KK_WORKAROUND_19
 ----------------
 | macOS version: 26 and 27
diff --git a/src/kosmickrisp/vulkan/kk_bo.c b/src/kosmickrisp/vulkan/kk_bo.c
index 93805ef..0ef2638 100644
--- a/src/kosmickrisp/vulkan/kk_bo.c
+++ b/src/kosmickrisp/vulkan/kk_bo.c
@@ -93,6 +93,7 @@ kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
             enum kk_mem_cat cat)
 {
    VkResult result = VK_SUCCESS;
+   struct kk_physical_device *pdev = kk_device_physical(dev);
 
    // TODO_KOSMICKRISP: Probably requires handling the buffer maximum 256MB
    uint64_t minimum_alignment = 0u;
@@ -102,13 +103,26 @@ kk_alloc_bo(struct kk_device *dev, struct vk_object_base *log_obj,
 
 #if DETECT_ARCH_X86_64
    /* KK_WORKAROUND_8 */
-   struct kk_physical_device *pdev = kk_device_physical(dev);
    if (!(pdev->settings.disabled_workarounds & BITFIELD64_BIT(8))) {
       minimum_alignment = MAX2(minimum_alignment, 16384);
    }
 #endif
 
    size_B = align64(size_B, minimum_alignment);
+
+   /* KK_WORKAROUND_20 */
+   if (!(pdev->settings.disabled_workarounds & BITFIELD64_BIT(20))) {
+      uint64_t budget =
+         mtl_device_recommended_max_working_set_size(dev->mtl_handle);
+      uint64_t used = mtl_device_current_allocated_size(dev->mtl_handle);
+      /* Only allow 95% */
+      uint64_t limit = (budget / 100) * 95;
+      if (size_B > limit - used)
+         return vk_errorf(
+            log_obj, VK_ERROR_OUT_OF_DEVICE_MEMORY,
+            "Allocation could potentially trigger a known kernel panic");
+   }
+
    mtl_heap *handle =
       mtl_new_heap(dev->mtl_handle, size_B, KK_MTL_RESOURCE_OPTIONS);
    if (handle == NULL) {

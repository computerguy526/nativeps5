@@ -154,8 +157,19 @@ kk_CmdDispatchIndirect2KHR(VkCommandBuffer commandBuffer,
       mtl_dispatch_threadgroups_with_indirect_buffer(encoder, patched.gpu,
                                                      local_size);
    } else {
+      uint64_t addr = pInfo->addressRange.address;
+      uint32_t limit = kk_safe_dispatch_limit();
+      if (limit) {

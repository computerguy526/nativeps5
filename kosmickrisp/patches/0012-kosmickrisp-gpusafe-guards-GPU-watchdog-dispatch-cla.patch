diff --git a/src/kosmickrisp/libkk/kk_draws.cl b/src/kosmickrisp/libkk/kk_draws.cl
index 15ac3a5..0cbf5d2 100644
--- a/src/kosmickrisp/libkk/kk_draws.cl
+++ b/src/kosmickrisp/libkk/kk_draws.cl
@@ -71,6 +71,25 @@ libkk_predicate_indirect_neq_zero(global uint32_t *out, constant uint32_t *in,
    libkk_predicate_draw(out, in, out_stride_el, in_stride_el, draw_id, enabled);
 }
 
+/*
+ * nps5 gpusafe: GPU-written dispatch counts above `limit` threadgroups dispatch nothing (garbage
+ * counts = billions of threadgroups = GPU hang). `counter` counts suppressed dispatches (host logs once).
+ */
+KERNEL(1)
+libkk_clamp_indirect_dispatch(global uint32_t *out, constant uint32_t *in,
+                              global uint32_t *counter, uint32_t limit)
+{
+   uint64_t x = in[0], y = in[1], z = in[2];
+   uint64_t xy = x * y;
+   bool bad = (x != 0 && y != 0 && z != 0) &&
+              (xy > (uint64_t)limit || xy * z > (uint64_t)limit);
+   out[0] = bad ? 0 : in[0];
+   out[1] = bad ? 0 : in[1];
+   out[2] = bad ? 0 : in[2];
+   if (bad)
+      atomic_fetch_add((volatile global atomic_uint *)counter, 1u);
+}
+
 KERNEL(1024)
 libkk_unroll_geometry(
    uint64_t index_buffer, global struct poly_heap *heap,

+/* nps5 gpusafe: outermost commit-callback wrapper (watchdog ring + queue error guards). */
+struct kk_safe_wrap {
+   mtl_feedback_handler_callback cb;
+   void *data;
+   struct kk_safe_token *tk;
+};
+static void
+kk_safe_callback(struct mtl_feedback_data *data)
+{
+   struct kk_safe_wrap *w = data->user_data;
+   kk_safe_commit_done(w->tk, data);
+   data->user_data = w->data;
+   mtl_feedback_handler_callback cb = w->cb;
+   free(w->tk);
+   free(w);
+   cb(data);
+}
+
 static void
 commit_callback(struct mtl_feedback_data *data)
 {
@@ -271,6 +301,21 @@ kk_queue_commit(struct kk_queue *queue, struct kk_cmd_buffer *cmd,
       callback = kk_prof_callback;
       user_data = w;
    }
+   {
+      struct kk_safe_token *tk = kk_safe_commit_begin(queue, cmd);
+      if (tk) {
+         struct kk_safe_wrap *sw = malloc(sizeof(*sw));
+         if (sw) {
+            sw->cb = callback;
+            sw->data = user_data;
+            sw->tk = tk;
+            callback = kk_safe_callback;
+            user_data = sw;
+         } else {
+            free(tk);
+         }
+      }
+   }
    mtl_commit_options_add_feedback_handler(options, callback, user_data);
 

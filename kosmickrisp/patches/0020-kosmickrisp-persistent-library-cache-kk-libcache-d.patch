-   unsigned char d[CC_SHA256_DIGEST_LENGTH];
-   char opt[64];
-   CC_SHA256_Init(&c);
-   CC_SHA256_Update(&c, kk_stamp, (CC_LONG)strlen(kk_stamp));
-   const char *gpu = [[comp device].name UTF8String];
-   CC_SHA256_Update(&c, gpu, (CC_LONG)strlen(gpu));
-   snprintf(opt, sizeof(opt), ";msl=%x;math=%d;fp=%d;", msl_version, math_mode, math_fp_fns);
-   CC_SHA256_Update(&c, opt, (CC_LONG)strlen(opt));
-   CC_SHA256_Update(&c, src, (CC_LONG)strlen(src));
-   CC_SHA256_Final(d, &c);
-   for (int i = 0; i < 16; i++)
-      snprintf(out + i * 2, 3, "%02x", d[i]);
+   kk_libkey_compute(kk_stamp, [[comp device].name UTF8String], src, msl_version, math_mode, math_fp_fns, out);
 }
 
 static void
@@ -618,6 +632,15 @@ kk_collect_msl(const char *key, const char *src, int msl_version, int math_mode,
    struct stat st;
    if (stat(path, &st) == 0)
       return;
+   {
+      char par[1100];
+      snprintf(par, sizeof(par), "%s", kk_collect_dir);

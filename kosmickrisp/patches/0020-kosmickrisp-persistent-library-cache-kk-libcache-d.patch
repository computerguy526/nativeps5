 }
 
+/* In-process library cache: the same (MSL, options) text is built again for
+ * every pipeline state that shares a shader (43% of live compiles in a level
+ * repeat a text already built in the process, and the OS Metal cache does not
+ * serve them). KK_LIB_DEDUPE=0 disables. Libraries are immutable; every caller
+ * gets its own retain and releases it as before. */
+#define KK_LIBMEM_CAP 8192
+struct kk_libmem_ent {
+   char key[33];
+   id<MTLLibrary> lib;
+};
+static struct kk_libmem_ent *kk_libmem;
+static uint32_t kk_libmem_n;
+static pthread_mutex_t kk_libmem_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static id<MTLLibrary>
+kk_libmem_get(const char key[33])
+{
+   id<MTLLibrary> r = nil;
+   pthread_mutex_lock(&kk_libmem_lock);
+   for (uint32_t i = 0; i < kk_libmem_n; i++) {
+      if (memcmp(kk_libmem[i].key, key, 33) == 0) {
+         r = [kk_libmem[i].lib retain];
+         kk_st_dedupe++;
+         break;
+      }
+   }
+   pthread_mutex_unlock(&kk_libmem_lock);
+   return r;
+}
+
+static void
+kk_libmem_put(const char key[33], id<MTLLibrary> lib)
+{
+   pthread_mutex_lock(&kk_libmem_lock);
+   if (!kk_libmem)
+      kk_libmem = calloc(KK_LIBMEM_CAP, sizeof(*kk_libmem));
+   if (kk_libmem && kk_libmem_n < KK_LIBMEM_CAP) {
+      memcpy(kk_libmem[kk_libmem_n].key, key, 33);
+      kk_libmem[kk_libmem_n].lib = [lib retain];
+      kk_libmem_n++;
+   }
+   pthread_mutex_unlock(&kk_libmem_lock);
+}
+
 /* Library */
 mtl_library *
 mtl_new_library(mtl_compiler *compiler, const char *src,
@@ -684,9 +751,26 @@ mtl_new_library(mtl_compiler *compiler, const char *src,
          if (kk_math_mode_override >= 0)
             math_mode = (enum mtl_math_mode)kk_math_mode_override;
       }
-      if (kk_metallib_dir || kk_collect_dir) {
-         char key[33];
+      static int kk_dedupe = -1;
+      if (kk_dedupe < 0) {
+         const char *dd = getenv("KK_LIB_DEDUPE");
+         kk_dedupe = !(dd && dd[0] == '0');
+      }
+      char key[33];
+      bool have_key = false;
+      if (kk_dedupe || kk_metallib_dir || kk_collect_dir) {
          kk_metallib_key(comp, src, (int)msl_version, (int)math_mode, (int)math_fp_fns, key);
+         have_key = true;
+      }
+      if (kk_dedupe) {
+         id<MTLLibrary> memlib = kk_libmem_get(key);
+         if (memlib) {
+            if (kk_metallib_debug)
+               fprintf(stderr, "[kk-metallib] dedupe %s (hits %u)\n", key, (unsigned)kk_st_dedupe);
+            return memlib;
+         }
+      }
+      if (kk_metallib_dir || kk_collect_dir) {
          if (kk_metallib_dir) {
             char path[1024];
             snprintf(path, sizeof(path), "%s/%s.metallib", kk_metallib_dir, key);
@@ -697,9 +781,12 @@ mtl_new_library(mtl_compiler *compiler, const char *src,
                                                                     error:&lerr];
                if (prebuilt) {
                   kk_ml_hits++;
+                  kk_st_mlhit++;
                   if (kk_metallib_debug)
                      fprintf(stderr, "[kk-metallib] hit %s %.2f ms (%zu B msl, hits %u misses %u)\n", key,
                              kk_now_ms() - t0, strlen(src), kk_ml_hits, kk_ml_misses);
+                  if (kk_dedupe)
+                     kk_libmem_put(key, prebuilt);
                   return prebuilt;
                }
                fprintf(stderr, "[kk-metallib] rejected %s: %s\n", path, [lerr.localizedDescription UTF8String]);
@@ -735,6 +822,8 @@ mtl_new_library(mtl_compiler *compiler, const char *src,
 
       if (lib == nil) {
          fprintf(stderr, "Failed to create MTLLibrary: %s\n", [error.localizedDescription UTF8String]);
+      } else if (kk_dedupe && have_key && !(bust && bust[0])) {
+         kk_libmem_put(key, lib);
       }
 
       return lib;

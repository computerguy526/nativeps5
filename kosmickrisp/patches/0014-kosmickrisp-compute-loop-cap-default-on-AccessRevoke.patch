+/* KK_LOOP_CAP: loop-condition checks per compute kernel invocation. Unset =
+ * KK_LOOP_CAP_DEFAULT (2^18), 0 = off, n = that budget (at most 2^31). */
+uint32_t
+kk_msl_loop_cap_parse(const char *e)
+{
+   if (!e || !e[0])
+      return KK_LOOP_CAP_DEFAULT;
+   char *end;
+   unsigned long long v = strtoull(e, &end, 0);
+   if (end == e)
+      return KK_LOOP_CAP_DEFAULT;
+   if (v > (1ull << 31))
+      v = 1ull << 31;
+   /* A budget of 1 would let no loop run at all: the smallest is 2. */
+   if (v == 1)
+      v = 2;
+   return (uint32_t)v;
+}

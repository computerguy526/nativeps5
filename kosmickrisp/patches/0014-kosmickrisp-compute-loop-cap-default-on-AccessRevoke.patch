+++ b/src/kosmickrisp/compiler/msl_loop_cap.h
@@ -0,0 +1,65 @@
+/*
+ * nps5 loopcap: compute loop containment for KosmicKrisp's NIR -> MSL path.
+ *
+ * Port of the design of NXNative commit bb574c7 "chain/compute: contain runaway
+ * loops and report capped kernels" (https://github.com/seedds/nxnative, MIT,
+ * Copyright (c) 2026 seedds; co-authored by FifteenPen, computerguy526 and
+ * uncraftablexd, PRs #2254 and #2709). Their rewrite works on SPIRV-Cross MSL
+ * text (dm/gfx/tools/dmsh_rewrite.py compute_loops); this one works on NIR.
+ *
+ * Why: on macOS committed GPU work keeps running after the process exits
+ * (NXNative issue #2664), so a watchdog that exits the process does not stop a
+ * runaway shader loop. A loop that ends by itself does.
+ *
+ * - Compute kernels only. A budget of `cap` loop-condition checks per kernel
+ *   invocation, shared by all its loops (nested and consecutive).
+ * - The first thread that exhausts its budget stores 1 to a GPU-side abort
+ *   word of the submission and records its loop site (atomic min) in the
+ *   kernel's hit word. Other loops poll the abort word every
+ *   KK_LOOP_ABORT_EVERY checks.
+ * - A loop that contains an execution barrier (directly, in a nested block or
+ *   loop, or through a callee) gets a private counter that starts at zero at
+ *   every loop entry and never reads the abort word: threads of a workgroup
+ *   must not leave a barrier loop on different iterations.
+ *
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef MSL_LOOP_CAP_H
+#define MSL_LOOP_CAP_H 1
+
+#include "nir.h"
+
+#define KK_LOOP_CAP_DEFAULT  (1u << 18)
+#define KK_LOOP_ABORT_EVERY  1024u
+/* Argument table slot of the kernel's loop state (root 0, samplers 1, per draw 2). */
+#define KK_LOOP_STATE_SLOT   3u
+/* Loop state layout: u64 GPU address of the submission's abort word, then the
+ * kernel's hit word (atomic u32, UINT32_MAX = no cap hit), 4 bytes padding. */
+#define KK_LOOP_STATE_BYTES  16u
+#define KK_LOOP_STATE_HIT    8u
+
+struct msl_loop_site {
+   const nir_loop *loop;
+   uint32_t site;  /* 1-based, pre-order = order of appearance in the MSL */
+   bool barrier;   /* contains an execution barrier: private budget, no abort poll */
+};
+
+struct msl_loop_sites {
+   struct msl_loop_site *sites; /* ralloc'd, by site - 1 */
+   unsigned count;
+   unsigned barrier_count;
+   struct hash_table *by_loop;  /* nir_loop * -> struct msl_loop_site * */
+};
+
+/* Numbers the loops of `impl` and marks the ones containing an execution
+ * barrier. Everything is allocated from mem_ctx. */
+void msl_loop_cap_analyze(nir_function_impl *impl, void *mem_ctx,
+                          struct msl_loop_sites *out);
+
+const struct msl_loop_site *
+msl_loop_cap_find(const struct msl_loop_sites *sites, const nir_loop *loop);
+
+/* The MSL helpers (struct kk_loop_state, kk_lg_cap, kk_lg_go) for a budget. */
+char *msl_loop_cap_helpers(void *mem_ctx, uint32_t cap);
+
+#endif

diff --git a/src/kosmickrisp/compiler/tests/loopcap_nir_test.c b/src/kosmickrisp/compiler/tests/loopcap_nir_test.c
new file mode 100644
index 0000000..e85ff13
--- /dev/null
+++ b/src/kosmickrisp/compiler/tests/loopcap_nir_test.c
@@ -0,0 +1,552 @@
+/*
+ * nps5 loopcap: GPU-free unit test of the compute loop cap (msl_loop_cap.c and
+ * its emission in nir_to_msl.c). Builds NIR with nir_builder; nothing touches
+ * Metal. With an argument it also writes the MSL helpers for a budget to that
+ * file (work/s3/kk-safe/test compiles them as C++ against a model).
+ * SPDX-License-Identifier: MIT
+ */
+#include "nir.h"
+#include "nir_builder.h"
+#include "kosmickrisp/compiler/msl_loop_cap.h"
+#include "kosmickrisp/compiler/nir_to_msl.h"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+static int checks, failed;
+#define CHECK(c, label)                                                        \
+   do {                                                                        \
+      checks++;                                                                \
+      if (!(c)) {                                                              \
+         failed++;                                                             \
+         fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, label);       \
+      }                                                                        \
+   } while (0)
+
+enum body {
+   BODY_PLAIN,       /* a device store */
+   BODY_BARRIER,     /* workgroup execution barrier */
+   BODY_SUBGROUP,    /* subgroup execution barrier */
+   BODY_MEMBARRIER,  /* memory barrier only (SCOPE_NONE) */
+};
+
+static void
+emit_body(nir_builder *b, enum body body)
+{
+   switch (body) {
+   case BODY_PLAIN:
+      nir_store_global(b, nir_imm_int(b, 7), nir_imm_int64(b, 0x10000),
+                       .align_mul = 4, .write_mask = 1);
+      break;
+   case BODY_BARRIER:
+      nir_barrier(b, .execution_scope = SCOPE_WORKGROUP,
+                  .memory_scope = SCOPE_WORKGROUP,
+                  .memory_modes = nir_var_mem_shared);
+      break;
+   case BODY_SUBGROUP:
+      nir_barrier(b, .execution_scope = SCOPE_SUBGROUP,
+                  .memory_scope = SCOPE_SUBGROUP,
+                  .memory_modes = nir_var_mem_shared);
+      break;
+   case BODY_MEMBARRIER:
+      nir_barrier(b, .execution_scope = SCOPE_NONE,
+                  .memory_scope = SCOPE_DEVICE,
+                  .memory_modes = nir_var_mem_global);
+      break;
+   }
+}
+
+/* for (i = 0; i < bound; i++) { ... }, the bound read from device memory so no
+ * pass can fold the loop. The caller fills the body between begin and end. */
+struct loop {
+   nir_variable *i;
+   nir_def *v;
+};
+static struct loop
+loop_begin(nir_builder *b, unsigned bound_slot)
+{
+   struct loop l;
+   l.i = nir_local_variable_create(b->impl, glsl_uint_type(), "i");
+   nir_store_var(b, l.i, nir_imm_int(b, 0), 1);
+   nir_push_loop(b);
+   l.v = nir_load_var(b, l.i);
+   nir_def *bound = nir_load_global(
+      b, 1, 32, nir_imm_int64(b, 0x20000 + 4 * bound_slot), .align_mul = 4);
+   nir_push_if(b, nir_uge(b, l.v, bound));
+   nir_jump(b, nir_jump_break);
+   nir_pop_if(b, NULL);
+   return l;
+}
+static void
+loop_end(nir_builder *b, struct loop l)
+{
+   nir_store_var(b, l.i, nir_iadd_imm(b, l.v, 1), 1);
+   nir_pop_loop(b, NULL);
+}
+static void
+simple_loop(nir_builder *b, enum body body, unsigned slot)
+{
+   struct loop l = loop_begin(b, slot);
+   emit_body(b, body);
+   loop_end(b, l);
+}
+
+static nir_builder
+new_shader(mesa_shader_stage stage)
+{
+   nir_builder b =
+      nir_builder_init_simple_shader(stage, &kk_nir_options, "loopcap_test");
+   if (stage == MESA_SHADER_COMPUTE) {
+      b.shader->info.workgroup_size[0] = 32;
+      b.shader->info.workgroup_size[1] = 1;
+      b.shader->info.workgroup_size[2] = 1;
+   }
+   return b;
+}
+
+static nir_function *
+new_helper(nir_builder *b, const char *name, nir_builder *hb)
+{
+   nir_function *fn = nir_function_create(b->shader, name);
+   nir_function_impl *impl = nir_function_impl_create(fn);
+   *hb = nir_builder_at(nir_before_impl(impl));
+   return fn;
+}
+
+static void
+analyze(nir_builder *b, struct msl_loop_sites *s)
+{
+   msl_loop_cap_analyze(b->impl, b->shader, s);
+}
+
+/* ---- analysis: numbering ---- */
+static void
+test_numbering(void)
+{
+   nir_builder b = new_shader(MESA_SHADER_COMPUTE);
+   struct msl_loop_sites s;
+   analyze(&b, &s);
+   CHECK(s.count == 0 && s.barrier_count == 0, "no loops: no sites");
+   CHECK(msl_loop_cap_find(&s, NULL) == NULL, "find on an empty table");
+
+   /* loop 1 { loop 2 { } loop 3 { loop 4 } } loop 5 */
+   struct loop l1 = loop_begin(&b, 0);
+   simple_loop(&b, BODY_PLAIN, 1);
+   struct loop l3 = loop_begin(&b, 2);
+   simple_loop(&b, BODY_PLAIN, 3);
+   loop_end(&b, l3);
+   loop_end(&b, l1);
+   simple_loop(&b, BODY_PLAIN, 4);
+   analyze(&b, &s);
+   CHECK(s.count == 5 && s.barrier_count == 0, "five loops, none with a barrier");
+   bool ordered = true, found = true;
+   for (unsigned i = 0; i < s.count; i++) {
+      ordered &= s.sites[i].site == i + 1 && !s.sites[i].barrier;
+      const struct msl_loop_site *f = msl_loop_cap_find(&s, s.sites[i].loop);
+      found &= f && f->site == i + 1;
+   }
+   CHECK(ordered, "sites are 1..n in order");
+   CHECK(found, "every loop is found by pointer");
+   /* pre-order: site 1 is the outermost first loop, 2 and 3 are its children,
+    * 4 is inside 3, 5 follows 1 */
+   const nir_loop *p2 = nir_cf_node_as_loop(s.sites[1].loop->cf_node.parent);
+   const nir_loop *p3 = nir_cf_node_as_loop(s.sites[2].loop->cf_node.parent);
+   const nir_loop *p4 = nir_cf_node_as_loop(s.sites[3].loop->cf_node.parent);
+   CHECK(p2 == s.sites[0].loop && p3 == s.sites[0].loop && p4 == s.sites[2].loop,
+         "numbering is pre-order (the order of the MSL text)");
+   CHECK(s.sites[0].loop->cf_node.parent->type == nir_cf_node_function &&
+         s.sites[4].loop->cf_node.parent->type == nir_cf_node_function,
+         "sites 1 and 5 are top level");
+   ralloc_free(b.shader);
+
+   /* many loops: 3000 in a row and a nest 40 deep */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   for (unsigned i = 0; i < 3000; i++)
+      simple_loop(&b, BODY_PLAIN, i & 15);
+   struct loop nest[40];
+   for (unsigned i = 0; i < 40; i++)
+      nest[i] = loop_begin(&b, i & 15);
+   emit_body(&b, BODY_BARRIER);
+   for (unsigned i = 40; i-- > 0;)
+      loop_end(&b, nest[i]);
+   analyze(&b, &s);
+   CHECK(s.count == 3040, "3040 loops numbered");
+   CHECK(s.barrier_count == 40, "the whole nest around a barrier is marked");
+   bool row_ok = true, nest_ok = true;
+   for (unsigned i = 0; i < 3000; i++)
+      row_ok &= !s.sites[i].barrier && s.sites[i].site == i + 1;
+   for (unsigned i = 3000; i < 3040; i++)
+      nest_ok &= s.sites[i].barrier && s.sites[i].site == i + 1;
+   CHECK(row_ok, "3000 plain loops stay plain");
+   CHECK(nest_ok, "40 nested loops: barrier propagates to every enclosing loop");
+   ralloc_free(b.shader);
+}
+
+/* ---- analysis: barriers ---- */
+static void
+test_barriers(void)
+{
+   struct msl_loop_sites s;
+
+   /* barrier outside any loop; memory barrier inside one; subgroup barrier */
+   nir_builder b = new_shader(MESA_SHADER_COMPUTE);
+   emit_body(&b, BODY_BARRIER);
+   simple_loop(&b, BODY_PLAIN, 0);      /* 1 */
+   simple_loop(&b, BODY_MEMBARRIER, 1); /* 2 */
+   simple_loop(&b, BODY_SUBGROUP, 2);   /* 3 */
+   simple_loop(&b, BODY_BARRIER, 3);    /* 4 */
+   emit_body(&b, BODY_BARRIER);
+   analyze(&b, &s);
+   CHECK(s.count == 4, "four loops");
+   CHECK(!s.sites[0].barrier, "a barrier outside the loop does not mark it");
+   CHECK(!s.sites[1].barrier, "a memory-only barrier (atomic_thread_fence) is not an execution barrier");
+   CHECK(s.sites[2].barrier, "a subgroup barrier marks its loop");
+   CHECK(s.sites[3].barrier, "a workgroup barrier marks its loop");
+   CHECK(s.barrier_count == 2, "barrier count");
+   ralloc_free(b.shader);
+
+   /* barrier in a nested if / else, and in an inner loop */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   struct loop l1 = loop_begin(&b, 0); /* 1: barrier in else of a nested if */
+   nir_push_if(&b, nir_ieq_imm(&b, l1.v, 3));
+   emit_body(&b, BODY_PLAIN);
+   nir_push_else(&b, NULL);
+   nir_push_if(&b, nir_ieq_imm(&b, l1.v, 5));
+   emit_body(&b, BODY_BARRIER);
+   nir_pop_if(&b, NULL);
+   nir_pop_if(&b, NULL);
+   loop_end(&b, l1);
+   struct loop l2 = loop_begin(&b, 1); /* 2: outer of a barrier loop */
+   simple_loop(&b, BODY_PLAIN, 2);     /* 3: plain sibling inside 2 */
+   simple_loop(&b, BODY_BARRIER, 3);   /* 4: the barrier loop */
+   loop_end(&b, l2);
+   simple_loop(&b, BODY_PLAIN, 4);     /* 5 */
+   analyze(&b, &s);
+   CHECK(s.count == 5, "five loops");
+   CHECK(s.sites[0].barrier, "barrier inside a nested else/if marks the loop");
+   CHECK(s.sites[1].barrier, "outer loop of a barrier loop is marked");
+   CHECK(!s.sites[2].barrier, "plain inner sibling is not marked");
+   CHECK(s.sites[3].barrier, "inner barrier loop is marked");
+   CHECK(!s.sites[4].barrier, "a loop after a barrier loop is not marked");
+   ralloc_free(b.shader);
+}
+
+/* ---- analysis: barriers through callees ---- */
+static void
+test_callees(void)
+{
+   struct msl_loop_sites s;
+   nir_builder b = new_shader(MESA_SHADER_COMPUTE);
+   nir_builder hb;
+
+   /* arrive(): a barrier. wrapper(): calls arrive (in an if). plain(): a store
+    * and a loop of its own. chain(): calls plain. */
+   nir_function *arrive = new_helper(&b, "arrive", &hb);
+   emit_body(&hb, BODY_BARRIER);
+   nir_function *wrapper = new_helper(&b, "wrapper", &hb);
+   nir_push_if(&hb, nir_imm_true(&hb));
+   nir_call(&hb, arrive);
+   nir_pop_if(&hb, NULL);
+   nir_function *plain = new_helper(&b, "plain", &hb);
+   simple_loop(&hb, BODY_PLAIN, 0);
+   nir_function *chain = new_helper(&b, "chain", &hb);
+   nir_call(&hb, plain);
+   /* a declaration without a body */
+   nir_function *opaque = nir_function_create(b.shader, "opaque");
+
+   struct loop l;
+   l = loop_begin(&b, 0); /* 1: calls arrive directly */
+   nir_call(&b, arrive);
+   loop_end(&b, l);
+   l = loop_begin(&b, 1); /* 2: calls wrapper -> arrive */
+   nir_call(&b, wrapper);
+   loop_end(&b, l);
+   l = loop_begin(&b, 2); /* 3: calls chain -> plain (no barrier) */
+   nir_call(&b, chain);
+   loop_end(&b, l);
+   l = loop_begin(&b, 3); /* 4: outer */
+   {
+      struct loop in = loop_begin(&b, 4); /* 5: inner calls wrapper in an if */
+      nir_push_if(&b, nir_ieq_imm(&b, in.v, 1));
+      nir_call(&b, wrapper);
+      nir_pop_if(&b, NULL);
+      loop_end(&b, in);
+   }
+   loop_end(&b, l);
+   l = loop_begin(&b, 5); /* 6: calls a function without a body */
+   nir_call(&b, opaque);
+   loop_end(&b, l);
+   nir_call(&b, arrive);   /* a call outside loops */
+   simple_loop(&b, BODY_PLAIN, 6); /* 7 */
+
+   analyze(&b, &s);
+   CHECK(s.count == 7, "only the entry point's loops are numbered (not plain()'s)");
+   CHECK(s.sites[0].barrier, "barrier through a direct callee");
+   CHECK(s.sites[1].barrier, "barrier through a callee of a callee");
+   CHECK(!s.sites[2].barrier, "callees without a barrier do not mark the loop");
+   CHECK(s.sites[3].barrier && s.sites[4].barrier, "callee barrier in an inner loop marks inner and outer");
+   CHECK(s.sites[5].barrier, "an unknown callee is treated as a barrier (conservative)");
+   CHECK(!s.sites[6].barrier, "a barrier call outside the loop does not mark it");
+   CHECK(s.barrier_count == 5, "barrier count through callees");
+   /* same answer when analyzed again (memo table is per call) */
+   struct msl_loop_sites s2;
+   analyze(&b, &s2);
+   bool same = s2.count == s.count;
+   for (unsigned i = 0; same && i < s.count; i++)
+      same = s.sites[i].barrier == s2.sites[i].barrier;
+   CHECK(same, "analysis is repeatable");
+   ralloc_free(b.shader);
+}
+
+/* ---- emission ---- */
+static unsigned
+count(const char *text, const char *needle)
+{
+   unsigned n = 0;
+   for (const char *p = text; (p = strstr(p, needle)); p += strlen(needle))
+      n++;
+   return n;
+}
+
+static bool
+balanced(const char *text)
+{
+   int depth = 0, paren = 0;
+   for (const char *p = text; *p; p++) {
+      depth += (*p == '{') - (*p == '}');
+      paren += (*p == '(') - (*p == ')');
+      if (depth < 0 || paren < 0)
+         return false;
+   }
+   return depth == 0 && paren == 0;
+}
+
+static char *
+translate(nir_builder *b, uint32_t cap, uint64_t disabled, uint32_t *sites,
+          uint32_t *barrier_sites)
+{
+   nir_shader *nir = b->shader;
+   nir_validate_shader(nir, "loopcap test");
+   nir_shader_gather_info(nir, nir_shader_get_entrypoint(nir));
+   msl_optimize_nir(nir);
+   struct nir_to_msl_options opt = {
+      .mem_ctx = NULL,
+      .disabled_workarounds = disabled | BITFIELD64_BIT(19),
+      .msl_opt = KK_MSL_OPT_DEFAULT,
+      .loop_cap = cap,
+      .loop_sites = 12345,
+      .loop_barrier_sites = 12345,
+   };
+   char *msl = nir_to_msl(nir, &opt);
+   if (getenv("LOOPCAP_SHOW"))
+      printf("---- cap %u, workarounds off %llx ----\n%s\n", cap, (unsigned long long)disabled, msl);
+   if (sites)
+      *sites = opt.loop_sites;
+   if (barrier_sites)
+      *barrier_sites = opt.loop_barrier_sites;
+   return msl;
+}
+
+static void
+build_mixed(nir_builder *b)
+{
+   simple_loop(b, BODY_PLAIN, 0);        /* 1 */
+   struct loop l = loop_begin(b, 1);     /* 2: barrier (through 3) */
+   simple_loop(b, BODY_BARRIER, 2);      /* 3 */
+   simple_loop(b, BODY_PLAIN, 3);        /* 4 */
+   loop_end(b, l);
+}
+
+static void
+test_emission(void)
+{
+   uint32_t sites, bsites;
+
+   /* plain loop, budget 4096 */
+   nir_builder b = new_shader(MESA_SHADER_COMPUTE);
+   simple_loop(&b, BODY_PLAIN, 0);
+   char *msl = translate(&b, 4096, 0, &sites, &bsites);
+   CHECK(sites == 1 && bsites == 0, "one guarded loop reported");
+   CHECK(count(msl, "struct kk_loop_state") == 1, "helpers emitted once");
+   CHECK(strstr(msl, "device kk_loop_state &kk_loop [[buffer(3)]]") != NULL, "loop state argument at slot 3");
+   CHECK(count(msl, "uint kk_lg = 0u;") == 1, "shared counter declared once");
+   CHECK(strstr(msl, "&& kk_lg_go(kk_lg, kk_loop, 1u); ++no_crash) {") != NULL, "loop condition guarded with site 1");
+   CHECK(strstr(msl, "if (n >= 4096u) return false;") && strstr(msl, "if (++n < 4096u) return true;") &&
+         strstr(msl, "n = 4096u;"), "the budget is the one asked for");
+   CHECK(strstr(msl, "(n & 1023u) != 0u") != NULL, "abort polled every 1024 checks");
+   CHECK(count(msl, "atomic_load_explicit((device atomic_uint*)s.abort") == 1 &&
+         count(msl, "atomic_store_explicit((device atomic_uint*)s.abort, 1u") == 1 &&
+         count(msl, "atomic_fetch_min_explicit(&s.hit, site") == 1, "abort is read in kk_lg_go only and written with the hit");
+   CHECK(strstr(msl, "kk_lg_b") == NULL, "no private counter without a barrier loop");
+   CHECK(balanced(msl), "braces and parentheses balance");
+   CHECK(strstr(msl, "kernel void") != NULL, "it is a kernel");
+   ralloc_free(msl);
+
+   /* mixed: 1 plain, 2 barrier outer, 3 barrier inner, 4 plain inner */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   build_mixed(&b);
+   msl = translate(&b, KK_LOOP_CAP_DEFAULT, 0, &sites, &bsites);
+   CHECK(sites == 4 && bsites == 2, "four guarded loops, two with a barrier");
+   CHECK(strstr(msl, "kk_lg_go(kk_lg, kk_loop, 1u)") && strstr(msl, "kk_lg_go(kk_lg, kk_loop, 4u)"), "plain loops use the shared counter and poll");
+   CHECK(strstr(msl, "{ uint kk_lg_b2 = 0u;") && strstr(msl, "kk_lg_cap(kk_lg_b2, kk_loop, 2u)") &&
+         strstr(msl, "{ uint kk_lg_b3 = 0u;") && strstr(msl, "kk_lg_cap(kk_lg_b3, kk_loop, 3u)"),
+         "barrier loops get a private counter declared at the loop entry and never poll");
+   CHECK(!strstr(msl, "kk_lg_go(kk_lg, kk_loop, 2u)") && !strstr(msl, "kk_lg_go(kk_lg, kk_loop, 3u)") &&
+         !strstr(msl, "kk_lg_cap(kk_lg, "), "no barrier loop reads the abort word or the shared counter");
+   /* the inner private counter is declared inside the outer loop's body: fresh at every entry */
+   const char *outer = strstr(msl, "kk_lg_cap(kk_lg_b2, kk_loop, 2u)");
+   const char *inner_decl = strstr(msl, "{ uint kk_lg_b3 = 0u;");
+   const char *inner = strstr(msl, "kk_lg_cap(kk_lg_b3, kk_loop, 3u)");
+   CHECK(outer && inner_decl && inner && outer < inner_decl && inner_decl < inner, "inner private counter restarts at each entry of the inner loop");
+   CHECK(strstr(msl, "if (n >= 262144u) return false;") != NULL, "default budget 2^18");
+   CHECK(count(msl, "threadgroup_barrier(") == 1, "the barrier itself is unchanged");
+   CHECK(balanced(msl), "braces and parentheses balance (barrier blocks closed)");
+   ralloc_free(msl);
+
+   /* only barrier loops: no shared counter */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   simple_loop(&b, BODY_BARRIER, 0);
+   msl = translate(&b, 4096, 0, &sites, &bsites);
+   CHECK(sites == 1 && bsites == 1, "one barrier loop");
+   CHECK(!strstr(msl, "uint kk_lg = 0u;"), "no shared counter when every loop has a barrier");
+   CHECK(balanced(msl), "balanced");
+   ralloc_free(msl);
+
+   /* KK_WORKAROUND_2 disabled: while loops */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   build_mixed(&b);
+   msl = translate(&b, 4096, BITFIELD64_BIT(2), &sites, &bsites);
+   CHECK(strstr(msl, "while (kk_lg_go(kk_lg, kk_loop, 1u)) {") && strstr(msl, "while (kk_lg_cap(kk_lg_b2, kk_loop, 2u)) {"), "while form guarded too");
+   CHECK(!strstr(msl, "while (true)") && !strstr(msl, "no_crash"), "no unguarded loop is left");
+   CHECK(balanced(msl), "balanced");
+   ralloc_free(msl);
+
+   /* cap 0: the old MSL */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   build_mixed(&b);
+   msl = translate(&b, 0, 0, &sites, &bsites);
+   CHECK(sites == 0 && bsites == 0, "cap 0 reports no sites");
+   CHECK(!strstr(msl, "kk_l"), "cap 0: no trace of the guard");
+   CHECK(count(msl, "for (uint64_t no_crash = 0u; no_crash < 18446744073709551615; ++no_crash) {") == 4, "cap 0: the four loops are as before");
+   CHECK(!strstr(msl, "buffer(3)"), "cap 0: no extra argument");
+   char *off = msl;
+
+   /* the guard only adds text: removing it gives the cap-0 MSL byte for byte */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   build_mixed(&b);
+   msl = translate(&b, 4096, 0, NULL, NULL);
+   {
+      char *strip = strdup(msl), *w = strip;
+      const char *helpers = strstr(msl, "struct kk_loop_state");
+      const char *helpers_end = strstr(msl, "    n = 4096u;\n    return false;\n}\n");
+      const char *r = msl;
+      bool ok = helpers && helpers_end;
+      helpers_end = ok ? helpers_end + strlen("    n = 4096u;\n    return false;\n}\n") : NULL;
+      while (ok && *r) {
+         if (r == helpers) {
+            r = helpers_end;
+            continue;
+         }
+#define SKIP(lit)                                                              \
+   if (!strncmp(r, lit, strlen(lit))) {                                        \
+      r += strlen(lit);                                                        \
+      continue;                                                                \
+   }
+         SKIP(",\n    device kk_loop_state &kk_loop [[buffer(3)]]");
+         SKIP("    uint kk_lg = 0u;\n");
+         SKIP(" && kk_lg_go(kk_lg, kk_loop, 1u)");
+         SKIP(" && kk_lg_go(kk_lg, kk_loop, 4u)");
+         SKIP(" && kk_lg_cap(kk_lg_b2, kk_loop, 2u)");
+         SKIP(" && kk_lg_cap(kk_lg_b3, kk_loop, 3u)");
+         if (!strncmp(r, "{ uint kk_lg_b", 14)) {
+            /* the opening line of a barrier block and its indentation */
+            while (w > strip && w[-1] == ' ')
+               w--;
+            r = strchr(r, '\n') + 1;
+            continue;
+         }
+         *w++ = *r++;
+      }
+      *w = 0;
+      /* the two closing braces of the barrier blocks */
+      unsigned extra = count(strip, "}\n") - count(off, "}\n");
+      CHECK(ok && extra == 2, "exactly the two barrier blocks add a closing brace");
+      /* compare ignoring those two lines: drop every line that is only "}" from both */
+      char *a = strip, *c = off;
+      bool same = true;
+      while (same && (*a || *c)) {
+         while (*a == ' ' || *a == '}' || *a == '\n')
+            a++;
+         while (*c == ' ' || *c == '}' || *c == '\n')
+            c++;
+         same = *a == *c;
+         if (*a)
+            a++;
+         if (*c)
+            c++;
+      }
+      CHECK(same, "apart from the guard text the MSL equals the cap-0 MSL");
+      free(strip);
+   }
+   ralloc_free(msl);
+   ralloc_free(off);
+
+   /* compute without loops: unchanged, no argument */
+   b = new_shader(MESA_SHADER_COMPUTE);
+   emit_body(&b, BODY_PLAIN);
+   emit_body(&b, BODY_BARRIER);
+   msl = translate(&b, 4096, 0, &sites, &bsites);
+   CHECK(sites == 0 && !strstr(msl, "kk_l") && !strstr(msl, "buffer(3)"), "loop-free compute shader is unchanged");
+   ralloc_free(msl);
+
+   /* other stages: unchanged even with a budget */
+   b = new_shader(MESA_SHADER_FRAGMENT);
+   simple_loop(&b, BODY_PLAIN, 0);
+   msl = translate(&b, 4096, 0, &sites, &bsites);
+   CHECK(sites == 0 && !strstr(msl, "kk_l") && !strstr(msl, "buffer(3)") && strstr(msl, "no_crash < 18446744073709551615;"),
+         "fragment shader loops are not guarded");
+   ralloc_free(msl);
+}
+
+static void
+test_env(void)
+{
+   CHECK(kk_msl_loop_cap_parse(NULL) == 262144u, "unset: 2^18");
+   CHECK(kk_msl_loop_cap_parse("") == 262144u, "empty: 2^18");
+   CHECK(kk_msl_loop_cap_parse("junk") == 262144u, "not a number: 2^18");
+   CHECK(kk_msl_loop_cap_parse("0") == 0u, "0: off");
+   CHECK(kk_msl_loop_cap_parse("4096") == 4096u, "4096");
+   CHECK(kk_msl_loop_cap_parse("0x1000") == 4096u, "hex");
+   CHECK(kk_msl_loop_cap_parse("1") == 2u, "1 would run nothing: 2");
+   CHECK(kk_msl_loop_cap_parse("99999999999999") == (1u << 31), "clamped to 2^31");
+   CHECK(KK_LOOP_CAP_DEFAULT == (1u << 18) && KK_LOOP_ABORT_EVERY == 1024u && KK_LOOP_STATE_SLOT == 3u &&
+         KK_LOOP_STATE_BYTES == 16u && KK_LOOP_STATE_HIT == 8u, "ABI constants");
+}
+
+int
+main(int argc, char **argv)
+{
+   alarm(60);
+   glsl_type_singleton_init_or_ref();
+   if (argc > 2) {
+      /* <file> <cap>: write the MSL helpers for the model test */
+      char *h = msl_loop_cap_helpers(NULL, (uint32_t)strtoul(argv[2], NULL, 0));
+      FILE *f = fopen(argv[1], "w");
+      if (!f)
+         return 2;
+      fputs(h, f);
+      fclose(f);
+      ralloc_free(h);
+      return 0;
+   }
+   test_env();
+   test_numbering();
+   test_barriers();
+   test_callees();
+   test_emission();
+   glsl_type_singleton_decref();
+   printf("loopcap_nir_test: %d checks, %d failed\n", checks, failed);
+   return failed != 0;
+}

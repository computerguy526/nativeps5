diff --git a/src/kosmickrisp/compiler/msl_loop_cap.c b/src/kosmickrisp/compiler/msl_loop_cap.c
new file mode 100644
index 0000000..61946a9
--- /dev/null
+++ b/src/kosmickrisp/compiler/msl_loop_cap.c
@@ -0,0 +1,172 @@
+/*
+ * nps5 loopcap: loop numbering and barrier propagation for the compute loop
+ * cap. See msl_loop_cap.h (design: NXNative bb574c7, MIT, (c) 2026 seedds,
+ * co-authored by FifteenPen, computerguy526, uncraftablexd).
+ * SPDX-License-Identifier: MIT
+ */
+#include "msl_loop_cap.h"
+
+#include "util/hash_table.h"
+#include "util/ralloc.h"
+
+struct lc_state {
+   void *mem_ctx;
+   struct msl_loop_sites *out;
+   unsigned capacity;
+   /* nir_function_impl * -> (void *)1 no barrier, (void *)2 barrier,
+    * (void *)3 being visited */
+   struct hash_table *impls;
+};
+
+static bool lc_list_has_barrier(struct lc_state *st, struct exec_list *list);
+
+static bool
+lc_impl_has_barrier(struct lc_state *st, nir_function_impl *impl)
+{
+   /* A callee we cannot see may wait at a barrier. */
+   if (!impl)
+      return true;
+   struct hash_entry *e = _mesa_hash_table_search(st->impls, impl);
+   if (e) {
+      /* 3 = recursion (not valid in SPIR-V): the outer visit decides. */
+      return (uintptr_t)e->data == 2;
+   }
+   _mesa_hash_table_insert(st->impls, impl, (void *)(uintptr_t)3);
+   /* Loops of callees are not numbered: only the entry point's loops are
+    * printed (NIR is inlined before nir_to_msl). */
+   struct msl_loop_sites *saved = st->out;
+   st->out = NULL;
+   bool barrier = lc_list_has_barrier(st, &impl->body);
+   st->out = saved;
+   e = _mesa_hash_table_search(st->impls, impl);
+   e->data = (void *)(uintptr_t)(barrier ? 2 : 1);
+   return barrier;
+}
+
+static bool
+lc_instr_is_barrier(struct lc_state *st, nir_instr *instr)
+{
+   if (instr->type == nir_instr_type_intrinsic) {
+      nir_intrinsic_instr *intr = nir_instr_as_intrinsic(instr);
+      /* SCOPE_NONE is a memory barrier only (atomic_thread_fence). */
+      return intr->intrinsic == nir_intrinsic_barrier &&
+             nir_intrinsic_execution_scope(intr) != SCOPE_NONE;
+   }
+   if (instr->type == nir_instr_type_call)
+      return lc_impl_has_barrier(st, nir_instr_as_call(instr)->callee->impl);
+   return false;
+}
+
+static bool
+lc_node_has_barrier(struct lc_state *st, nir_cf_node *node)
+{
+   switch (node->type) {
+   case nir_cf_node_block: {
+      bool barrier = false;
+      nir_foreach_instr(instr, nir_cf_node_as_block(node))
+         barrier |= lc_instr_is_barrier(st, instr);
+      return barrier;
+   }
+   case nir_cf_node_if: {
+      nir_if *nif = nir_cf_node_as_if(node);
+      bool a = lc_list_has_barrier(st, &nif->then_list);
+      bool b = lc_list_has_barrier(st, &nif->else_list);
+      return a || b;
+   }
+   case nir_cf_node_loop: {
+      nir_loop *loop = nir_cf_node_as_loop(node);
+      unsigned idx = 0;
+      if (st->out) {
+         /* Number before the body: sites follow the order of the MSL text. */
+         if (st->out->count == st->capacity) {
+            st->capacity = st->capacity ? st->capacity * 2 : 16;
+            st->out->sites = reralloc(st->mem_ctx, st->out->sites,
+                                      struct msl_loop_site, st->capacity);
+         }
+         idx = st->out->count++;
+         st->out->sites[idx] = (struct msl_loop_site){
+            .loop = loop,
+            .site = idx + 1,
+         };
+      }
+      bool barrier = lc_list_has_barrier(st, &loop->body);
+      if (nir_loop_has_continue_construct(loop))
+         barrier |= lc_list_has_barrier(st, &loop->continue_list);
+      if (st->out) {
+         st->out->sites[idx].barrier = barrier;
+         st->out->barrier_count += barrier;
+      }
+      return barrier;
+   }
+   default:
+      return false;
+   }
+}
+
+static bool
+lc_list_has_barrier(struct lc_state *st, struct exec_list *list)
+{
+   bool barrier = false;
+   foreach_list_typed(nir_cf_node, node, node, list)
+      barrier |= lc_node_has_barrier(st, node);
+   return barrier;
+}
+
+void
+msl_loop_cap_analyze(nir_function_impl *impl, void *mem_ctx,
+                     struct msl_loop_sites *out)
+{
+   memset(out, 0, sizeof(*out));
+   struct lc_state st = {
+      .mem_ctx = mem_ctx,
+      .out = out,
+      .impls = _mesa_pointer_hash_table_create(mem_ctx),
+   };
+   _mesa_hash_table_insert(st.impls, impl, (void *)(uintptr_t)3);
+   lc_list_has_barrier(&st, &impl->body);
+
+   /* The array no longer moves: index it by loop. */
+   out->by_loop = _mesa_pointer_hash_table_create(mem_ctx);
+   for (unsigned i = 0; i < out->count; i++)
+      _mesa_hash_table_insert(out->by_loop, out->sites[i].loop, &out->sites[i]);
+}
+
+const struct msl_loop_site *
+msl_loop_cap_find(const struct msl_loop_sites *sites, const nir_loop *loop)
+{
+   if (!sites->by_loop)
+      return NULL;
+   struct hash_entry *e = _mesa_hash_table_search(sites->by_loop, loop);
+   return e ? e->data : NULL;
+}
+
+char *
+msl_loop_cap_helpers(void *mem_ctx, uint32_t cap)
+{
+   /* The counter saturates at the budget, so every later check of a capped
+    * (or aborted) invocation fails at once. Only reaching the own budget
+    * records a site; seeing another thread's abort does not. */
+   return ralloc_asprintf(
+      mem_ctx,
+      "struct kk_loop_state\n"
+      "{\n"
+      "    ulong abort;\n"
+      "    atomic_uint hit;\n"
+      "};\n"
+      "static inline __attribute__((always_inline)) bool kk_lg_cap(thread uint& n, device kk_loop_state& s, uint site)\n"
+      "{\n"
+      "    if (n >= %uu) return false;\n"
+      "    if (++n < %uu) return true;\n"
+      "    atomic_fetch_min_explicit(&s.hit, site, memory_order_relaxed);\n"
+      "    atomic_store_explicit((device atomic_uint*)s.abort, 1u, memory_order_relaxed);\n"
+      "    return false;\n"
+      "}\n"
+      "static inline __attribute__((always_inline)) bool kk_lg_go(thread uint& n, device kk_loop_state& s, uint site)\n"
+      "{\n"
+      "    if (!kk_lg_cap(n, s, site)) return false;\n"
+      "    if ((n & %uu) != 0u || atomic_load_explicit((device atomic_uint*)s.abort, memory_order_relaxed) == 0u) return true;\n"
+      "    n = %uu;\n"
+      "    return false;\n"
+      "}\n",
+      cap, cap, KK_LOOP_ABORT_EVERY - 1u, cap);
+}

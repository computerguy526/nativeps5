+/* ---- loopcap: kernels whose cap hit was already logged (once per kernel). Returns true the
+ * first time a key is seen. A full table reports nothing new (bounded log). */
+#define KK_SAFE_LOOP_KEYS 256
+struct kk_safe_keyset {
+   uint64_t key[KK_SAFE_LOOP_KEYS];
+   unsigned count;
+};
+static inline bool
+kk_safe_keyset_add(struct kk_safe_keyset *ks, uint64_t key)
+{
+   for (unsigned i = 0; i < ks->count; i++)
+      if (ks->key[i] == key)
+         return false;
+   if (ks->count == KK_SAFE_LOOP_KEYS)
+      return false;
+   ks->key[ks->count++] = key;
+   return true;
+}
+
+/* ---- OOM dump: live allocations of at least KK_SAFE_MEM_MIN bytes as (category, size) x count,
+ * so the largest ones can be listed without a per-object registry. */
+#define KK_SAFE_MEM_MIN   (1u << 20)
+#define KK_SAFE_MEM_ROWS  1024
+#define KK_SAFE_MEM_TOP   24
+struct kk_safe_memrow {
+   uint64_t size;
+   uint32_t cat, count;
+};
+struct kk_safe_memtab {
+   struct kk_safe_memrow row[KK_SAFE_MEM_ROWS];
+   unsigned used;       /* rows in use (count may be 0: reusable) */
+   uint64_t untracked;  /* allocations dropped because the table was full */
+};
+/* bytes > 0: allocation, < 0: free. Smaller than KK_SAFE_MEM_MIN: ignored. */
+static inline void
+kk_safe_memtab_note(struct kk_safe_memtab *t, uint32_t cat, int64_t bytes)
+{
+   uint64_t size = bytes < 0 ? (uint64_t)-bytes : (uint64_t)bytes;
+   if (size < KK_SAFE_MEM_MIN)
+      return;
+   int spare = -1;
+   for (unsigned i = 0; i < t->used; i++) {
+      struct kk_safe_memrow *r = &t->row[i];
+      if (r->count && r->size == size && r->cat == cat) {
+         if (bytes > 0)
+            r->count++;
+         else
+            r->count--;
+         return;
+      }
+      if (!r->count && spare < 0)
+         spare = (int)i;
+   }
+   if (bytes < 0)
+      return; /* a free of something allocated while the table was full */
+   if (spare < 0) {
+      if (t->used == KK_SAFE_MEM_ROWS) {
+         t->untracked++;
+         return;
+      }
+      spare = (int)t->used++;
+   }
+   t->row[spare] = (struct kk_safe_memrow){.size = size, .cat = cat, .count = 1};
+}
+/* The n largest live rows by size (ties: more bytes in total first, then lower category), largest
+ * first. Returns how many were written. */
+static inline unsigned
+kk_safe_memtab_top(const struct kk_safe_memtab *t, struct kk_safe_memrow *out, unsigned n)
+{
+   unsigned got = 0;
+   for (unsigned i = 0; i < t->used; i++) {
+      const struct kk_safe_memrow *r = &t->row[i];
+      if (!r->count)
+         continue;
+      unsigned at = got;
+      while (at > 0) {
+         const struct kk_safe_memrow *o = &out[at - 1];
+         bool before = r->size > o->size ||
+                       (r->size == o->size &&
+                        (r->count > o->count || (r->count == o->count && r->cat < o->cat)));
+         if (!before)
+            break;
+         at--;
+      }
+      if (at >= n)
+         continue;
+      unsigned end = got < n ? got : n - 1;
+      for (unsigned k = end; k > at; k--)
+         out[k] = out[k - 1];
+      out[at] = *r;
+      if (got < n)
+         got++;
+   }
+   return got;
+}
+
+/* ---- waiter release: (event, value) pairs the queue was asked to signal. Before the process
+ * stops after AccessRevoked every recorded event is raised from the CPU, so no thread stays
+ * blocked on a fence the GPU will never signal. Pure ring logic; handles are opaque here. */
+#define KK_SAFE_SIGNALS 128
+struct kk_safe_signal {
+   void *event;
+   uint64_t value;
+};
+struct kk_safe_signals {
+   struct kk_safe_signal s[KK_SAFE_SIGNALS];
+   unsigned head;
+};
+/* Records a signal; returns the handle it displaced (to release) or NULL. */
+static inline void *
+kk_safe_signals_push(struct kk_safe_signals *r, void *event, uint64_t value)
+{
+   /* Same event again: keep the highest value in its slot. */
+   for (unsigned i = 0; i < KK_SAFE_SIGNALS; i++) {
+      if (r->s[i].event == event) {
+         if (value > r->s[i].value)
+            r->s[i].value = value;
+         return event; /* the caller's new reference is not needed */
+      }
+   }
+   void *old = r->s[r->head].event;
+   r->s[r->head] = (struct kk_safe_signal){.event = event, .value = value};
+   r->head = (r->head + 1) % KK_SAFE_SIGNALS;
+   return old;
+}
+
 /* Wired / residency guard: bytes over the limit? limit 0 = off. */
 static inline bool
 kk_safe_over_limit(uint64_t allocated, uint64_t limit)

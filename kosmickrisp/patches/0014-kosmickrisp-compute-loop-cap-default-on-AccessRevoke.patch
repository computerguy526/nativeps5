+ * 16-byte state per kernel {u64 abort word address, u32 hit = UINT32_MAX, pad}. The states live
+ * in device-wide pool BOs owned by kk_safety (not in the command pool: a pool BO may be reused
+ * before the completion handler reads the hit words). */
+struct kk_safe_loop_rec {
+   uint64_t key;     /* kernel = first 8 bytes of BLAKE3 of its MSL */
+   uint32_t slot;
+   uint32_t sites;   /* guarded loops of the kernel */
+   uint32_t msl_len;
+   uint32_t barrier_sites;

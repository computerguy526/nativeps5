diff --git a/src/kosmickrisp/bridge/mtl_error_classify.h b/src/kosmickrisp/bridge/mtl_error_classify.h
new file mode 100644
index 0000000..8822a9a
--- /dev/null
+++ b/src/kosmickrisp/bridge/mtl_error_classify.h
@@ -0,0 +1,75 @@
+/*
+ * nps5 gpusafe: classification of a Metal 4 commit feedback error.
+ *
+ * Follows NXNative's gpu_err_has / gpu_lost_check (dm/gfx/nvn/nvn_mtl.m, MIT,
+ * Copyright (c) 2026 seedds): Metal 4 reports a commit's error as
+ * MTL4CommandQueueErrorTimeout with the command buffer's own error underneath
+ * (NSUnderlyingErrorKey, NSMultipleUnderlyingErrorsKey), so the error is
+ * searched to depth 3. Only MTL4CommandQueueErrorDomain counts: the IOGPU error
+ * of an innocent victim underneath has code 5 too and is not a revoked access.
+ *
+ * Objective-C only (included by mtl_command_queue.m and the unit test).
+ * SPDX-License-Identifier: MIT
+ */
+#ifndef MTL_ERROR_CLASSIFY_H
+#define MTL_ERROR_CLASSIFY_H 1
+
+#import <Foundation/Foundation.h>
+
+#define KK_MTL4_QUEUE_ERROR_DOMAIN       @"MTL4CommandQueueErrorDomain"
+#define KK_MTL4_QUEUE_ERROR_TIMEOUT      1
+#define KK_MTL4_QUEUE_ERROR_OUT_OF_MEMORY 3
+#define KK_MTL4_QUEUE_ERROR_ACCESS_REVOKED 5
+#define KK_MTL_ERROR_MAX_DEPTH           3
+
+static inline bool
+kk_mtl_error_has(NSError *e, NSInteger code, int depth)
+{
+   if (!e || depth > KK_MTL_ERROR_MAX_DEPTH)
+      return false;
+   if (e.code == code && [e.domain isEqualToString:KK_MTL4_QUEUE_ERROR_DOMAIN])
+      return true;
+   for (NSError *u in e.underlyingErrors)
+      if (kk_mtl_error_has(u, code, depth + 1))
+         return true;
+   return false;
+}
+
+static inline bool
+kk_mtl_error_access_revoked(NSError *e)
+{
+   return kk_mtl_error_has(e, KK_MTL4_QUEUE_ERROR_ACCESS_REVOKED, 0);
+}
+
+static inline bool
+kk_mtl_error_out_of_memory(NSError *e)
+{
+   return kk_mtl_error_has(e, KK_MTL4_QUEUE_ERROR_OUT_OF_MEMORY, 0);
+}
+
+/* The shape macOS reports for a revoked access (NXNative issue #1326 logs): a
+ * top-level timeout without text, the revoked error underneath (single and
+ * multiple key), an IOGPU error under that. For KK_TEST_GPU_LOST. */
+static inline NSError *
+kk_mtl_error_synthetic_revoked(void)
+{
+   NSError *iogpu = [NSError errorWithDomain:@"IOGPUCommandQueueErrorDomain"
+                                        code:4
+                                    userInfo:nil];
+   NSError *revoked = [NSError
+      errorWithDomain:KK_MTL4_QUEUE_ERROR_DOMAIN
+                 code:KK_MTL4_QUEUE_ERROR_ACCESS_REVOKED
+             userInfo:@{
+                NSLocalizedDescriptionKey :
+                   @"KK_TEST_GPU_LOST: Ignored (for causing prior/excessive GPU errors)",
+                NSUnderlyingErrorKey : iogpu
+             }];
+   return [NSError errorWithDomain:KK_MTL4_QUEUE_ERROR_DOMAIN
+                              code:KK_MTL4_QUEUE_ERROR_TIMEOUT
+                          userInfo:@{
+                             NSUnderlyingErrorKey : revoked,
+                             NSMultipleUnderlyingErrorsKey : @[ revoked ]
+                          }];
+}
+
+#endif

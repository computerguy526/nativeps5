+void
+kk_apply_attachment_store_ops(struct kk_cmd_buffer *cmd, bool force_store)
+{
+   if (!cmd->metal.render)
+      return;
+
+   kk_apply_store_ops_to(cs_get_render(cmd), &cmd->state.gfx.render,
+                         force_store);
+}
+
+static bool
+kk_attachment_has_resolve(const struct kk_attachment *att)
+{
+   return att->iview && att->resolve_mode != VK_RESOLVE_MODE_NONE;
+}
+
+/* Called from vkCmdEndRendering in place of the store ops + cs_end. Returns
+ * false when the rendering has to be closed now. */
+bool
+kk_cmd_defer_render_end(struct kk_cmd_buffer *cmd)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_rendering_state *render = &gfx->render;
+
+   kk_rp_tick();
+   if (!kk_rp_merge_enabled())
+      return false;
+
+   bool ok = cmd->metal.render != NULL && cmd->metal.compute == NULL &&
+             !gfx->need_to_start_render_pass && render->flags == 0 &&
+             render->samples <= 1 && render->fsr_att.iview == NULL &&
+             !render->sample_locations_enable &&
+             (render->color_att_count > 0 || render->depth_att.iview ||
+              render->stencil_att.iview) &&
+             !kk_attachment_has_resolve(&render->depth_att) &&
+             !kk_attachment_has_resolve(&render->stencil_att) &&
+             util_dynarray_num_elements(&cmd->post_render_writes,
+                                        struct libkk_imm_write) == 0 &&
+             util_dynarray_num_elements(&cmd->ts_stage_map,
+                                        struct kk_ts_stage_entry) == 0 &&
+             util_dynarray_num_elements(&cmd->ts_resolves,
+                                        struct kk_ts_resolve) == 0;
+   for (uint32_t i = 0; ok && i < render->color_att_count; i++) {
+      ok = render->color_map[i] == i &&
+           !kk_attachment_has_resolve(&render->color_att[i]);
+   }
+   if (!ok) {
+      kk_rp_stat_add(KK_RP_STAT_NOT_DEFERRED, 1);
+      if (cmd->metal.render == NULL || gfx->need_to_start_render_pass)
+         kk_rp_stat_add(KK_RP_STAT_ND_NO_ENCODER, 1);
+      else if (util_dynarray_num_elements(&cmd->post_render_writes,
+                                          struct libkk_imm_write) != 0)
+         kk_rp_stat_add(KK_RP_STAT_ND_POST_WRITES, 1);
+      else if (util_dynarray_num_elements(&cmd->ts_stage_map,
+                                          struct kk_ts_stage_entry) != 0 ||
+               util_dynarray_num_elements(&cmd->ts_resolves,
+                                          struct kk_ts_resolve) != 0)
+         kk_rp_stat_add(KK_RP_STAT_ND_TIMESTAMPS, 1);
+      return false;
+   }
+
+   kk_rp_stat_add(KK_RP_STAT_DEFERRED, 1);
+   gfx->deferred_render = *render;
+   cmd->metal.deferred = cmd->metal.render;
+   cmd->metal.render = NULL;
+   return true;
+}
+
+void
+kk_cmd_flush_deferred_render(struct kk_cmd_buffer *cmd,
+                             enum kk_rp_flush_reason reason)
+{
+   if (likely(!cmd->metal.deferred))
+      return;
+
+   mtl_render_encoder *encoder = cmd->metal.deferred;
+   cmd->metal.deferred = NULL;
+   kk_rp_stat_add(KK_RP_STAT_FLUSH0 + reason, 1);
+   kk_apply_store_ops_to(encoder, &cmd->state.gfx.deferred_render, false);
+   end_encoder(cmd, encoder, true);
+   util_dynarray_clear(&cmd->ts_stage_map);
+}
+
+static bool
+kk_attachment_same_target(const struct kk_attachment *a,
+                          const struct kk_attachment *b)
+{
+   return a->iview == b->iview && !kk_attachment_has_resolve(b);
+}
+
+/* Called from vkCmdBeginRendering once the new rendering state is known and
+ * before its encoder would start. Returns true when the deferred encoder has
+ * become the encoder of the new rendering; otherwise the deferred encoder is
+ * closed. The caller then treats every attachment as loaded and turns clears
+ * into clear draws. */
+bool
+kk_cmd_merge_deferred_render(struct kk_cmd_buffer *cmd)
+{
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   struct kk_rendering_state *render = &gfx->render;
+   const struct kk_rendering_state *old = &gfx->deferred_render;
+   const struct vk_dynamic_graphics_state *dyn =
+      &cmd->vk.dynamic_graphics_state;
+
+   if (!cmd->metal.deferred)
+      return false;
+
+   bool same = render->flags == 0 && render->fsr_att.iview == NULL &&
+               render->area.offset.x == old->area.offset.x &&
+               render->area.offset.y == old->area.offset.y &&
+               render->area.extent.width == old->area.extent.width &&
+               render->area.extent.height == old->area.extent.height &&
+               render->layer_count == old->layer_count &&
+               render->view_mask == old->view_mask &&
+               render->color_att_count == old->color_att_count &&
+               kk_attachment_same_target(&old->depth_att, &render->depth_att) &&
+               kk_attachment_same_target(&old->stencil_att,
+                                         &render->stencil_att);
+   for (uint32_t i = 0; same && i < render->color_att_count; i++) {
+      same = dyn->cal.color_map[i] == i &&
+             kk_attachment_same_target(&old->color_att[i],
+                                       &render->color_att[i]);
+   }
+   if (!same) {
+      kk_cmd_flush_deferred_render(cmd, KK_RP_FLUSH_MISMATCH);
+      return false;
+   }
+
+   kk_rp_stat_add(KK_RP_STAT_MERGED, 1);
+   kk_rp_stat_add(KK_RP_STAT_MERGE_SAVED_BYTES, 2 * kk_rp_total_bytes(old));
+   cmd->metal.render = cmd->metal.deferred;
+   cmd->metal.deferred = NULL;
+   render->samples = old->samples;
+   render->write_available = old->write_available;
+   render->ds_write_available = old->ds_write_available;
+   render->storage_write_available = old->storage_write_available;
+   render->encoder_started = true;
+   return true;
+}

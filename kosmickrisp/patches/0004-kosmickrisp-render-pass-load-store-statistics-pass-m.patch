 src/kosmickrisp/vulkan/kk_cmd_buffer.h |  50 +++
 src/kosmickrisp/vulkan/kk_cmd_draw.c   |  22 +-
 3 files changed, 520 insertions(+), 20 deletions(-)

diff --git a/src/kosmickrisp/vulkan/kk_cmd_buffer.c b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
index 7d4dacb..3b46450 100644
--- a/src/kosmickrisp/vulkan/kk_cmd_buffer.c
+++ b/src/kosmickrisp/vulkan/kk_cmd_buffer.c
@@ -21,6 +21,7 @@
 #include "kosmickrisp/bridge/mtl_encoder.h"
 #include "kosmickrisp/bridge/vk_to_mtl_map.h"
 
+#include "util/os_time.h"
 #include "vk_alloc.h"
 #include "vk_common_entrypoints.h"
 #include "vk_device.h"
@@ -259,6 +260,218 @@ kk_encoder_update_debug(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
       mtl_encoder_push_debug_group(encoder, label->pLabelName);
 }
 
+/* Render pass statistics and pass merging.
+ *
+ * KK_RP_STATS=<seconds>: one stderr line per period with the number of
+ * renderings / Metal render encoders and the attachment bytes each load and
+ * store action moves (a tile based GPU reads every LOAD attachment into tile
+ * memory and writes every STORE attachment back, per encoder).
+ *
+ * KK_RP_MERGE=1: a rendering that ends is kept open; when the next rendering
+ * of the command buffer targets exactly the same attachments it continues
+ * the same Metal encoder. KK_RP_LIVE_FILE=<path> (content "merge=0|1") flips
+ * it at run time for in-run A/B measurements. */
+static uint64_t kk_rp_stats[KK_RP_STAT_COUNT];
+static int kk_rp_stats_period = -1;
+static int kk_rp_merge_state = -1;
+/* KK_NARROW_ENCODER_BARRIER=1: the barrier at the end of a render encoder
+ * does not hold back the vertex/object/mesh stages of later encoders, so
+ * their binning can overlap this pass's fragment work. Only valid when no
+ * later geometry stage reads what this pass's fragment stage wrote. */
+static int kk_rp_narrow_state;
+/* KK_RP_NOLOAD_DIAG=1: DIAGNOSTIC ONLY (wrong pictures): every LOAD of the
+ * first encoder of a rendering becomes DONT_CARE, to measure what the loads
+ * cost. */
+static int kk_rp_noload_state;
+static const char *kk_rp_live_file;
+
+static void
+kk_rp_init(void)
+{
+   const char *e = getenv("KK_RP_STATS");
+   int period = e ? atoi(e) : 0;
+   e = getenv("KK_RP_MERGE");
+   int merge = e && atoi(e) > 0;
+   kk_rp_live_file = getenv("KK_RP_LIVE_FILE");
+   __atomic_store_n(&kk_rp_merge_state, merge, __ATOMIC_RELAXED);
+   e = getenv("KK_NARROW_ENCODER_BARRIER");
+   __atomic_store_n(&kk_rp_narrow_state, e && atoi(e) > 0, __ATOMIC_RELAXED);
+   e = getenv("KK_RP_NOLOAD_DIAG");
+   __atomic_store_n(&kk_rp_noload_state, e && atoi(e) > 0, __ATOMIC_RELAXED);
+   __atomic_store_n(&kk_rp_stats_period, period > 0 ? period : 0,
+                    __ATOMIC_RELEASE);
+}
+
+bool
+kk_rp_stats_enabled(void)
+{
+   int period = __atomic_load_n(&kk_rp_stats_period, __ATOMIC_ACQUIRE);
+   if (unlikely(period < 0)) {
+      kk_rp_init();
+      period = __atomic_load_n(&kk_rp_stats_period, __ATOMIC_ACQUIRE);
+   }
+   return period > 0;
+}
+
+bool
+kk_rp_merge_enabled(void)
+{
+   if (unlikely(__atomic_load_n(&kk_rp_stats_period, __ATOMIC_ACQUIRE) < 0))
+      kk_rp_init();
+   return __atomic_load_n(&kk_rp_merge_state, __ATOMIC_RELAXED) > 0;
+}
+
+bool
+kk_rp_noload_diag(void)
+{
+   return __atomic_load_n(&kk_rp_noload_state, __ATOMIC_RELAXED) > 0;
+}
+
+static void
+kk_rp_live_key(const char *buf, const char *key, int *state)
+{
+   const char *m = strstr(buf, key);
+   if (!m)
+      return;
+   int v = m[strlen(key)] == '1';
+   if (__atomic_exchange_n(state, v, __ATOMIC_RELAXED) != v)
+      fprintf(stderr, "[kk-rp] live: %s%d\n", key, v);
+}
+
+void
+kk_rp_stat_add(enum kk_rp_stat stat, uint64_t value)
+{
+   __atomic_fetch_add(&kk_rp_stats[stat], value, __ATOMIC_RELAXED);
+}
+
+/* Called once per rendering: periodic report and live switch. */
+static void
+kk_rp_tick(void)
+{
+   static uint64_t last_report, last_live;
+   static uint32_t calls;
+   bool stats = kk_rp_stats_enabled();
+   if (!stats && !kk_rp_live_file)
+      return;
+   if ((__atomic_fetch_add(&calls, 1, __ATOMIC_RELAXED) & 63u) != 0)
+      return;
+   uint64_t now = os_time_get_nano();
+   if (kk_rp_live_file &&
+       now - __atomic_load_n(&last_live, __ATOMIC_RELAXED) > 250000000ull) {
+      __atomic_store_n(&last_live, now, __ATOMIC_RELAXED);
+      FILE *f = fopen(kk_rp_live_file, "r");
+      if (f) {
+         char buf[64] = {0};
+         if (fgets(buf, sizeof(buf), f)) {
+            kk_rp_live_key(buf, "merge=", &kk_rp_merge_state);
+            kk_rp_live_key(buf, "narrow=", &kk_rp_narrow_state);
+            kk_rp_live_key(buf, "noload=", &kk_rp_noload_state);
+         }
+         fclose(f);
+      }
+   }
+   if (!stats)
+      return;
+   uint64_t last = __atomic_load_n(&last_report, __ATOMIC_RELAXED);
+   uint64_t period = (uint64_t)kk_rp_stats_period * 1000000000ull;
+   if (last == 0) {
+      __atomic_compare_exchange_n(&last_report, &last, now, false,
+                                  __ATOMIC_RELAXED, __ATOMIC_RELAXED);
+      return;
+   }
+   if (now - last < period ||
+       !__atomic_compare_exchange_n(&last_report, &last, now, false,
+                                    __ATOMIC_RELAXED, __ATOMIC_RELAXED))
+      return;
+   uint64_t v[KK_RP_STAT_COUNT];
+   for (unsigned i = 0; i < KK_RP_STAT_COUNT; i++)
+      v[i] = __atomic_exchange_n(&kk_rp_stats[i], 0, __ATOMIC_RELAXED);
+   double secs = (double)(now - last) * 1e-9;
+   double mb = 1.0 / (1024.0 * 1024.0 * secs);
+   fprintf(stderr,
+           "[kk-rp] %.1f s merge=%d narrow=%d noload=%d: renderings %.0f/s, encoders %.0f/s "
+           "(restarts %.0f/s, merged %.0f/s), MiB/s load %.0f clear %.0f "
+           "noload %.0f store %.0f nostore %.0f, merge saved %.0f; ended: "
+           "deferred %.0f/s direct %.0f/s (no encoder %.0f, post writes %.0f, "
+           "timestamps %.0f); deferred closed by: mismatch %.0f "
+           "compute %.0f barrier %.0f end %.0f label %.0f /s\n",
+           secs, kk_rp_merge_enabled(),
+           __atomic_load_n(&kk_rp_narrow_state, __ATOMIC_RELAXED),
+           __atomic_load_n(&kk_rp_noload_state, __ATOMIC_RELAXED),
+           v[KK_RP_STAT_PASSES] / secs,
+           v[KK_RP_STAT_ENCODERS] / secs, v[KK_RP_STAT_RESTARTS] / secs,
+           v[KK_RP_STAT_MERGED] / secs, v[KK_RP_STAT_LOAD_BYTES] * mb,
+           v[KK_RP_STAT_CLEAR_BYTES] * mb, v[KK_RP_STAT_NOLOAD_BYTES] * mb,
+           v[KK_RP_STAT_STORE_BYTES] * mb, v[KK_RP_STAT_NOSTORE_BYTES] * mb,
+           v[KK_RP_STAT_MERGE_SAVED_BYTES] * mb, v[KK_RP_STAT_DEFERRED] / secs,
+           v[KK_RP_STAT_NOT_DEFERRED] / secs,
+           v[KK_RP_STAT_ND_NO_ENCODER] / secs,
+           v[KK_RP_STAT_ND_POST_WRITES] / secs,
+           v[KK_RP_STAT_ND_TIMESTAMPS] / secs,
+           v[KK_RP_STAT_FLUSH0 + KK_RP_FLUSH_MISMATCH] / secs,
+           v[KK_RP_STAT_FLUSH0 + KK_RP_FLUSH_COMPUTE] / secs,
+           v[KK_RP_STAT_FLUSH0 + KK_RP_FLUSH_BARRIER] / secs,
+           v[KK_RP_STAT_FLUSH0 + KK_RP_FLUSH_END] / secs,
+           v[KK_RP_STAT_FLUSH0 + KK_RP_FLUSH_LABEL] / secs);
+}
+
+uint64_t
+kk_rp_attachment_bytes(const struct kk_rendering_state *render,
+                       const struct kk_attachment *att,
+                       VkImageAspectFlags aspect)
+{
+   if (!att->iview)
+      return 0;
+   uint32_t layers =
+      render->view_mask ? util_bitcount(render->view_mask) : render->layer_count;
+   uint64_t px = (uint64_t)(render->area.offset.x + render->area.extent.width) *
+                 (render->area.offset.y + render->area.extent.height) *
+                 MAX2(layers, 1u) * MAX2(render->samples, 1u);
+   uint32_t bpp;
+   if (aspect == VK_IMAGE_ASPECT_STENCIL_BIT)
+      bpp = 1;
+   else if (aspect == VK_IMAGE_ASPECT_DEPTH_BIT)
+      bpp = (att->vk_format == VK_FORMAT_D16_UNORM ||
+             att->vk_format == VK_FORMAT_D16_UNORM_S8_UINT)
+               ? 2
+               : 4;
+   else
+      bpp = vk_format_get_blocksize(att->vk_format);
+   return px * bpp;
+}
+
+uint64_t
+kk_rp_total_bytes(const struct kk_rendering_state *render)
+{
+   uint64_t bytes = 0;
+   for (uint32_t i = 0; i < render->color_att_count; i++)
+      bytes += kk_rp_attachment_bytes(render, &render->color_att[i],
+                                      VK_IMAGE_ASPECT_COLOR_BIT);
+   bytes += kk_rp_attachment_bytes(render, &render->depth_att,
+                                   VK_IMAGE_ASPECT_DEPTH_BIT);
+   bytes += kk_rp_attachment_bytes(render, &render->stencil_att,
+                                   VK_IMAGE_ASPECT_STENCIL_BIT);
+   return bytes;
+}
+
+static void
+kk_rp_stat_load(const struct kk_rendering_state *render,
+                const struct kk_attachment *att, VkImageAspectFlags aspect,
+                bool restart)
+{
+   if (!att->iview)
+      return;
+   bool load = restart || render->force_attachment_load ||
+               att->load_op == VK_ATTACHMENT_LOAD_OP_LOAD ||
+               att->load_op == VK_ATTACHMENT_LOAD_OP_NONE;
+   enum kk_rp_stat stat =
+      load ? KK_RP_STAT_LOAD_BYTES
+           : att->load_op == VK_ATTACHMENT_LOAD_OP_CLEAR
+                ? KK_RP_STAT_CLEAR_BYTES
+                : KK_RP_STAT_NOLOAD_BYTES;
+   kk_rp_stat_add(stat, kk_rp_attachment_bytes(render, att, aspect));
+}
+
 void
 cs_start_render(struct kk_cmd_buffer *cmd)
 {
@@ -272,6 +485,22 @@ cs_start_render(struct kk_cmd_buffer *cmd)
    cmd->metal.render = mtl_new_render_command_encoder_with_descriptor(
       cmd->metal.cmd_buf, state->render_pass_descriptor);
 
+   if (kk_rp_stats_enabled()) {
+      struct kk_rendering_state *render = &state->render;
+      bool restart = render->encoder_started;
+      kk_rp_stat_add(KK_RP_STAT_ENCODERS, 1);
+      if (restart)
+         kk_rp_stat_add(KK_RP_STAT_RESTARTS, 1);
+      for (uint32_t i = 0; i < render->color_att_count; i++)
+         kk_rp_stat_load(render, &render->color_att[i],
+                         VK_IMAGE_ASPECT_COLOR_BIT, restart);
+      kk_rp_stat_load(render, &render->depth_att, VK_IMAGE_ASPECT_DEPTH_BIT,
+                      restart);
+      kk_rp_stat_load(render, &render->stencil_att,
+                      VK_IMAGE_ASPECT_STENCIL_BIT, restart);
+   }
+   state->render.encoder_started = true;
+
    kk_encoder_update_debug(cmd, cmd->metal.render);
    /* Starting a new render pass means we already flushed and no barrier is
     * needed. */
@@ -316,6 +545,8 @@ cs_get_render(struct kk_cmd_buffer *cmd)
 mtl_compute_encoder *
 cs_get_compute(struct kk_cmd_buffer *cmd)
 {
+   kk_cmd_flush_deferred_render(cmd, KK_RP_FLUSH_COMPUTE);
+
    /* If we are inside render, we need to force a restart later */
    if (cmd->metal.render) {
       kk_apply_attachment_store_ops(cmd, true);
@@ -334,10 +565,14 @@ cs_get_compute(struct kk_cmd_buffer *cmd)
 }
 
 static void
-end_encoder(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder)
+end_encoder(struct kk_cmd_buffer *cmd, mtl_command_encoder *encoder,
+            bool render)
 {
    /* TODO_KOSMICKRISP This is probably overkill */
-   mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, MTL_STAGE_ALL);
+   enum mtl_stages before = MTL_STAGE_ALL;
+   if (render && __atomic_load_n(&kk_rp_narrow_state, __ATOMIC_RELAXED) > 0)
+      before &= ~(MTL_STAGE_VERTEX | MTL_STAGE_OBJECTS | MTL_STAGE_MESH);
+   mtl_barrier_after_stages(encoder, MTL_STAGE_ALL, before);
    mtl_end_encoding(encoder);
    mtl_release(encoder);
 
@@ -371,9 +606,11 @@ cs_end(struct kk_cmd_buffer *cmd)
 {
    assert(cmd);
 
+   kk_cmd_flush_deferred_render(cmd, KK_RP_FLUSH_END);
+
    /* Render first as it may open a compute encoder for post render writes. */
    if (cmd->metal.render) {
-      end_encoder(cmd, cmd->metal.render);
+      end_encoder(cmd, cmd->metal.render, true);
       cmd->metal.render = NULL;
 
       /* The stage map is only valid for the current render encoder */
@@ -382,7 +619,7 @@ cs_end(struct kk_cmd_buffer *cmd)
    }
 
    if (cmd->metal.compute) {
-      end_encoder(cmd, cmd->metal.compute);
+      end_encoder(cmd, cmd->metal.compute, false);
       cmd->metal.compute = NULL;
    }
 }
@@ -409,8 +646,28 @@ kk_cmd_bind_root_to_argument_table(struct kk_cmd_buffer *cmd, uint64_t addr)
  * no split is needed.
  */
 static bool
-kk_barrier_requires_encoder_split(struct kk_cmd_buffer *cmd,
-                                  const VkDependencyInfo *dep)
+kk_render_has_image(const struct kk_rendering_state *render,
+                    const struct vk_image *image)
+{
+   for (uint32_t i = 0; i < render->color_att_count; i++) {
+      if (render->color_att[i].iview &&
+          render->color_att[i].iview->vk.image == image)
+         return true;
+   }
+   return (render->depth_att.iview &&
+           render->depth_att.iview->vk.image == image) ||
+          (render->stencil_att.iview &&
+           render->stencil_att.iview->vk.image == image);
+}
+
+/* `deferred`: the rendering has been ended by the application and its encoder
+ * is only kept open for a possible merge. Image barriers on images that are
+ * not attachments of it and whose source access is attachment output only
+ * cannot be about anything this encoder wrote and are skipped. */
+static bool
+kk_barrier_requires_encoder_split(struct kk_rendering_state *render,
+                                  const VkDependencyInfo *dep, bool deferred,
+                                  bool *relevant)
 {
    const VkAccessFlags2 texture_read_access =
       VK_ACCESS_2_SHADER_READ_BIT | VK_ACCESS_2_SHADER_SAMPLED_READ_BIT |
@@ -426,7 +683,6 @@ kk_barrier_requires_encoder_split(struct kk_cmd_buffer *cmd,
    const VkAccessFlags2 storage_write_access =
       VK_ACCESS_2_SHADER_WRITE_BIT | VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT |
       VK_ACCESS_2_MEMORY_WRITE_BIT;
-   struct kk_rendering_state *render = &cmd->state.gfx.render;
    const bool has_ds =
       render->depth_att.iview != NULL || render->stencil_att.iview != NULL;
 
@@ -439,7 +695,16 @@ kk_barrier_requires_encoder_split(struct kk_cmd_buffer *cmd,
       src |= dep->pBufferMemoryBarriers[i].srcAccessMask;
       dst |= dep->pBufferMemoryBarriers[i].dstAccessMask;
    }
+   *relevant = dep->memoryBarrierCount > 0 || dep->bufferMemoryBarrierCount > 0;
    for (uint32_t i = 0; i < dep->imageMemoryBarrierCount; i++) {
+      if (deferred) {
+         VK_FROM_HANDLE(vk_image, image, dep->pImageMemoryBarriers[i].image);
+         if (!(dep->pImageMemoryBarriers[i].srcAccessMask &
+               storage_write_access) &&
+             !kk_render_has_image(render, image))
+            continue;
+      }
+      *relevant = true;
       src |= dep->pImageMemoryBarriers[i].srcAccessMask;
       dst |= dep->pImageMemoryBarriers[i].dstAccessMask;
    }
@@ -472,14 +737,27 @@ kk_CmdPipelineBarrier2(VkCommandBuffer commandBuffer,
        * the barrier and if we are using depth/stencil or not, we may have to
        * break the render pass. See comment in kk_barrier_requires_encoder_split
        */
+      bool relevant;
       if (cmd->state.gfx.render.samples > 1 ||
-          kk_barrier_requires_encoder_split(cmd, pDependencyInfo)) {
+          kk_barrier_requires_encoder_split(&cmd->state.gfx.render,
+                                            pDependencyInfo, false,
+                                            &relevant)) {
          kk_apply_attachment_store_ops(cmd, true);
          cs_end(cmd);
          cs_start_render(cmd);
       } else
          mtl_barrier_after_encoder_stages(cmd->metal.render, MTL_STAGE_VERTEX,
                                           MTL_STAGE_FRAGMENT);
+   } else if (cmd->metal.deferred) {
+      /* Same decision as for a barrier inside the rendering: if it would
+       * split the encoder, close it; the next rendering starts a new one. */
+      bool relevant;
+      if (kk_barrier_requires_encoder_split(&cmd->state.gfx.deferred_render,
+                                            pDependencyInfo, true, &relevant))
+         kk_cmd_flush_deferred_render(cmd, KK_RP_FLUSH_BARRIER);
+      else if (relevant)
+         mtl_barrier_after_encoder_stages(cmd->metal.deferred,
+                                          MTL_STAGE_VERTEX, MTL_STAGE_FRAGMENT);
    } else if (cmd->metal.compute) {
       /* We chain encoders, so an intra-encoder barrier is enough here:
        * no need to tear down and recreate the encoder.
@@ -934,19 +1212,27 @@ kk_get_attachment_store_op(const struct kk_attachment *attachment,
    return store_action;
 }
 

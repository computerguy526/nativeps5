+/* Releases what no call used for FX_IDLE calls (refused entries too, so a
+ * table full of loading-screen sizes cannot keep a new size out). */
+static void
+fx_sweep(mtl_fx_resident_fn unresident, void *ctx)
+{
+   for (unsigned i = 0; i < fx_count;) {
+      if (fx_calls - fx_entries[i].last_use <= FX_IDLE) {
+         i++;
+         continue;
+      }
+      if (fx_entries[i].scaler != nil) {
+         FX_LOG("releasing the scaler %lux%lu -> %lux%lu (idle)",
+                (unsigned long)fx_entries[i].key[5], (unsigned long)fx_entries[i].key[6],
+                (unsigned long)fx_entries[i].key[7], (unsigned long)fx_entries[i].key[8]);
+         [fx_entries[i].scaler release];
+      }
+      fx_entries[i] = fx_entries[--fx_count];
+   }
+   for (unsigned i = 0; i < fx_texture_count;) {
+      if (fx_calls - fx_texture_use[i] <= FX_IDLE) {
+         i++;
+         continue;
+      }
+      unresident(ctx, fx_textures[i]);
+      [fx_textures[i] release];
+      fx_textures[i] = fx_textures[--fx_texture_count];
+      fx_texture_use[i] = fx_texture_use[fx_texture_count];
+   }
+}

+static bool
+kk_flush_segment(const char *why, bool wait)
+{
+   return kk_flush_segment_n(why, wait, NULL);
+}
+
+/* nps5 prepfast S1: the host's replacement for "sleep one flush period, then _Exit". Writes what the serializer holds as a
+ * segment (compact mode: the one segment that replaces the loaded ones) and returns once it is on disk and renamed.
+ * wait_ms 0 = wait for the compile lock without limit, else give up after wait_ms (compiles in flight keep it).
+ * Returns the number of pipelines this call wrote (0 = nothing was pending), -1 = could not take the lock in time,
+ * -2 = no segment archive in this process (the caller keeps whatever it did before). */
+static void kk_archive_init(void);
+
+__attribute__((visibility("default"))) int64_t
+nps5_kk_archive_flush(uint32_t wait_ms)
+{
+   pthread_once(&kk_archive_once, kk_archive_init);
+   if (!kk_seg_mode || !kk_serializer)
+      return -2;
+   uint64_t written = 0;
+   if (wait_ms == 0)
+      kk_flush_segment_n("sync", true, &written);
+   else {
+      const double deadline = kk_now_ms() + (double)wait_ms;
+      while (!kk_flush_segment_n("sync", false, &written)) {
+         if (kk_now_ms() >= deadline)
+            return -1;
+         usleep(5000);
+      }
+   }
+   return (int64_t)written;
+}

+/* nps5 prepfast S3: stable (content-based) stamps. Default (gate off): the stamp texts are what they always were, i.e. they
+ * carry the KosmicKrisp build (version + git sha), so ANY KK commit, even a script-only one, opens an empty archive store and
+ * orphans every metallib. Gate on (the KK_ARCHIVE_STAMP_EPOCH / KK_LIBKEY_CONTENT environment, see mtl_compiler.m): the build is
+ * replaced by a hand-bumped epoch (archive) or dropped (library), and the OS build by its major number (library). What the
+ * stores really depend on is checked by Metal itself on every lookup (it keys an archive entry on the descriptor + the function
+ * bytes, and a metallib is keyed on the MSL text + options), so a stale entry can only MISS, never give a wrong pipeline. Kept
+ * here, without Metal headers, so a unit test can include it. */
+
+/* Leading digits of kern.osversion ("25F71" -> "25"; no digits: the whole text). */
+static inline void
+kk_os_major(const char *osbuild, char out[16])
+{
+   size_t n = 0;
+   while (osbuild[n] >= '0' && osbuild[n] <= '9' && n < 15)
+      n++;
+   if (n == 0) {
+      snprintf(out, 16, "%s", osbuild);
+      return;
+   }
+   memcpy(out, osbuild, n);
+   out[n] = 0;
+}
+
+/* Text hashed into the archive store's directory name (STAMP.txt holds it). epoch <= 0: the classic text. */
+static inline void
+kk_archive_stamp_text(char *text, size_t size, int epoch, const char *kk_version, const char *kk_sha,
+                      const char *osbuild, const char *gpu)
+{
+   if (epoch > 0)
+      snprintf(text, size, "fmt=2;epoch=%d;os=%s;gpu=%s;", epoch, osbuild, gpu);
+   else
+      snprintf(text, size, "fmt=1;kk=%s%s;os=%s;gpu=%s;", kk_version, kk_sha, osbuild, gpu);
+}
+
+/* Stamp that goes into kk_libkey_compute(). content = false: the classic text (KK build + macOS build). */
+static inline void
+kk_libkey_stamp_text(char *text, size_t size, bool content, const char *kk_version, const char *kk_sha,
+                     const char *osbuild)
+{
+   if (content) {
+      char major[16];
+      kk_os_major(osbuild, major);
+      snprintf(text, size, "lib=2;osmajor=%s;", major);
+   } else {
+      snprintf(text, size, "kk=%s%s;os=%s;", kk_version, kk_sha, osbuild);
+   }
+}
+
 #endif

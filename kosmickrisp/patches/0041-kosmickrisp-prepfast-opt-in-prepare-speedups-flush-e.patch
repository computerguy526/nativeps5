+/* Copyright nativeps5. SPDX-License-Identifier: MIT
+ *
+ * nps5 prepfast S5: pre-fault archive segments in parallel before Metal opens them. newArchiveWithURL hashes / maps a whole
+ * segment on the calling thread; on a cold page cache that is one page fault at a time (a 4.4 GB file took 8-11 s there, 1.5 s
+ * with its pages brought in by every core first). A piece is mapped, only the pages mincore() reports absent are touched, and
+ * the mapping is dropped again, so a warm file costs one mincore() per piece. No Metal headers: a unit test includes this. */
+#ifndef KK_PREFAULT_H
+#define KK_PREFAULT_H
+#include <dispatch/dispatch.h>
+#include <fcntl.h>
+#include <stdatomic.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+struct kk_prefault_stats {
+   _Atomic uint64_t pieces;         /* pieces visited */
+   _Atomic uint64_t pages_touched;  /* pages that were absent and have been read in */
+   _Atomic uint64_t pages_resident; /* pages already in the file cache */
+};
+
+/* One piece [off, off+len) of fd (len > 0, within the file). */
+static inline void
+kk_prefault_piece(int fd, off_t off, size_t len, struct kk_prefault_stats *st)
+{
+   const size_t page = (size_t)getpagesize();
+   void *m = mmap(NULL, len, PROT_READ, MAP_PRIVATE | MAP_FILE, fd, off);
+   if (m == MAP_FAILED)
+      return;
+   const size_t npages = (len + page - 1) / page;
+   char *vec = calloc(npages, 1);
+   if (vec && mincore(m, len, vec) == 0) {
+      size_t absent = 0;
+      for (size_t i = 0; i < npages; i++)
+         absent += !(vec[i] & 1);
+      if (absent) {
+         madvise(m, len, MADV_WILLNEED);
+         volatile char sink = 0;
+         for (size_t i = 0; i < npages; i++)
+            if (!(vec[i] & 1))
+               sink ^= ((volatile char *)m)[i * page];
+         (void)sink;
+      }
+      if (st) {
+         atomic_fetch_add(&st->pages_touched, absent);
+         atomic_fetch_add(&st->pages_resident, npages - absent);
+      }
+   }
+   free(vec);
+   munmap(m, len);
+   if (st)
+      atomic_fetch_add(&st->pieces, 1);
+}
+
+/* Every piece (default 8 MiB: a multiple of every page size) of every file in `paths`, spread over all cores. A path that
+ * cannot be opened or is empty / shorter than a piece is handled (short last piece; nothing for an empty file).
+ * Returns the number of pieces scheduled. */
+static inline uint64_t
+kk_prefault_files(const char *const *paths, size_t npaths, size_t piece_bytes, struct kk_prefault_stats *st)
+{
+   if (piece_bytes < 65536)
+      piece_bytes = (size_t)8 << 20;
+   struct task {
+      int fd;
+      off_t off;
+      size_t len;
+   };
+   size_t cap = 64, n = 0;
+   struct task *tasks = malloc(cap * sizeof(*tasks));
+   int *fds = calloc(npaths ? npaths : 1, sizeof(int));
+   if (!tasks || !fds) {
+      free(tasks);
+      free(fds);
+      return 0;
+   }
+   for (size_t i = 0; i < npaths; i++) {
+      fds[i] = open(paths[i], O_RDONLY);
+      struct stat sb;
+      if (fds[i] < 0 || fstat(fds[i], &sb) != 0 || sb.st_size <= 0)
+         continue;
+      for (off_t off = 0; off < sb.st_size; off += (off_t)piece_bytes) {
+         if (n == cap) {
+            cap *= 2;
+            struct task *t = realloc(tasks, cap * sizeof(*tasks));
+            if (!t)
+               goto run;
+            tasks = t;
+         }
+         size_t left = (size_t)(sb.st_size - off);
+         tasks[n++] = (struct task){fds[i], off, left < piece_bytes ? left : piece_bytes};
+      }
+   }
+run:;
+   struct task *tp = tasks;
+   dispatch_apply(n, dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^(size_t k) {
+      kk_prefault_piece(tp[k].fd, tp[k].off, tp[k].len, st);
+   });
+   for (size_t i = 0; i < npaths; i++)
+      if (fds[i] >= 0)
+         close(fds[i]);
+   free(tasks);
+   free(fds);
+   return n;
+}
+#endif

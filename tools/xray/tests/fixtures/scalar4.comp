#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer In { float d[]; } inb;
layout(std430, set = 0, binding = 1) writeonly buffer Out { float o[]; } outb;
void main() {
  uint i = gl_GlobalInvocationID.x;
  float a0 = inb.d[i * 4 + 0], a1 = inb.d[i * 4 + 1], a2 = inb.d[i * 4 + 2], a3 = inb.d[i * 4 + 3];
  outb.o[i] = a0 + a1 * 2.0 + a2 * 3.0 + a3 * 5.0;
}

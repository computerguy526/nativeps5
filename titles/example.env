# Copy to titles/<TITLE ID>.env (git ignores every file here except this one, README.md and kyty-preset.env).
# Read by `nps5 run` (scripts/nps5lib/run.py) and scripts/run-title.sh. KEY=VALUE lines, never executed;
# $NPS5_SCRATCH, $NPS5_DUMPS_DIR and other variables are expanded. See titles/README.md.
BIN_DIR="$NPS5_SCRATCH/build/PPSA00000"        # folder with native_<lineage> (the canonical lineage is patched into a cache copy)
#BIN="$NPS5_SCRATCH/build/PPSA00000/native"    # or one explicit translated binary (wins over BIN_DIR)
APP0="$NPS5_DUMPS_DIR/PPSA00000"               # your own dump; never written to
GPU=kyty                                       # or anyps5 (the AGC driver of the anyps5 component instead of the Kyty library)
ENV="NPS5_PERF=2"                              # title-specific environment words, layered above the profile

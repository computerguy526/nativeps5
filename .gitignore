nps5.conf
.nps5-check-local
titles/*
!titles/example.env
!titles/kyty-preset.env
/scratch/
/build/
/ps5recomp/
/anyps5/
/nps5-venv/
/runs/
/kyty/
__pycache__/
.DS_Store
# game profiles: only the files games/README.md lists are tracked; anything generated next to them stays local
/games/*/*
!/games/*/README.md
!/games/*/game.tsv
!/games/*/patches.py
!/games/*/bench.tsv
!/games/*/scenes.tsv
!/games/*/smoke.tsv
!/games/*/pad/
!/games/*/pad/*.vpad
!/games/*/validated.tsv
!/games/*/pipelines.kyplst
!/games/*/pipelines.kyplst.verified
!/games/*/metal-shaders.tsv
!/games/*/metal-gfx-pairs.tsv
!/games/*/metal-gfx-pairs.tsv.verified
!/games/*/metal-guests.tsv
!/games/*/metal-digests.tsv
!/games/*/keyguard-account.tsv
!/games/*/keyguard.record
!/games/*/promotions.tsv
!/games/*/override-guard.baseline
!/games/*/metal-shaders.tsv.verified
!titles/README.md
# local data of the offline shader tools (tools/xray, tools/agxdis): dumps and outputs, never committed
/work/
!/games/*/fast-math-deny.txt
